  </view>

  <view wx:elif="{{currentView === 'account'}}" class="page subpage"><view class="subpage-header"><button class="back-button" bindtap="onBackToMy"><image class="icon icon--back" src="/assets/icons/arrow-left-gray.svg" mode="aspectFit" /></button><text class="subpage-title">账号管理</text></view><view class="account-card light-capsule"><view class="round-symbol"><image src="/assets/icons/lock-key-gray.svg" mode="aspectFit" /></view><text class="card-title">{{accountState === 'ready' ? accountNickname : '账号暂时无法同步'}}</text><text class="account-ichi-id">{{accountState === 'ready' ? accountIchiId : '请检查网络后重试'}}</text><text class="card-copy">微信头像和昵称用于“我的”页面展示；更新展示资料不会改变 ICHI ID、识别额度或本人记录。</text><view class="account-quota"><text>今日版面识别</text><text>{{quotaRemaining}} / {{quotaLimit}} 次可用</text></view><view class="storage-meter {{storageCapacityState === 'near_limit' || storageCapacityState === 'full' ? 'storage-meter--warning' : ''}}"><view><view style="width: {{storagePercent}}%;"></view></view><text wx:if="{{storageCapacityState !== 'unknown'}}">本机空间已使用 {{storagePercent}}%</text><text wx:else>暂时无法读取本机空间状态</text></view></view><view class="subpage-actions"><button class="action-button inline-action" bindtap="onOpenLocalRecords">我的记录</button><button class="ghost-button" bindtap="onBackToMy">返回我的</button></view></view>

