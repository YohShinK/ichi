          <view class="draft-card contribution-card {{item.verificationAction ? 'contribution-card--action' : ''}} swipe-content light-capsule" style="transform: translateX({{item.swipeX}}px);" data-board-id="{{item.recordId}}" data-deleting="{{item.isDeleting}}" bindtouchstart="onTouchStart" bindtouchmove="onTouchMove" bindtouchend="onTouchEnd" bindtouchcancel="onTouchEnd"><image class="draft-watermark" src="/assets/v1-29/ichi-mascot-large-watermark.png" mode="aspectFit" aria-hidden="true" /><text class="record-state-badge status-pill {{item.recordStateLabel === '已上传' && !item.isDeleting ? 'status-pill--uploaded' : 'status-pill--dark'}}">{{item.isDeleting ? '删除中' : item.recordStateLabel}}</text><view class="draft-copy"><text class="draft-title">{{item.title}}</text><text class="record-identity-meta">{{item.identityMeta}}</text><text class="draft-meta">{{item.statsMeta}}</text></view><button wx:if="{{item.verificationAction === 'retry' && !item.isDeleting}}" class="record-verification-action" data-board-id="{{item.boardId}}" bindtap="onRetryTicketVerification">重新核验</button><button wx:if="{{item.verificationAction === 'reupload' && !item.isDeleting}}" class="record-verification-action" data-board-id="{{item.boardId}}" bindtap="onReuploadTicketEvidence">重新上传</button><button wx:if="{{item.verificationAction === 'edit-note' && !item.isDeleting}}" class="record-verification-action" data-board-id="{{item.boardId}}" bindtap="onEditTicketNote">修改备注</button></view>
        </view>
      </view><view wx:else class="records-empty light-capsule"><text class="records-empty-title">还没有已上传的版面</text><text class="records-empty-copy">通过“仅上传版面”或提交赏票核对的记录会显示在这里。</text></view></view>
    </scroll-view>
