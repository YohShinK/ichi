    <view class="record-summary"><text>云端 {{cloudClues.length}} 个</text></view>
    <scroll-view class="records-scroll" scroll-y enhanced="true" bounces="true" enable-flex="true" show-scrollbar="false" refresher-enabled="true" refresher-threshold="64" refresher-triggered="{{recordsRefreshing}}" bindrefresherrefresh="onRecordsRefresherRefresh">
      <view class="records-refresh-surface"><view wx:if="{{cloudClues.length}}" class="records-list">
