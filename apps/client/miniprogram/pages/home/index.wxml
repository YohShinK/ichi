<template name="draft-row">
  <view class="swipe-row">
    <button wx:if="{{item.canDelete}}" class="swipe-delete {{swipeX < 0 ? 'swipe-delete--visible' : ''}}" data-board-id="{{item.boardId}}" catchtap="onDeleteDraft" aria-label="删除{{item.title}}">
      <image class="icon icon--trash" src="/assets/icons/trash-white.svg" mode="aspectFit" aria-hidden="true" />
    </button>
    <view class="draft-card light-capsule swipe-content" style="transform: translateX({{swipeX}}px);" data-board-id="{{item.boardId}}" bindtouchstart="onTouchStart" bindtouchmove="onTouchMove" bindtouchend="onTouchEnd" bindtouchcancel="onTouchEnd" bindtap="onOpenDraft" hover-class="draft-card--pressed" role="button" aria-label="继续{{item.title}}">
      <image class="draft-watermark" src="/assets/v1-29/ichi-mascot-large-watermark.png" mode="aspectFit" aria-hidden="true" />
      <view class="draft-copy">
        <text class="draft-title">{{item.title}}</text>
        <text class="record-identity-meta">{{item.identityMeta}}</text>
        <text class="draft-meta">{{item.statsMeta}}</text>
        <view wx:if="{{showStatuses}}" class="draft-statuses">
          <text class="status-pill status-pill--dark">{{item.recordStateLabel}}</text>
        </view>
      </view>
      <view class="draft-resume"><text>继续</text><image class="icon icon--caret" src="/assets/icons/caret-right-gray.svg" mode="aspectFit" aria-hidden="true" /></view>
    </view>
  </view>
</template>

<template name="record-row">
  <view class="swipe-row">
    <button wx:if="{{item.canDelete}}" class="swipe-delete {{swipeX < 0 ? 'swipe-delete--visible' : ''}}" data-board-id="{{item.boardId}}" catchtap="onDeleteDraft" aria-label="删除{{item.title}}">
      <image class="icon icon--trash" src="/assets/icons/trash-white.svg" mode="aspectFit" aria-hidden="true" />
    </button>
    <view class="draft-card record-row-card light-capsule swipe-content" style="transform: translateX({{swipeX}}px);" data-board-id="{{item.boardId}}" bindtouchstart="onTouchStart" bindtouchmove="onTouchMove" bindtouchend="onTouchEnd" bindtouchcancel="onTouchEnd" bindtap="onOpenDraft">
      <image class="draft-watermark" src="/assets/v1-29/ichi-mascot-large-watermark.png" mode="aspectFit" aria-hidden="true" />
      <text class="record-state-badge status-pill {{item.recordStateLabel === '已上传' ? 'status-pill--uploaded' : 'status-pill--dark'}}">{{item.recordStateLabel}}</text>
      <view class="draft-copy"><text class="draft-title">{{item.title}}</text><text class="record-identity-meta">{{item.identityMeta}}</text><text class="draft-meta">{{item.statsMeta}}</text></view>
      <view wx:if="{{item.canResume}}" class="draft-resume"><text>继续</text><image class="icon icon--caret" src="/assets/icons/caret-right-gray.svg" mode="aspectFit" aria-hidden="true" /></view>
    </view>
  </view>
</template>

<template name="ticket-cover-content">
  <view class="ticket-cover-accent"></view>
  <view class="ticket-tier"><text class="ticket-tier-letter">{{prize.tier}}</text><text class="ticket-tier-suffix">賞</text></view>
  <image class="icon icon--ticket-caret" src="/assets/icons/caret-double-right-gray.svg" mode="aspectFit" aria-hidden="true" />
</template>

<template name="prize-ticket">
  <view class="prize-ticket {{prize.remaining === 0 ? 'prize-ticket--empty' : ''}}">
    <view class="ticket-shell">
      <view class="ticket-top"><text>引きかえ券</text><text class="ticket-probability">{{prize.probability}}%</text></view>
      <view class="ticket-opened"><text>OPENED</text></view>
      <view class="ticket-bottom {{prize.presentation !== 'large' ? 'ticket-bottom--normal' : ''}}">
        <text class="ticket-left">LEFT <text>{{prize.remaining}}</text></text>
        <view class="ticket-slots {{prize.presentation !== 'large' ? 'ticket-slots--normal' : ''}}">
          <view wx:for="{{prize.slots}}" wx:key="id" wx:for-item="slot" class="ticket-slot {{slot.drawn ? 'ticket-slot--drawn' : ''}}"><text wx:if="{{slot.drawn}}">×</text></view>
        </view>
      </view>
    </view>
    <view class="ticket-peel-track" data-tier="{{prize.tier}}" data-disabled="{{prize.remaining === 0}}" catchtouchstart="onTicketPeelStart" catchtouchmove="onTicketPeelMove" catchtouchend="onTicketPeelEnd" catchtouchcancel="onTicketPeelCancel" role="button" aria-label="撕开{{prize.tier}}赏" aria-disabled="{{prize.remaining === 0}}">
      <view class="ticket-peel-swiper {{ticketPeelSettling && ticketPeelTier === prize.tier ? 'ticket-peel-swiper--springing' : ''}} {{ticketPeelFading && ticketPeelTier === prize.tier ? 'ticket-peel-swiper--fading' : ''}}" style="right: -{{ticketPeelTier === prize.tier ? ticketPeelProgress : 0}}%;">
        <view class="ticket-peel-back" style="width: {{ticketPeelTier === prize.tier ? ticketPeelProgress : 0}}%;"></view>
        <view class="ticket-cover ticket-peel-front" style="left: -{{ticketPeelTier === prize.tier ? ticketPeelProgress : 0}}%;">
          <template is="ticket-cover-content" data="{{prize: prize}}" />
        </view>
      </view>
    </view>
  </view>
</template>

<view class="app-shell" style="--top-safe-px: {{topSafePx}}px;" bindtap="onDismissDraftSwipe">
  <view wx:if="{{currentView === 'camera-capture'}}" class="camera-page" data-testid="page-camera-capture">
    <view class="camera-stage">
      <image wx:if="{{boardCapturePath}}" class="camera-preview camera-frozen-photo" src="{{boardCapturePath}}" mode="aspectFill" aria-label="已拍摄版面" />
      <camera wx:elif="{{cameraStatus === 'loading' || cameraStatus === 'ready'}}" class="camera-preview" data-camera-generation="{{cameraGeneration}}" mode="normal" device-position="back" flash="off" resolution="high" bindinitdone="onCameraReady" binderror="onCameraError" aria-label="版面实时取景">
        <cover-image class="guide-corner guide-corner--tl" src="/assets/icons/camera-corner-tl.png" />
        <cover-image class="guide-corner guide-corner--tr" src="/assets/icons/camera-corner-tr.png" />
        <cover-image class="guide-corner guide-corner--bl" src="/assets/icons/camera-corner-bl.png" />
        <cover-image class="guide-corner guide-corner--br" src="/assets/icons/camera-corner-br.png" />
        <cover-view class="camera-guide-label">将版面放入框内</cover-view>
      </camera>
      <view wx:if="{{boardCapturePath}}" class="camera-frozen-guides" aria-hidden="true"><image class="guide-corner guide-corner--tl" src="/assets/icons/camera-corner-tl.png" /><image class="guide-corner guide-corner--tr" src="/assets/icons/camera-corner-tr.png" /><image class="guide-corner guide-corner--bl" src="/assets/icons/camera-corner-bl.png" /><image class="guide-corner guide-corner--br" src="/assets/icons/camera-corner-br.png" /></view>
      <view wx:if="{{!boardCapturePath && cameraStatus !== 'loading' && cameraStatus !== 'ready'}}" class="camera-permission-panel">
        <image class="camera-permission-icon" src="/assets/icons/camera-light.svg" mode="aspectFit" />
        <text class="camera-permission-title">{{cameraStatus === 'denied' ? '开启相机权限' : '相机暂时不可用'}}</text>
        <text class="camera-permission-copy">{{cameraError}}</text>
        <button wx:if="{{cameraStatus === 'denied'}}" class="camera-permission-action" hover-class="none" bindtap="onOpenCameraSettings">前往设置</button>
        <button wx:else class="camera-permission-action" hover-class="none" bindtap="onRetryCamera">重新尝试</button>
      </view>
    </view>
    <view class="camera-controls">
      <button class="camera-side" hover-class="none" bindtap="onBackToStart" aria-label="返回导入版面"><image src="/assets/icons/arrow-left-gray.svg" mode="aspectFit" /></button>
      <button class="camera-shutter {{mediaBusy || pendingBoardCapture ? 'camera-shutter--busy' : ''}}" hover-class="none" disabled="{{mediaBusy || cameraStatus === 'denied' || cameraStatus === 'unavailable'}}" bindtap="onCaptureBoardMedia" aria-label="{{boardCapturePath ? '确认识别这张版面' : '拍摄版面'}}"><view class="camera-shutter-core"><image wx:if="{{boardCapturePath}}" src="/assets/icons/check-white.svg" mode="aspectFit" /></view></button>
      <button class="camera-side camera-undo-slot" hover-class="none" disabled="{{!boardCapturePath || mediaBusy || recognitionGateBusy}}" bindtap="onUndoBoardCapture" aria-label="撤回并重拍"><image src="/assets/icons/arrow-counter-clockwise-gray.svg" mode="aspectFit" /></button>
    </view>
  </view>

  <view wx:elif="{{currentView === 'recognizing'}}" class="fullscreen-state" data-testid="page-recognizing">
    <view class="recognizing-card light-capsule" aria-live="polite">
      <view class="recognizing-mark"><canvas type="2d" id="recognition-progress-ring" class="recognizing-ring" aria-label="版面提取进度 {{recognitionProgress}}%"></canvas><image class="recognition-mascot" src="/assets/v1-29/ichi-recognition-mascot.png" mode="aspectFit" aria-label="正在识别版面" /></view>
      <text class="state-title">正在提取版面</text>
      <view class="recognition-steps">
        <view class="recognition-step {{recognitionStage > 0 ? 'recognition-step--done' : recognitionStage === 0 ? 'recognition-step--active' : ''}}"><image wx:if="{{recognitionStage > 0}}" src="/assets/icons/check-circle-black.svg" mode="aspectFit" /><view wx:elif="{{recognitionStage === 0}}" class="recognition-step-indicator recognition-step-indicator--active"><view></view></view><view wx:else class="recognition-step-indicator"></view><text>{{recognitionStage === 0 ? '正在整理照片' : '照片整理完成'}}</text></view>
        <view class="recognition-step {{recognitionStage > 1 ? 'recognition-step--done' : recognitionStage === 1 ? 'recognition-step--active' : ''}}"><image wx:if="{{recognitionStage > 1}}" src="/assets/icons/check-circle-black.svg" mode="aspectFit" /><view wx:elif="{{recognitionStage === 1}}" class="recognition-step-indicator recognition-step-indicator--active"><view></view></view><view wx:else class="recognition-step-indicator"></view><text>{{recognitionStage > 1 ? '版面已送去清点' : recognitionStage === 1 ? '版面送去清点中' : '版面送去清点'}}</text></view>
        <view class="recognition-step {{recognitionStage > 2 ? 'recognition-step--done' : recognitionStage === 2 ? 'recognition-step--active' : ''}}"><image wx:if="{{recognitionStage > 2}}" src="/assets/icons/check-circle-black.svg" mode="aspectFit" /><view wx:elif="{{recognitionStage === 2}}" class="recognition-step-indicator recognition-step-indicator--active"><view></view></view><view wx:else class="recognition-step-indicator"></view><text>{{recognitionStage > 2 ? '赏级与余票已核好' : recognitionStage === 2 ? '赏级与余票核算中' : '赏级与余票核算'}}</text></view>
        <view class="recognition-step {{recognitionStage > 3 ? 'recognition-step--done' : recognitionStage === 3 ? 'recognition-step--active' : ''}}"><image wx:if="{{recognitionStage > 3}}" src="/assets/icons/check-circle-black.svg" mode="aspectFit" /><view wx:elif="{{recognitionStage === 3}}" class="recognition-step-indicator recognition-step-indicator--active"><view></view></view><view wx:else class="recognition-step-indicator"></view><text>{{recognitionStage > 3 ? '版面结果已就绪' : recognitionStage === 3 ? '正在拼出版面结果' : '拼出版面结果'}}</text></view>
      </view>
    </view>
  </view>

  <view wx:elif="{{currentView === 'start'}}" class="page page--start" data-testid="page-start">
    <view class="import-hero light-capsule">
      <image class="camera-asset" src="/assets/v1-29/ichi-camera-cutout.png" mode="aspectFit" aria-label="相机图标" />
      <text class="hero-title">导入版面照片</text>
      <text class="hero-copy">拍摄一张完整、清楚的兑换进度板照片。</text>
      <view class="quota-summary {{accountState === 'unavailable' ? 'quota-summary--unavailable' : ''}}" aria-label="今日版面识别剩余 {{quotaRemaining}} 次，共 {{quotaLimit}} 次">
        <view class="quota-ring" style="--quota-used: {{quotaUsedPercent}}%;"><view><text>{{quotaRemaining}}</text><text>/{{quotaLimit}}</text></view></view>
      </view>
      <view class="import-actions">
        <view class="action-wrap"><view class="action-glow"></view><button class="action-button import-primary-button" disabled="{{recognitionGateBusy}}" bindtap="onImportBoard" data-flow-mode="assist" data-testid="import-board"><image class="icon icon--button" src="/assets/icons/scan-white.svg" mode="aspectFit" aria-hidden="true" /><text>进入辅助抽赏</text></button></view>
        <button class="ghost-button import-direct-button" disabled="{{recognitionGateBusy}}" bindtap="onImportBoard" data-flow-mode="direct-upload" data-testid="direct-upload-board"><image class="icon icon--button" src="/assets/icons/arrow-circle-up-black.svg" mode="aspectFit" aria-hidden="true" /><text>仅上传版面</text></button>
      </view>
      <text class="recognition-quota-note">每天有 5 次识别版面的权限</text>
    </view>
    <view class="start-drafts" data-testid="start-drafts">
      <view class="drafts-header"><text>抽赏草稿</text><text>{{startDrafts.length}} 份</text></view>
      <scroll-view wx:if="{{startDrafts.length > 0}}" class="draft-list" scroll-y enhanced="true" bounces="true" enable-flex="true" show-scrollbar="false"><view class="draft-list-inner"><block wx:for="{{startDrafts}}" wx:key="boardId"><template is="draft-row" data="{{item: item, swipeX: item.swipeX, showStatuses: false}}" /></block></view></scroll-view>
    </view>
  </view>

  <view wx:elif="{{currentView === 'recognition-result'}}" class="page flow-page" data-testid="page-recognition-result">
    <view class="flow-header"><button class="flow-back" disabled="{{generationState === 'generating'}}" bindtap="onBackToStart" aria-label="返回导入版面"><image src="/assets/icons/arrow-left-gray.svg" mode="aspectFit" aria-hidden="true" /></button><view><text class="flow-title">识别结果</text><text class="flow-copy">核对每一赏当前的未贴票数</text></view><button class="flow-help" disabled="{{generationState === 'generating'}}" bindtap="onRecognitionWrong">识别有误?</button></view>
    <scroll-view class="flow-scroll" scroll-y show-scrollbar="false" scroll-top="{{recognitionScrollTop}}" data-scroll-key="recognitionScrollTop" bindscrollend="onRememberScrollEnd">
      <view class="price-field recognition-text-field recognition-ip-field light-capsule"><text>IP</text><view><view class="recognition-input-shell {{recognitionValidation.ipNameBlocking ? 'is-required-missing' : ''}}"><view class="recognition-input-glow" aria-hidden="true"></view><input class="recognition-ip-main" data-testid="recognition-ip-input" type="text" maxlength="60" placeholder="主 IP" value="{{recognitionIp}}" disabled="{{generationState === 'generating'}}" bindinput="onRecognitionIpInput" aria-label="版面主 IP" aria-invalid="{{recognitionValidation.ipNameBlocking}}" /></view><text class="recognition-ip-divider">/</text><view class="recognition-input-shell"><input class="recognition-theme-input" data-testid="recognition-theme-input" type="text" maxlength="60" placeholder="主题（选填）" value="{{recognitionTheme}}" disabled="{{generationState === 'generating'}}" bindinput="onRecognitionThemeInput" aria-label="版面主题" aria-invalid="false" /></view></view></view>
      <view class="price-field light-capsule"><text>单抽价格</text><view><view class="recognition-input-shell recognition-input-shell--price {{recognitionValidation.unitPriceBlocking ? 'is-required-missing' : ''}}"><view class="recognition-input-glow" aria-hidden="true"></view><input type="number" value="{{recognitionPrice === null ? '' : recognitionPrice}}" disabled="{{generationState === 'generating'}}" bindinput="onRecognitionPriceInput" aria-label="单抽价格" aria-invalid="{{recognitionValidation.unitPriceBlocking}}" /></view><text>¥</text></view></view>
      <view wx:if="{{recognitionMode === 'direct-upload'}}" class="price-field recognition-text-field light-capsule"><text>地点与备注</text><view><view class="recognition-input-shell recognition-input-shell--text {{recognitionValidation.locationNoteBlocking ? 'is-required-missing' : ''}}"><view class="recognition-input-glow" aria-hidden="true"></view><input type="text" maxlength="120" placeholder="填写门店、地点或现场备注" value="{{recognitionLocationNote}}" disabled="{{generationState === 'generating'}}" bindinput="onRecognitionLocationInput" aria-label="地点与备注" aria-invalid="{{recognitionValidation.locationNoteBlocking}}" /></view></view></view>
      <view class="recognition-grid">
        <view wx:for="{{recognitionValidation.tiers}}" wx:key="id" class="recognition-prize light-capsule">
          <view class="recognition-prize-head"><text class="recognition-tier">{{item.rawLabel}}</text></view>
          <view class="field-labels"><text>未贴票数 remainingTickets</text></view>
          <view class="field-inputs"><view class="recognition-input-shell recognition-input-shell--count {{item.remainingTicketsBlocking ? 'is-required-missing' : ''}}"><view class="recognition-input-glow" aria-hidden="true"></view><input data-testid="recognition-remaining-{{item.tier}}" class="field-input--dark" type="number" placeholder="待确认，可填 0" value="{{item.remainingTickets === null ? '' : item.remainingTickets}}" disabled="{{generationState === 'generating'}}" data-tier="{{item.tier}}" data-field="remainingTickets" bindinput="onRecognitionFieldInput" aria-label="{{item.rawLabel}}未贴票数" aria-invalid="{{item.remainingTicketsBlocking}}" /></view></view>
        </view>
      </view>
      <text wx:if="{{recognitionError}}" class="flow-error">{{recognitionError}}</text>
      <view wx:if="{{generationState === 'generating'}}" class="generation-status light-capsule" aria-live="polite"><view class="generation-status-dot"></view><text>正在生成版面</text></view>
    </scroll-view>
    <view class="fixed-primary"><view class="action-wrap"><view wx:if="{{recognitionValidation.canConfirm && generationState !== 'generating'}}" class="action-glow"></view><button data-testid="recognition-submit" class="action-button recognition-submit" disabled="{{!recognitionValidation.canConfirm || generationState === 'generating'}}" bindtap="onConfirmRecognition">下一步：设定大赏</button></view></view>
  </view>

  <view wx:elif="{{currentView === 'grand-prize-selection'}}" class="page flow-page" data-testid="page-grand-prize-selection">
    <view class="flow-header"><button class="flow-back" bindtap="onBackToRecognitionFromGrand" aria-label="返回识别结果"><image src="/assets/icons/arrow-left-gray.svg" mode="aspectFit" aria-hidden="true" /></button><view><text class="flow-title">设定大赏</text><text class="flow-copy">请根据原始版面标注，自行勾选大赏</text></view></view>
    <scroll-view class="flow-scroll" scroll-y show-scrollbar="false">
      <view class="grand-prize-list">
        <button wx:for="{{grandPrizeOptions}}" wx:key="id" class="grand-prize-option light-capsule {{item.selected ? 'grand-prize-option--selected' : ''}}" data-tier="{{item.tier}}" bindtap="onToggleGrandPrize" aria-pressed="{{item.selected}}">
          <view class="grand-prize-check">{{item.selected ? '✓' : ''}}</view><text>{{item.rawLabel}}</text><text>未贴票数 {{item.remainingTickets}}</text>
        </button>
      </view>
    </scroll-view>
    <view class="fixed-primary"><view class="action-wrap"><view class="action-glow"></view><button data-testid="grand-prize-submit" class="action-button recognition-submit" disabled="{{generationState === 'generating'}}" bindtap="onConfirmGrandPrizes">{{generationState === 'generating' ? '正在生成版面' : recognitionMode === 'direct-upload' ? '确认并上传版面' : '确认并进入一番赏版面'}}</button></view></view>
  </view>

  <view wx:elif="{{currentView === 'draw'}}" class="page page--draw" data-testid="page-draw">
    <view class="draw-edge-fade draw-edge-fade--top" aria-hidden="true"></view>
    <view class="draw-edge-fade draw-edge-fade--bottom" aria-hidden="true"></view>
    <view wx:if="{{activeDraft}}" class="draw-status light-capsule">
      <view class="draw-status-remaining"><text class="draw-ip">IP:: {{activeDraft.ipLabel}}</text><text class="draw-status-kicker">剩余抽数</text><view class="draw-status-number {{activeDraft.remaining > 9 ? 'draw-status-number--compact' : ''}}"><text>{{activeDraft.remaining}}</text><text>抽</text></view></view><view class="draw-status-divider"></view><view class="draw-status-buyout"><text class="draw-unit-price">单价: {{activeDraft.ticketPrice}}¥</text><text class="draw-last-label">LAST包套</text><view class="draw-buyout-number"><text>{{activeDraft.buyout}}</text><text>¥</text></view></view>
    </view>
    <view wx:if="{{toast.visible}}" class="draw-toast" catchtap="onDismissToast" aria-live="polite"><view class="toast-mascot"><image wx:if="{{toast.presentation === 'large'}}" src="/assets/v1-29/ichi-mascot-large.png" mode="aspectFit" aria-hidden="true" /><image wx:elif="{{toast.presentation === 'small'}}" src="/assets/v1-29/ichi-mascot-small.png" mode="aspectFit" aria-hidden="true" /><view wx:else class="toast-face" aria-hidden="true"><view></view><view></view></view></view><view class="toast-copy"><text>成功抽出 <text>{{toast.tier}}赏</text></text><text>{{toast.message}} · 累计 ¥{{toast.cost}}</text></view><view class="toast-remaining"><text>剩</text><text>{{toast.remaining}}</text></view></view>
    <scroll-view wx:if="{{activeDraft}}" class="draw-scroll" scroll-y show-scrollbar="false" scroll-top="{{drawScrollTop}}" data-scroll-key="drawScrollTop" bindscrollend="onRememberScrollEnd"><view class="draw-content">
      <view wx:if="{{activeDraft.grandPrizes.length > 0}}" class="draw-section"><view class="draw-section-title draw-section-title--grand"><image class="icon icon--section" src="/assets/icons/crown-pink.svg" mode="aspectFit" /><text>GRAND PRIZES</text></view><view class="draw-prize-grid"><block wx:for="{{activeDraft.grandPrizes}}" wx:key="id" wx:for-item="prize"><template is="prize-ticket" data="{{prize: prize, ticketPeelTier: ticketPeelTier, ticketPeelProgress: ticketPeelProgress, ticketPeelSettling: ticketPeelSettling, ticketPeelFading: ticketPeelFading}}" /></block></view></view>
      <view wx:if="{{activeDraft.normalPrizes.length > 0}}" class="draw-section"><view class="draw-section-title"><image class="icon icon--section" src="/assets/icons/ticket-black.svg" mode="aspectFit" /><text>NORMAL PRIZES</text></view><view class="draw-prize-grid"><block wx:for="{{activeDraft.normalPrizes}}" wx:key="id" wx:for-item="prize"><template is="prize-ticket" data="{{prize: prize, ticketPeelTier: ticketPeelTier, ticketPeelProgress: ticketPeelProgress, ticketPeelSettling: ticketPeelSettling, ticketPeelFading: ticketPeelFading}}" /></block></view></view>
    </view></scroll-view>
    <view class="draw-quick-actions"><button bindtap="onOpenProbability" aria-label="局面可能性"><image class="icon icon--quick" src="/assets/icons/chart-pie-slice-white.svg" mode="aspectFit" /></button><button bindtap="onUndoDraw" aria-label="撤销最近一抽"><image class="icon icon--quick" src="/assets/icons/arrow-u-up-left-white.svg" mode="aspectFit" /></button><button bindtap="onOpenHistory" aria-label="抽取记录"><image class="icon icon--quick" src="/assets/icons/clock-counter-clockwise-white.svg" mode="aspectFit" /></button></view>
    <view class="draw-stop-wrap"><button class="draw-stop-button {{stopHolding ? 'draw-stop-button--holding' : ''}}" bindtouchstart="onStopTouchStart" bindtouchend="onStopTouchEnd" bindtouchcancel="onStopTouchEnd" aria-label="长按决定收手"><view class="hold-fill"></view><view class="hold-content"><image class="icon icon--stop" src="/assets/icons/hand-palm-black.svg" mode="aspectFit" /><text>决定收手</text></view></button></view>
  </view>

  <view wx:elif="{{currentView === 'map-preview'}}" class="page page--map" data-testid="page-map"><view class="map-hero light-capsule"><image class="map-watermark" src="/assets/v1-29/map-placeholder.svg" mode="aspectFill" /><view class="map-mark"><image class="icon icon--map-hero" src="/assets/icons/map-pin-fill-white.svg" mode="aspectFit" /></view><text class="hero-title">地图会在 V2 再来</text><text class="hero-copy map-copy">当前版本不展示门店线索或实时库存判断。我们希望先打磨好核心的核对和记录体验。</text><view class="map-actions"><view class="action-wrap"><view class="action-glow"></view><button class="action-button" bindtap="onImportBoard">去拍摄版面</button></view><button class="ghost-button" bindtap="onBackToStart">返回票池首页</button></view></view></view>

