<template name="map-detail-card">
  <view wx:if="{{mapCardPhase !== 'CLOSED' && mapSheetMode !== 'CLOSED' && mapDetailPhase !== 'IDLE'}}" class="map-detail-shell map-detail-shell--info {{mapDetail || mapDetailPhase === 'LOADING' ? 'map-detail-shell--card' : 'light-capsule'}} {{mapSheetMode === 'EXPANDED' ? 'map-detail-shell--note-expanded' : ''}} {{mapCardPhase === 'CLOSING' ? 'map-detail-shell--closing' : ''}}" style="--map-info-safe-top: {{topSafePx}}px;" catchtap="onMapCardTap" bindtouchstart="onMapOverlayTouchStart" catchtouchmove="onMapOverlayTouchMove" bindtouchend="onMapOverlayTouchEnd" bindtouchcancel="onMapOverlayTouchEnd" aria-live="polite">
    <view wx:if="{{mapDetail}}" class="map-info-decoration" aria-hidden="true">
      <view class="map-info-mascot-anchor"><view class="map-info-mascot"><view class="map-info-mascot-eyes"><view class="map-info-round-eye"></view><view class="map-info-round-eye"></view></view></view></view>
      <view wx:if="{{mapDetail.primaryDiscoveryTag}}" class="map-info-primary-tag"><text>{{mapDetail.primaryDiscoveryTag}}</text><view class="map-info-tag-tail"></view></view>
    </view>
    <view wx:if="{{mapDetailPhase === 'LOADING'}}" class="map-marker-info-card map-detail-loading" aria-label="正在加载详情">
      <view class="map-info-summary-main"><text class="map-info-title">{{mapDetailPreview ? mapDetailPreview.displayIpTheme : '版面详情'}}</text><text class="map-info-summary-label">剩余抽数 · 公开概要</text><view class="map-info-remaining"><text class="map-info-count">{{mapDetailPreview ? mapDetailPreview.totalRemainingLabel : '—'}}</text><text wx:if="{{mapDetailPreview && mapDetailPreview.totalRemainingLabel !== '—'}}" class="map-info-unit">抽</text></view></view>
      <view class="map-detail-skeleton-tiers" aria-hidden="true"><view class="map-detail-skeleton"></view><view class="map-detail-skeleton"></view><view class="map-detail-skeleton"></view><view class="map-detail-skeleton"></view><view class="map-detail-skeleton"></view><view class="map-detail-skeleton"></view></view>
      <view class="map-detail-skeleton map-detail-skeleton-line" aria-hidden="true"></view><view class="map-detail-loading-caption"><text>正在加载各赏余量与现场信息</text><view class="map-loading-dot map-status-loading-ring" aria-hidden="true"></view></view>
    </view>
    <view wx:elif="{{mapDetail}}" class="map-marker-info-card">
      <view class="map-info-body">
        <view class="map-info-summary map-info-summary--draw">
          <view class="map-info-summary-main">
            <text class="map-info-title">IP/主题：{{mapDetail.displayIpTheme}}</text>
            <text class="map-info-summary-label">剩余抽数</text>
            <view class="map-info-remaining"><text class="map-info-count {{mapDetail.totalRemainingCompact ? 'map-info-count--compact' : ''}} {{mapDetail.totalRemainingValueLabel === '待确认' ? 'map-info-count--unknown' : ''}}">{{mapDetail.totalRemainingValueLabel}}</text><text wx:if="{{mapDetail.totalRemainingValueLabel !== '待确认'}}" class="map-info-unit">抽</text></view>
          </view>
          <view class="map-info-summary-divider" aria-hidden="true"></view>
          <view class="map-info-summary-price">
            <text wx:if="{{mapDetail.hasPrice}}" class="map-info-price">单价: {{mapDetail.priceLabel}}</text>
            <block wx:if="{{mapDetail.fullPackCostValueLabel}}">
              <text class="map-info-last-label">LAST包套</text>
              <view class="map-info-last-value"><text class="map-info-last-cost">{{mapDetail.fullPackAmountLabel}}</text><text class="map-info-unit">¥</text></view>
            </block>
          </view>
        </view>
        <view class="map-info-tiers">
          <scroll-view class="map-info-tier-scroll" scroll-x enhanced="true" bounces="{{true}}" show-scrollbar="{{false}}" aria-label="各赏剩余，左右滑动查看更多">
            <view class="map-info-tier-grid" style="grid-template-columns: repeat({{mapDetail.tierColumnCount}}, 86px);">
              <view wx:for="{{mapDetail.tiers}}" wx:key="tierCode" wx:for-item="tier" class="map-info-tier {{tier.isSoldOut ? 'map-info-tier--sold-out' : ''}} {{tier.isUnknown ? 'map-info-tier--unknown' : ''}}" aria-label="{{tier.label}}，剩余{{tier.remainingLabel}}">
                <view class="map-info-tier-head">
                  <view class="map-info-tier-identity"><text class="map-info-tier-code">{{tier.tierCode}}</text><text class="map-info-tier-suffix">赏</text></view><text class="map-info-tier-probability">{{tier.probabilityLabel}}</text>
                  <view wx:if="{{tier.isSoldOut}}" class="map-info-sold-overlay"><text class="map-info-sold-sticker">完售</text></view>
                </view>
                <view class="map-info-tier-left"><text class="map-info-tier-left-label">LEFT</text><text class="map-info-tier-count">{{tier.remainingLabel}}</text></view>
              </view>
            </view>
          </scroll-view>
        </view>
        <view class="map-info-player {{mapSheetMode === 'EXPANDED' ? 'map-info-player--expanded' : ''}}" catchtap="onMapToggleDetailInfo" role="button" aria-label="{{mapSheetMode === 'EXPANDED' ? '收起现场详情' : '展开现场详情'}}" aria-expanded="{{mapSheetMode === 'EXPANDED'}}">
          <view class="map-info-player-head">
            <view class="map-info-player-identity">
              <view wx:if="{{mapDetail.sourceIcon === 'OFFICIAL_NETWORK'}}" class="map-info-avatar-stack"><view class="map-info-avatar"><view class="map-info-avatar-glow"></view><image class="map-info-avatar-inner" src="/assets/icons/official-network.svg" mode="aspectFit" aria-label="官方网络来源" /></view></view>
              <view wx:else class="map-info-avatar-stack"><view wx:for="{{mapDetail.contributorAvatars}}" wx:key="index" class="map-info-avatar map-info-avatar--stack"><view class="map-info-avatar-glow"></view><image class="map-info-avatar-inner" src="{{mapContributorAvatarFailed ? '/assets/v1-29/ichi-avatar.png' : item.avatarUrl}}" binderror="onMapContributorAvatarError" mode="aspectFill" aria-label="{{item.displayName}}头像" /></view><text wx:if="{{mapDetail.contributorOverflowLabel}}" class="map-info-avatar-overflow">{{mapDetail.contributorOverflowLabel}}</text></view>
              <view class="map-info-player-copy">
                <text class="map-info-player-meta">{{mapDetail.contributorName}} · {{mapDetail.recordTimeLabel}}</text>
                <text class="map-info-note-preview">{{mapDetail.sourceIcon === 'OFFICIAL_NETWORK' ? mapDetail.locationLabel : mapDetail.venueNotePreview}}</text>
              </view>
            </view>
            <view class="map-info-player-action"><button class="map-control-button map-info-detail-button" catchtap="onMapToggleDetailInfo" hover-class="map-info-detail-button--pressed" disabled="{{mapSheetMode === 'EXPANDED'}}" aria-label="展开现场详情">
              <image class="map-info-document-icon" src="/assets/icons/file-text-gray.svg" mode="aspectFit" aria-hidden="true" /><text>详情信息</text>
            </button></view>
          </view>
          <view class="map-info-expanded-content" aria-hidden="{{mapSheetMode !== 'EXPANDED'}}">
            <scroll-view class="map-info-note-scroll" scroll-y enhanced="true" bounces="{{false}}" show-scrollbar="{{false}}">
              <block wx:if="{{mapDetail.sourceIcon === 'OFFICIAL_NETWORK'}}"><text wx:for="{{mapDetail.networkExpandedNoteLines}}" wx:key="*this" class="map-info-expanded-note">{{item}}</text></block>
              <block wx:else>
                <text wx:if="{{mapDetail.hasVenueNote && mapDetail.venueNoteBody}}" class="map-info-expanded-note">{{mapDetail.venueNoteBody}}</text>
                <text wx:for="{{mapDetail.opportunityReasons}}" wx:key="*this" class="map-info-expanded-note">{{item}}</text>
              </block>
              <text class="map-detail-disclosure">历史现场记录，不代表当前库存，不构成消费建议。</text>
            </scroll-view>
            <view class="map-info-player-footer">
              <text class="map-info-footer-time">{{mapDetail.recordTimeClockLabel}}</text>
              <view class="map-info-footer-actions">
                <button class="map-report-button {{mapReportActive ? 'map-report-button--active' : ''}}" catchtap="onToggleMapReport" disabled="{{mapReportBusy}}" aria-label="{{mapReportActive ? '取消举报' : '举报'}}"><view class="map-info-report-icon" aria-hidden="true">!</view><text>{{mapReportActive ? '已举报' : '举报'}}</text></button>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view wx:else><text class="map-detail-title">{{mapDetailErrorMessage || '线索暂时不可用'}}</text><button wx:if="{{mapDetailPhase === 'ERROR'}}" class="map-control-button ghost-button" bindtap="onMapRetryDetail">重试详情</button></view>
  </view>
</template>

<template name="draft-row">
  <view class="swipe-row">
    <button wx:if="{{item.canDelete && swipeX !== 0}}" class="swipe-delete swipe-delete--visible" data-board-id="{{item.boardId}}" catchtap="onDeleteDraft" aria-label="删除{{item.title}}">
      <image class="icon icon--trash" src="/assets/icons/trash-white.svg" mode="aspectFit" aria-hidden="true" />
    </button>
    <view class="draft-card light-capsule swipe-content" style="transform: translateX({{swipeX}}px);" data-board-id="{{item.boardId}}" bindtouchstart="onTouchStart" bindtouchmove="onTouchMove" bindtouchend="onTouchEnd" bindtouchcancel="onTouchEnd" bindtap="onOpenDraft" hover-class="draft-card--pressed" role="button" aria-label="继续{{item.title}}">
      <image class="draft-watermark" src="/assets/v1-29/ichi-mascot-large-watermark.png" mode="aspectFit" aria-hidden="true" />
      <view class="draft-copy">
        <text class="draft-title">{{item.title}}</text>
        <text class="record-identity-meta">{{item.identityMeta}}</text>
        <text class="draft-meta">{{item.statsMeta}}</text>
        <view wx:if="{{showStatuses}}" class="draft-statuses">
          <text class="status-pill status-pill--dark">{{item.recordStateLabel}}</text>
        </view>
      </view>
      <view class="draft-resume"><text>继续</text><image class="icon icon--caret" src="/assets/icons/caret-right-gray.svg" mode="aspectFit" aria-hidden="true" /></view>
    </view>
  </view>
</template>

<template name="record-row">
  <view class="swipe-row">
    <button wx:if="{{item.canDelete && swipeX !== 0}}" class="swipe-delete swipe-delete--visible" data-board-id="{{item.boardId}}" catchtap="onDeleteDraft" aria-label="删除{{item.title}}">
      <image class="icon icon--trash" src="/assets/icons/trash-white.svg" mode="aspectFit" aria-hidden="true" />
    </button>
    <view class="draft-card record-row-card light-capsule swipe-content" style="transform: translateX({{swipeX}}px);" data-board-id="{{item.boardId}}" bindtouchstart="onTouchStart" bindtouchmove="onTouchMove" bindtouchend="onTouchEnd" bindtouchcancel="onTouchEnd" bindtap="onOpenDraft">
      <image class="draft-watermark" src="/assets/v1-29/ichi-mascot-large-watermark.png" mode="aspectFit" aria-hidden="true" />
      <text class="record-state-badge status-pill {{item.recordStateLabel === '已上传' ? 'status-pill--uploaded' : 'status-pill--dark'}}">{{item.recordStateLabel}}</text>
      <view class="draft-copy"><text class="draft-title">{{item.title}}</text><text class="record-identity-meta">{{item.identityMeta}}</text><text class="draft-meta">{{item.statsMeta}}</text></view>
      <view wx:if="{{item.canResume}}" class="draft-resume"><text>继续</text><image class="icon icon--caret" src="/assets/icons/caret-right-gray.svg" mode="aspectFit" aria-hidden="true" /></view>
    </view>
  </view>
</template>

<template name="ticket-cover-content">
  <view class="ticket-cover-accent"></view>
  <view class="ticket-tier"><text class="ticket-tier-letter">{{prize.tier}}</text><text class="ticket-tier-suffix">賞</text></view>
  <image class="icon icon--ticket-caret" src="/assets/icons/caret-double-right-gray.svg" mode="aspectFit" aria-hidden="true" />
</template>

<template name="prize-ticket">
  <view class="prize-ticket {{prize.remaining === 0 ? 'prize-ticket--empty' : ''}}">
    <view class="ticket-shell">
      <view class="ticket-top"><text>引きかえ券</text><text class="ticket-probability">{{prize.probability}}%</text></view>
      <view class="ticket-opened"><text>OPENED</text></view>
      <view class="ticket-bottom {{prize.presentation !== 'large' ? 'ticket-bottom--normal' : ''}}">
        <text class="ticket-left">LEFT <text>{{prize.remaining}}</text></text>
        <view class="ticket-slots {{prize.presentation !== 'large' ? 'ticket-slots--normal' : ''}}">
          <view wx:for="{{prize.slots}}" wx:key="id" wx:for-item="slot" class="ticket-slot {{slot.drawn ? 'ticket-slot--drawn' : ''}}"><text wx:if="{{slot.drawn}}">×</text></view>
        </view>
      </view>
    </view>
    <view class="ticket-peel-track" data-tier="{{prize.tier}}" data-disabled="{{prize.remaining === 0}}" catchtouchstart="onTicketPeelStart" catchtouchmove="onTicketPeelMove" catchtouchend="onTicketPeelEnd" catchtouchcancel="onTicketPeelCancel" role="button" aria-label="撕开{{prize.tier}}赏" aria-disabled="{{prize.remaining === 0}}">
      <view class="ticket-peel-swiper {{ticketPeelTier === prize.tier ? 'ticket-peel-swiper--active' : ''}} {{ticketPeelSettling && ticketPeelTier === prize.tier ? 'ticket-peel-swiper--springing' : ''}} {{ticketPeelFading && ticketPeelTier === prize.tier ? 'ticket-peel-swiper--fading' : ''}}" style="{{ticketPeelStyle}}">
        <view class="ticket-peel-back"></view>
        <view class="ticket-cover ticket-peel-front">
          <template is="ticket-cover-content" data="{{prize: prize}}" />
        </view>
      </view>
    </view>
  </view>
</template>

<view class="app-shell" style="--top-safe-px: {{topSafePx}}px;" bindtap="onDismissDraftSwipe">
  <view wx:if="{{currentView === 'camera-capture'}}" class="camera-page" data-testid="page-camera-capture">
    <view class="camera-stage">
      <image wx:if="{{boardCapturePath}}" class="camera-preview camera-frozen-photo" src="{{boardCapturePath}}" mode="aspectFill" aria-label="已拍摄版面" />
      <camera wx:elif="{{cameraStatus === 'loading' || cameraStatus === 'ready'}}" class="camera-preview" data-camera-generation="{{cameraGeneration}}" mode="normal" device-position="back" flash="off" resolution="high" bindinitdone="onCameraReady" binderror="onCameraError" aria-label="版面实时取景">
        <cover-image class="guide-corner guide-corner--tl" src="/assets/icons/camera-corner-tl.png" />
        <cover-image class="guide-corner guide-corner--tr" src="/assets/icons/camera-corner-tr.png" />
        <cover-image class="guide-corner guide-corner--bl" src="/assets/icons/camera-corner-bl.png" />
        <cover-image class="guide-corner guide-corner--br" src="/assets/icons/camera-corner-br.png" />
        <cover-view class="camera-guide-label">将版面放入框内</cover-view>
      </camera>
      <view wx:if="{{boardCapturePath}}" class="camera-frozen-guides" aria-hidden="true"><image class="guide-corner guide-corner--tl" src="/assets/icons/camera-corner-tl.png" /><image class="guide-corner guide-corner--tr" src="/assets/icons/camera-corner-tr.png" /><image class="guide-corner guide-corner--bl" src="/assets/icons/camera-corner-bl.png" /><image class="guide-corner guide-corner--br" src="/assets/icons/camera-corner-br.png" /></view>
      <view wx:if="{{!boardCapturePath && cameraStatus !== 'loading' && cameraStatus !== 'ready'}}" class="camera-permission-panel">
        <image class="camera-permission-icon" src="/assets/icons/camera-light.svg" mode="aspectFit" />
        <text class="camera-permission-title">{{cameraStatus === 'denied' ? '开启相机权限' : '相机暂时不可用'}}</text>
        <text class="camera-permission-copy">{{cameraError}}</text>
        <button wx:if="{{cameraStatus === 'denied'}}" class="camera-permission-action" hover-class="none" bindtap="onOpenCameraSettings">前往设置</button>
        <button wx:else class="camera-permission-action" hover-class="none" bindtap="onRetryCamera">重新尝试</button>
      </view>
    </view>
    <view class="camera-controls">
      <button class="camera-side" hover-class="none" bindtap="onBackToStart" aria-label="返回导入版面"><image src="/assets/icons/arrow-left-gray.svg" mode="aspectFit" /></button>
      <button class="camera-shutter {{mediaBusy || pendingBoardCapture ? 'camera-shutter--busy' : ''}}" hover-class="none" disabled="{{mediaBusy || cameraStatus === 'denied' || cameraStatus === 'unavailable'}}" bindtap="onCaptureBoardMedia" aria-label="{{boardCapturePath ? '确认识别这张版面' : '拍摄版面'}}"><view class="camera-shutter-core"><image wx:if="{{boardCapturePath}}" src="/assets/icons/check-white.svg" mode="aspectFit" /></view></button>
      <button class="camera-side camera-undo-slot" hover-class="none" disabled="{{!boardCapturePath || mediaBusy || recognitionGateBusy}}" bindtap="onUndoBoardCapture" aria-label="撤回并重拍"><image src="/assets/icons/arrow-counter-clockwise-gray.svg" mode="aspectFit" /></button>
    </view>
  </view>

  <view wx:elif="{{currentView === 'recognizing'}}" class="fullscreen-state" data-testid="page-recognizing">
    <view class="recognizing-card light-capsule" aria-live="polite">
      <view class="recognizing-mark"><canvas type="2d" id="recognition-progress-ring" class="recognizing-ring" aria-label="版面提取进度 {{recognitionProgress}}%"></canvas><image class="recognition-mascot" src="/assets/v1-29/ichi-recognition-mascot.png" mode="aspectFit" aria-label="正在识别版面" /></view>
      <text class="state-title">正在提取版面</text>
      <view class="recognition-steps">
        <view class="recognition-step {{recognitionStage > 0 ? 'recognition-step--done' : recognitionStage === 0 ? 'recognition-step--active' : ''}}"><image wx:if="{{recognitionStage > 0}}" src="/assets/icons/check-circle-black.svg" mode="aspectFit" /><view wx:elif="{{recognitionStage === 0}}" class="recognition-step-indicator recognition-step-indicator--active"><view></view></view><view wx:else class="recognition-step-indicator"></view><text>{{recognitionStage === 0 ? '正在整理照片' : '照片整理完成'}}</text></view>
        <view class="recognition-step {{recognitionStage > 1 ? 'recognition-step--done' : recognitionStage === 1 ? 'recognition-step--active' : ''}}"><image wx:if="{{recognitionStage > 1}}" src="/assets/icons/check-circle-black.svg" mode="aspectFit" /><view wx:elif="{{recognitionStage === 1}}" class="recognition-step-indicator recognition-step-indicator--active"><view></view></view><view wx:else class="recognition-step-indicator"></view><text>{{recognitionStage > 1 ? '版面已送去清点' : recognitionStage === 1 ? '版面送去清点中' : '版面送去清点'}}</text></view>
        <view class="recognition-step {{recognitionStage > 2 ? 'recognition-step--done' : recognitionStage === 2 ? 'recognition-step--active' : ''}}"><image wx:if="{{recognitionStage > 2}}" src="/assets/icons/check-circle-black.svg" mode="aspectFit" /><view wx:elif="{{recognitionStage === 2}}" class="recognition-step-indicator recognition-step-indicator--active"><view></view></view><view wx:else class="recognition-step-indicator"></view><text>{{recognitionStage > 2 ? '赏级与余票已核好' : recognitionStage === 2 ? '赏级与余票核算中' : '赏级与余票核算'}}</text></view>
        <view class="recognition-step {{recognitionStage > 3 ? 'recognition-step--done' : recognitionStage === 3 ? 'recognition-step--active' : ''}}"><image wx:if="{{recognitionStage > 3}}" src="/assets/icons/check-circle-black.svg" mode="aspectFit" /><view wx:elif="{{recognitionStage === 3}}" class="recognition-step-indicator recognition-step-indicator--active"><view></view></view><view wx:else class="recognition-step-indicator"></view><text>{{recognitionStage > 3 ? '版面结果已就绪' : recognitionStage === 3 ? '正在拼出版面结果' : '拼出版面结果'}}</text></view>
      </view>
    </view>
  </view>

  <view wx:elif="{{currentView === 'start'}}" class="page page--start" data-testid="page-start">
    <view class="import-hero light-capsule">
      <image class="camera-asset" src="/assets/v1-29/ichi-camera-cutout.png" mode="aspectFit" aria-label="相机图标" />
      <text class="hero-title">导入版面照片</text>
      <text class="hero-copy">拍摄一张完整、清楚的兑换进度板照片。</text>
      <view class="quota-summary {{accountState === 'unavailable' ? 'quota-summary--unavailable' : ''}}" aria-label="今日版面识别剩余 {{quotaRemaining}} 次，共 {{quotaLimit}} 次">
        <view class="quota-ring" style="--quota-used: {{quotaUsedPercent}}%;"><view><text>{{quotaRemaining}}</text><text>/{{quotaLimit}}</text></view></view>
      </view>
      <view class="import-actions">
        <view class="action-wrap"><view class="action-glow"></view><button class="action-button import-primary-button" disabled="{{recognitionGateBusy}}" bindtap="onImportBoard" data-flow-mode="assist" data-testid="import-board"><image class="icon icon--button" src="/assets/icons/scan-white.svg" mode="aspectFit" aria-hidden="true" /><text>进入辅助抽赏</text></button></view>
        <button class="ghost-button import-direct-button" disabled="{{recognitionGateBusy}}" bindtap="onImportBoard" data-flow-mode="direct-upload" data-testid="direct-upload-board"><image class="icon icon--button" src="/assets/icons/arrow-circle-up-black.svg" mode="aspectFit" aria-hidden="true" /><text>仅上传版面</text></button>
      </view>
      <text class="recognition-quota-note">每天有 5 次识别版面的权限</text>
    </view>
    <view class="start-drafts" data-testid="start-drafts">
      <view class="drafts-header"><text>抽赏草稿</text><text>{{startDrafts.length}} 份</text></view>
      <scroll-view wx:if="{{startDrafts.length > 0}}" class="draft-list" scroll-y enhanced="true" bounces="true" enable-flex="true" show-scrollbar="false"><view class="draft-list-inner"><block wx:for="{{startDrafts}}" wx:key="boardId"><template is="draft-row" data="{{item: item, swipeX: item.swipeX, showStatuses: false}}" /></block></view></scroll-view>
    </view>
  </view>

  <view wx:elif="{{currentView === 'recognition-result'}}" class="page flow-page" data-testid="page-recognition-result">
    <view class="flow-header"><button class="flow-back" disabled="{{generationState === 'generating'}}" bindtap="onBackToStart" aria-label="返回导入版面"><image src="/assets/icons/arrow-left-gray.svg" mode="aspectFit" aria-hidden="true" /></button><view><text class="flow-title">识别结果</text><text class="flow-copy">核对每一赏当前的未贴票数</text></view><button class="flow-help" disabled="{{generationState === 'generating'}}" bindtap="onRecognitionWrong">识别有误?</button></view>
    <scroll-view class="flow-scroll" scroll-y show-scrollbar="false" scroll-top="{{recognitionScrollTop}}" data-scroll-key="recognitionScrollTop" bindscrollend="onRememberScrollEnd">
      <view class="price-field recognition-text-field recognition-ip-field light-capsule"><text>IP</text><view><view class="recognition-input-shell {{recognitionValidation.ipNameBlocking ? 'is-required-missing' : ''}}"><view class="recognition-input-glow" aria-hidden="true"></view><input class="recognition-ip-main" data-testid="recognition-ip-input" type="text" maxlength="60" placeholder="主 IP" value="{{recognitionIp}}" disabled="{{generationState === 'generating'}}" bindinput="onRecognitionIpInput" aria-label="版面主 IP" aria-invalid="{{recognitionValidation.ipNameBlocking}}" /></view><text class="recognition-ip-divider">/</text><view class="recognition-input-shell"><input class="recognition-theme-input" data-testid="recognition-theme-input" type="text" maxlength="60" placeholder="主题（选填）" value="{{recognitionTheme}}" disabled="{{generationState === 'generating'}}" bindinput="onRecognitionThemeInput" aria-label="版面主题" aria-invalid="false" /></view></view></view>
      <view class="price-field light-capsule"><text>单抽价格</text><view><view class="recognition-input-shell recognition-input-shell--price {{recognitionValidation.unitPriceBlocking ? 'is-required-missing' : ''}}"><view class="recognition-input-glow" aria-hidden="true"></view><input type="number" value="{{recognitionPrice === null ? '' : recognitionPrice}}" disabled="{{generationState === 'generating'}}" bindinput="onRecognitionPriceInput" aria-label="单抽价格" aria-invalid="{{recognitionValidation.unitPriceBlocking}}" /></view><text>¥</text></view></view>
      <view wx:if="{{recognitionMode === 'direct-upload'}}" class="price-field recognition-text-field light-capsule"><text>地点与备注</text><view><view class="recognition-input-shell recognition-input-shell--text {{recognitionValidation.locationNoteBlocking ? 'is-required-missing' : ''}}"><view class="recognition-input-glow" aria-hidden="true"></view><input type="text" maxlength="120" placeholder="填写门店、地点或现场备注" value="{{recognitionLocationNote}}" disabled="{{generationState === 'generating'}}" bindinput="onRecognitionLocationInput" aria-label="地点与备注" aria-invalid="{{recognitionValidation.locationNoteBlocking}}" /></view></view></view>
      <view class="recognition-grid">
        <view wx:for="{{recognitionValidation.tiers}}" wx:key="id" class="recognition-prize light-capsule">
          <view class="recognition-prize-head"><text class="recognition-tier">{{item.rawLabel}}</text></view>
          <view class="field-labels"><text>未贴票数 remainingTickets</text></view>
          <view class="field-inputs"><view class="recognition-input-shell recognition-input-shell--count {{item.remainingTicketsBlocking ? 'is-required-missing' : ''}}"><view class="recognition-input-glow" aria-hidden="true"></view><input data-testid="recognition-remaining-{{item.tier}}" class="field-input--dark" type="number" placeholder="待确认，可填 0" value="{{item.remainingTickets === null ? '' : item.remainingTickets}}" disabled="{{generationState === 'generating'}}" data-tier="{{item.tier}}" data-field="remainingTickets" bindinput="onRecognitionFieldInput" aria-label="{{item.rawLabel}}未贴票数" aria-invalid="{{item.remainingTicketsBlocking}}" /></view></view>
        </view>
      </view>
      <text wx:if="{{recognitionError}}" class="flow-error">{{recognitionError}}</text>
      <view wx:if="{{generationState === 'generating'}}" class="generation-status light-capsule" aria-live="polite"><view class="generation-status-dot"></view><text>正在生成版面</text></view>
    </scroll-view>
    <view class="fixed-primary"><view class="action-wrap"><view wx:if="{{recognitionValidation.canConfirm && generationState !== 'generating'}}" class="action-glow"></view><button data-testid="recognition-submit" class="action-button recognition-submit" disabled="{{!recognitionValidation.canConfirm || generationState === 'generating'}}" bindtap="onConfirmRecognition">下一步：设定大赏</button></view></view>
  </view>

  <view wx:elif="{{currentView === 'grand-prize-selection'}}" class="page flow-page" data-testid="page-grand-prize-selection">
    <view class="flow-header"><button class="flow-back" bindtap="onBackToRecognitionFromGrand" aria-label="返回识别结果"><image src="/assets/icons/arrow-left-gray.svg" mode="aspectFit" aria-hidden="true" /></button><view><text class="flow-title">设定大赏</text><text class="flow-copy">请根据原始版面标注，自行勾选大赏</text></view></view>
    <scroll-view class="flow-scroll" scroll-y show-scrollbar="false">
      <text wx:if="{{recognitionMode === 'direct-upload'}}" class="flow-copy">确认上传即表示分享本条记录。同意地图贡献条例并核验通过后，合格记录会自动进入地图。</text>
      <view class="grand-prize-list">
        <button wx:for="{{grandPrizeOptions}}" wx:key="id" class="grand-prize-option light-capsule {{item.selected ? 'grand-prize-option--selected' : ''}}" data-tier="{{item.tier}}" bindtap="onToggleGrandPrize" aria-pressed="{{item.selected}}">
          <view class="grand-prize-check">{{item.selected ? '✓' : ''}}</view><text>{{item.rawLabel}}</text><text>未贴票数 {{item.remainingTickets}}</text>
        </button>
      </view>
    </scroll-view>
    <view class="fixed-primary"><view class="action-wrap"><view class="action-glow"></view><button data-testid="grand-prize-submit" class="action-button recognition-submit" disabled="{{generationState === 'generating'}}" bindtap="onConfirmGrandPrizes">{{generationState === 'generating' ? '正在生成版面' : recognitionMode === 'direct-upload' ? '确认并上传版面' : '确认并进入一番赏版面'}}</button></view></view>
  </view>

  <view wx:elif="{{currentView === 'draw'}}" class="page page--draw" data-testid="page-draw">
    <view class="draw-edge-fade draw-edge-fade--top" aria-hidden="true"></view>
    <view class="draw-edge-fade draw-edge-fade--bottom" aria-hidden="true"></view>
    <view wx:if="{{activeDraft}}" class="draw-status light-capsule">
      <view class="draw-status-remaining"><text class="draw-ip">IP:: {{activeDraft.ipLabel}}</text><text class="draw-status-kicker">剩余抽数</text><view class="draw-status-number {{activeDraft.remaining > 9 ? 'draw-status-number--compact' : ''}}"><text>{{activeDraft.remaining}}</text><text>抽</text></view></view><view class="draw-status-divider"></view><view class="draw-status-buyout"><text class="draw-unit-price">单价: {{activeDraft.ticketPrice}}¥</text><text class="draw-last-label">LAST包套</text><view class="draw-buyout-number"><text>{{activeDraft.buyout}}</text><text>¥</text></view></view>
    </view>
    <view wx:if="{{toast.visible}}" class="draw-toast" catchtap="onDismissToast" aria-live="polite"><view class="toast-mascot"><image wx:if="{{toast.presentation === 'large'}}" src="/assets/v1-29/ichi-mascot-large.png" mode="aspectFit" aria-hidden="true" /><image wx:elif="{{toast.presentation === 'small'}}" src="/assets/v1-29/ichi-mascot-small.png" mode="aspectFit" aria-hidden="true" /><view wx:else class="toast-face" aria-hidden="true"><view></view><view></view></view></view><view class="toast-copy"><text>成功抽出 <text>{{toast.tier}}赏</text></text><text>{{toast.message}} · 累计 ¥{{toast.cost}}</text></view><view class="toast-remaining"><text>剩</text><text>{{toast.remaining}}</text></view></view>
    <scroll-view wx:if="{{activeDraft}}" class="draw-scroll" scroll-y show-scrollbar="false" scroll-top="{{drawScrollTop}}" data-scroll-key="drawScrollTop" bindscrollend="onRememberScrollEnd"><view class="draw-content">
      <view wx:if="{{activeDraft.grandPrizes.length > 0}}" class="draw-section"><view class="draw-section-title draw-section-title--grand"><image class="icon icon--section" src="/assets/icons/crown-pink.svg" mode="aspectFit" /><text>GRAND PRIZES</text></view><view class="draw-prize-grid"><block wx:for="{{activeDraft.grandPrizes}}" wx:key="id" wx:for-item="prize"><template is="prize-ticket" data="{{prize: prize, ticketPeelTier: ticketPeelTier, ticketPeelProgress: ticketPeelProgress, ticketPeelStyle: ticketPeelStyle, ticketPeelSettling: ticketPeelSettling, ticketPeelFading: ticketPeelFading}}" /></block></view></view>
      <view wx:if="{{activeDraft.normalPrizes.length > 0}}" class="draw-section"><view class="draw-section-title"><image class="icon icon--section" src="/assets/icons/ticket-black.svg" mode="aspectFit" /><text>NORMAL PRIZES</text></view><view class="draw-prize-grid"><block wx:for="{{activeDraft.normalPrizes}}" wx:key="id" wx:for-item="prize"><template is="prize-ticket" data="{{prize: prize, ticketPeelTier: ticketPeelTier, ticketPeelProgress: ticketPeelProgress, ticketPeelStyle: ticketPeelStyle, ticketPeelSettling: ticketPeelSettling, ticketPeelFading: ticketPeelFading}}" /></block></view></view>
    </view></scroll-view>
    <view class="draw-quick-actions"><button bindtap="onOpenProbability" aria-label="局面可能性"><image class="icon icon--quick" src="/assets/icons/chart-pie-slice-white.svg" mode="aspectFit" /></button><button bindtap="onUndoDraw" aria-label="撤销最近一抽"><image class="icon icon--quick" src="/assets/icons/arrow-u-up-left-white.svg" mode="aspectFit" /></button><button bindtap="onOpenHistory" aria-label="抽取记录"><image class="icon icon--quick" src="/assets/icons/clock-counter-clockwise-white.svg" mode="aspectFit" /></button></view>
    <view class="draw-stop-wrap"><button class="draw-stop-button {{stopHolding ? 'draw-stop-button--holding' : ''}}" bindtouchstart="onStopTouchStart" bindtouchend="onStopTouchEnd" bindtouchcancel="onStopTouchEnd" aria-label="长按决定收手"><view class="hold-fill"></view><view class="hold-content"><image class="icon icon--stop" src="/assets/icons/hand-palm-black.svg" mode="aspectFit" /><text>决定收手</text></view></button></view>
  </view>

  <view wx:if="{{currentView === 'map-preview'}}" class="page page--map" data-testid="page-map">
      <view class="map-content-stage">
      <map id="public-map" class="map-surface-placeholder" latitude="{{mapNativeCenterLatitude}}" longitude="{{mapNativeCenterLongitude}}" scale="{{mapNativeScale}}" markers="{{mapNativeDisplayMarkers}}" circles="{{mapCurrentLocationCircles}}" show-location="{{false}}" enable-zoom="true" enable-scroll="true" enable-rotate="false" enable-overlooking="false" bindupdated="onMapNativeUpdated" bindrendererror="onMapNativeRenderError" bindregionchange="onMapNativeRegionChange" bindmarkertap="onMapNativeMarkerTap" bindtap="onMapNativeTap" bindtouchstart="onMapOutsideTouchStart" aria-label="地图探索区域">
          <cover-view wx:if="{{!mapClusterPickerOpen && !modalView && (mapCardPhase === 'CLOSED' || mapSheetMode === 'CLOSED' || mapDetailPhase === 'IDLE')}}" class="map-floating-controls" aria-label="地图操作">
          <cover-view class="map-floating-control-shell"><cover-view class="map-control-button map-floating-control map-locate-control map-locate-control--{{mapLocationState}}" bindtap="onMapRecenter" role="button" aria-label="{{mapLocationState === 'LOADING' ? '正在回到我的位置' : '回到我的位置'}}"><cover-image src="/assets/icons/map-pin-black.png" aria-hidden="true" /></cover-view></cover-view>
          <cover-view class="map-floating-control-shell"><cover-view class="map-control-button map-floating-control" bindtap="onMapRefresh" role="button" aria-label="刷新当前地图"><cover-image src="/assets/icons/arrow-counter-clockwise-black.png" aria-hidden="true" /></cover-view></cover-view>
          </cover-view>
        </map>
      <view class="map-surface-layer" aria-label="地图页面控件">
      <view class="map-edge-fade map-edge-fade--top" aria-hidden="true"></view>
      <view class="map-edge-fade map-edge-fade--bottom" aria-hidden="true"></view>
      <view class="map-top-overlay">
        <view class="map-search-row">
          <view class="map-brand" aria-label="ICHI"><view class="map-info-mascot map-brand-mascot" aria-hidden="true"><view class="map-info-mascot-eyes"><view class="map-info-round-eye"></view><view class="map-info-round-eye"></view></view></view><text>ICHI</text></view>
          <view class="map-search-capsule"><image class="map-search-leading-icon" src="/assets/icons/magnifying-glass-gray.svg" mode="aspectFit" aria-hidden="true" /><input class="map-search-input" value="{{mapSearchText}}" maxlength="40" placeholder="搜索 IP / 关键词" confirm-type="search" bindinput="onMapSearchInput" aria-label="搜索公开 IP 或关键词" /><button wx:if="{{mapSearchText}}" class="map-control-button map-search-clear" bindtap="onMapClearSearch" aria-label="清空搜索"><image src="/assets/icons/x-gray.svg" mode="aspectFit" aria-hidden="true" /></button></view>
        </view>
        <view wx:if="{{mapDiscoveryChipsEnabled}}" class="map-filter-strip-row">
          <button class="map-control-button map-filter map-filter--all {{mapAllDiscoveryTagsSelected ? 'map-filter--active' : ''}}" bindtap="onMapResetDiscoveryFilters" aria-pressed="{{mapAllDiscoveryTagsSelected}}">🔥 显示全部</button>
          <scroll-view class="map-filter-scroll" scroll-x show-scrollbar="false" aria-label="正向机会筛选">
            <view class="map-filter-row"><button wx:for="{{mapDiscoveryTagOptions}}" wx:key="id" class="map-control-button map-filter {{item.selected ? 'map-filter--active' : ''}}" data-tag-id="{{item.id}}" bindtap="onMapToggleDiscoveryFilter" aria-pressed="{{item.selected}}">{{item.emoji}} {{item.label}}</button></view>
          </scroll-view>
      </view>
      </view>
      <view class="map-status-slot" aria-live="polite">
        <view wx:if="{{mapNativeRenderError}}" class="map-status-banner light-capsule"><text class="map-status-copy">地图未载入，请重新载入。</text><button class="map-status-action" bindtap="onMapRefresh">重新载入</button></view>
        <view wx:elif="{{mapPhase === 'INITIAL_LOADING'}}" class="map-status-banner light-capsule"><text class="map-status-copy">正在加载公开线索，可先浏览地图</text><view class="map-loading-dot map-status-loading-ring" aria-hidden="true"></view></view>
        <view wx:elif="{{mapPhase === 'REFRESHING'}}" class="map-status-banner light-capsule"><text class="map-status-copy">正在刷新，保留已有线索</text><view class="map-loading-dot map-status-loading-ring" aria-hidden="true"></view></view>
        <view wx:elif="{{mapReportMessage && mapReportLeadId === mapSelectedLeadId}}" class="map-status-banner light-capsule"><text class="map-status-copy">{{mapReportMessage}}</text><button wx:if="{{mapReportActive}}" class="map-status-action" bindtap="onCancelMapReport" disabled="{{mapReportBusy}}">取消举报</button></view>
        <view wx:elif="{{mapDiscoveryEmptyReason && mapSelectedDiscoveryTagIds.length === 0}}" class="map-status-banner light-capsule"><text class="map-status-copy">未选择状态，请显示全部。</text><button class="map-status-action" bindtap="onMapResetDiscoveryFilters">显示全部</button></view>
        <view wx:elif="{{mapDiscoveryEmptyReason && mapSelectedDiscoveryTagIds.length > 0}}" class="map-status-banner light-capsule"><text class="map-status-copy">{{mapSearchText ? '没有匹配线索，试试显示全部。' : '所选状态暂无公开线索。'}}</text><button class="map-status-action" bindtap="onMapResetDiscoveryFilters">显示全部</button></view>
        <view wx:elif="{{mapNetworkOffline}}" class="map-status-banner light-capsule"><text class="map-status-copy">{{mapMarkers.length > 0 ? '当前离线，保留上次公开线索。' : '当前离线，联网后可载入。'}}</text><button class="map-status-action" bindtap="onMapRetry">重试连接</button></view>
        <view wx:elif="{{mapErrorMessage && mapPhase !== 'PAGINATION_ERROR'}}" class="map-status-banner light-capsule"><text class="map-status-copy">{{mapErrorCode === 'UNAUTHORIZED' ? '账号状态需恢复，请重试。' : mapErrorCode === 'RATE_LIMITED' ? '请求较多，请稍后重试。' : mapErrorCode === 'SCHEMA_UNSUPPORTED' ? '版本不支持，请更新后再试。' : mapErrorCode === 'INVALID_VIEWPORT' ? '地图范围无效，请调整视野。' : mapMarkers.length > 0 ? '刷新失败，保留上次线索。' : '服务暂不可用，不代表无版面。'}}</text><button class="map-status-action" bindtap="onMapRetry">{{mapMarkers.length > 0 ? '重试' : '重新载入'}}</button></view>
        <view wx:elif="{{mapPhase === 'PAGINATION_ERROR'}}" class="map-status-banner light-capsule"><text class="map-status-copy">下一页载入失败，保留已有线索。</text><button class="map-status-action" bindtap="onMapRetry">重试下一页</button></view>
        <view wx:elif="{{mapPhase === 'VIEWPORT_REFRESHING' || mapPhase === 'CURSOR_RECOVERY' || mapPhase === 'PAGINATING'}}" class="map-status-banner light-capsule"><text class="map-status-copy">{{mapPhase === 'CURSOR_RECOVERY' ? '分页已失效，正重新载入。' : mapPhase === 'VIEWPORT_REFRESHING' ? '正在加载此区域，保留已有线索。' : '正在载入更多，保留已有线索。'}}</text></view>
        <view wx:elif="{{mapClientCacheStale || mapPhase === 'STALE_CACHE'}}" class="map-status-banner light-capsule"><text class="map-status-copy">缓存已过期，请刷新线索。</text><button class="map-status-action" bindtap="onMapRefresh">刷新缓存</button></view>
        <view wx:elif="{{mapLocationState === 'PERMISSION_NEEDED' || mapLocationState === 'UNAVAILABLE'}}" class="map-status-banner light-capsule"><text class="map-status-copy">{{mapLocationState === 'PERMISSION_NEEDED' ? '未开启定位' : '定位暂不可用'}}，仍可手动浏览。</text></view>
        <view wx:elif="{{mapHasMore && mapPhase === 'LOADED'}}" class="map-status-banner light-capsule"><text class="map-status-copy">此区域还有公开线索。</text><button class="map-status-action" bindtap="onMapLoadMore">加载更多</button></view>
        <view wx:elif="{{mapTruncated && mapPhase === 'LOADED'}}" class="map-status-banner light-capsule"><text class="map-status-copy">结果较多，请放大地图。</text></view>
        <view wx:elif="{{mapPhase === 'EMPTY'}}" class="map-status-banner light-capsule"><text class="map-status-copy">此视野暂无公开线索，可拖动查看。</text></view>
        <view wx:if="{{mapLocationState === 'APPROXIMATE'}}" class="map-status-banner light-capsule"><text class="map-status-copy">当前位置为大致位置，可能与实际位置有偏差。</text></view>
      </view>

      <template wx:if="{{!mapClusterPickerOpen}}" is="map-detail-card" data="{{mapCardPhase: mapCardPhase, mapSheetMode: mapSheetMode, mapDetailPhase: mapDetailPhase, mapDetail: mapDetail, mapDetailPreview: mapDetailPreview, mapReportActive: mapReportActive, mapReportBusy: mapReportBusy, mapContributorAvatarFailed: mapContributorAvatarFailed, mapDetailErrorMessage: mapDetailErrorMessage, topSafePx: topSafePx}}" />
      </view>
    </view>
  </view>

  <view wx:if="{{currentView === 'my'}}" class="page page--my" data-testid="page-my">
    <view class="profile"><button class="profile-avatar" bindtap="onOpenWechatProfileAuthorization" aria-label="更新微信头像"><image class="profile-avatar-image" src="{{accountAvatarUrl}}" mode="aspectFill" aria-label="微信头像" /></button><view class="profile-copy profile-copy--interactive" bindtap="onOpenWechatProfileAuthorization" role="button" aria-label="更新微信头像和昵称"><text class="profile-title">{{accountNickname}}</text><text class="profile-id">ID: {{accountIchiId}}</text><text class="profile-mode">{{accountState === 'ready' ? '微信账号' : (accountState === 'unavailable' ? '暂时离线' : '同步中')}}</text></view></view>
    <view class="menu-card light-capsule"><view class="menu-row" data-view="account" bindtap="onOpenMyPage"><view class="menu-icon"><image class="icon icon--menu" src="/assets/icons/gear-six-gray.svg" mode="aspectFit" /></view><text class="menu-label">账号管理</text><image class="icon icon--caret" src="/assets/icons/caret-right-gray.svg" mode="aspectFit" /></view><view class="menu-row" data-action="local-records" bindtap="onOpenLocalRecords"><view class="menu-icon menu-icon--dark"><image class="icon icon--menu" src="/assets/icons/hard-drives-white.svg" mode="aspectFit" /></view><text class="menu-label">我的记录</text><image class="icon icon--caret" src="/assets/icons/caret-right-gray.svg" mode="aspectFit" /></view><view class="menu-row" data-view="contributions" bindtap="onOpenMyPage"><view class="menu-icon menu-icon--accent"><image class="icon icon--menu" src="/assets/icons/hand-heart-pink.svg" mode="aspectFit" /></view><text class="menu-label">我上传的版面</text><image class="icon icon--caret" src="/assets/icons/caret-right-gray.svg" mode="aspectFit" /></view></view>
    <view class="menu-card light-capsule"><view class="menu-row" data-view="map-reminder" bindtap="onOpenMyPage"><view class="menu-icon"><image class="icon icon--menu" src="/assets/icons/bell-gray.svg" mode="aspectFit" /></view><text class="menu-label">提醒设置</text><image class="icon icon--caret" src="/assets/icons/caret-right-gray.svg" mode="aspectFit" /></view><view class="menu-row" data-view="method" bindtap="onOpenMyPage"><view class="menu-icon"><image class="icon icon--menu" src="/assets/icons/shield-check-gray.svg" mode="aspectFit" /></view><text class="menu-label">隐私与数据</text><image class="icon icon--caret" src="/assets/icons/caret-right-gray.svg" mode="aspectFit" /></view></view>
    <view wx:if="{{appFilingNumber}}" class="app-filing-footer" data-testid="app-filing-footer"><text class="app-filing-number" selectable="true">{{appFilingNumber}}</text><button class="app-filing-query" bindtap="onCopyAppFilingQueryUrl" aria-label="复制工信部备案查询网址">工信部备案查询 · 复制网址</button></view>
  </view>

  <view wx:if="{{currentView === 'account'}}" class="page subpage"><view class="subpage-header"><button class="back-button" bindtap="onBackToMy"><image class="icon icon--back" src="/assets/icons/arrow-left-gray.svg" mode="aspectFit" /></button><text class="subpage-title">账号管理</text></view><view class="account-card light-capsule"><view class="round-symbol"><image src="/assets/icons/lock-key-gray.svg" mode="aspectFit" /></view><text class="card-title">{{accountState === 'ready' ? accountNickname : '账号暂时无法同步'}}</text><text class="account-ichi-id">{{accountState === 'ready' ? accountIchiId : '请检查网络后重试'}}</text><text class="card-copy">微信头像和昵称用于本人资料；同意当前地图贡献条例后，合格公开版面可展示安全昵称与头像。更新资料不会改变 ICHI ID、识别额度或本人记录。</text><view class="account-quota"><text>今日版面识别</text><text>{{quotaRemaining}} / {{quotaLimit}} 次可用</text></view><view class="storage-meter {{storageCapacityState === 'near_limit' || storageCapacityState === 'full' ? 'storage-meter--warning' : ''}}"><view><view style="{{storageMeterFillStyle}}"></view></view><text wx:if="{{storageCapacityState !== 'unknown'}}">本机空间已使用 {{storagePercent}}%</text><text wx:else>暂时无法读取本机空间状态</text></view></view><view class="subpage-actions"><button class="action-button inline-action" bindtap="onOpenLocalRecords">我的记录</button><button class="ghost-button" bindtap="onBackToMy">返回我的</button></view></view>

  <view wx:if="{{currentView === 'local-records'}}" class="page page--records" data-testid="page-local-records"><view class="subpage-header"><button class="back-button" bindtap="onBackToMy" aria-label="返回我的"><image class="icon icon--back" src="/assets/icons/arrow-left-gray.svg" mode="aspectFit" aria-hidden="true" /></button><text class="subpage-title">我的记录</text></view><view class="record-summary"><text>本机 {{drafts.length}} 个</text><text>待上传 {{unuploadedCount}} 个</text></view><scroll-view class="records-scroll" scroll-y enhanced="true" bounces="true" enable-flex="true" show-scrollbar="false" refresher-enabled="true" refresher-threshold="64" refresher-triggered="{{recordsRefreshing}}" scroll-top="{{recordsScrollTop}}" data-scroll-key="recordsScrollTop" bindscrollend="onRememberScrollEnd" bindrefresherrefresh="onRecordsRefresherRefresh"><view class="records-refresh-surface"><view wx:if="{{drafts.length > 0}}" class="records-list"><block wx:for="{{drafts}}" wx:key="boardId"><template is="record-row" data="{{item: item, swipeX: item.swipeX}}" /></block></view><view wx:else class="records-empty light-capsule"><text class="records-empty-title">还没有本人记录</text><text class="records-empty-copy">本机保存的版面记录会显示在这里。</text></view></view></scroll-view></view>

  <view wx:if="{{currentView === 'contributions'}}" class="page subpage">
    <view class="subpage-header"><button class="back-button" bindtap="onBackToMy"><image class="icon icon--back" src="/assets/icons/arrow-left-gray.svg" mode="aspectFit" /></button><text class="subpage-title">我上传的版面</text></view>
    <view wx:if="{{mapContributionConsentPhase === 'LOADING'}}" class="map-authorization-card light-capsule"><text class="card-title">正在读取地图贡献条例状态</text></view>
    <view wx:elif="{{mapContributionConsentPhase === 'UNAVAILABLE'}}" class="map-authorization-card light-capsule"><text class="card-title">条例状态暂不可用</text><text class="card-copy">请稍后重新读取，再查看你的地图贡献状态。</text><button class="ghost-button map-authorization-manage" bindtap="refreshMapContributionConsent">重新读取</button></view>
    <view wx:elif="{{mapContributionConsent && !mapContributionConsent.accepted}}" class="map-authorization-card light-capsule" data-testid="map-contribution-consent-card"><view class="map-authorization-head"><view><text class="card-title">地图贡献条例</text><text class="card-copy">分享上传即授权本条记录；同意当前条例并通过核验后，合格记录自动进入地图。</text></view><text class="status-pill">未同意</text></view><button class="ghost-button map-authorization-manage" bindtap="onOpenMapContributionConsent">了解并同意</button></view>
    <view wx:if="{{humanAssistanceRequests.length}}" class="map-owner-list" data-testid="human-assistance-my-uploads"><text class="map-owner-list-title">待你确认的版面关系</text><view wx:for="{{humanAssistanceRequests}}" wx:key="requestId" class="map-owner-row light-capsule"><view><text class="draft-title">{{item.currentBoardLabel}}</text><text class="record-identity-meta">这次上传与另一张版面是否为同一张？</text></view><button class="ghost-button" data-request-id="{{item.requestId}}" bindtap="onOpenHumanAssistance">查看并回答</button></view></view>
    <view class="record-summary"><text>云端 {{cloudClues.length + candidateUploads.length}} 个<text wx:if="{{pendingDirectUploads.length}}"> · 待上传 {{pendingDirectUploads.length}} 个</text></text></view>
    <scroll-view class="records-scroll" scroll-y enhanced="true" bounces="true" enable-flex="true" show-scrollbar="false" refresher-enabled="true" refresher-threshold="64" refresher-triggered="{{recordsRefreshing}}" bindrefresherrefresh="onRecordsRefresherRefresh">
      <view class="records-refresh-surface"><view wx:if="{{cloudClues.length || candidateUploads.length || pendingDirectUploads.length}}" class="records-list">
        <view wx:for="{{pendingDirectUploads}}" wx:key="boardId" class="swipe-row" data-testid="pending-direct-upload">
          <view class="draft-card contribution-card {{item.verificationAction ? 'contribution-card--action' : ''}} light-capsule"><image class="draft-watermark" src="/assets/v1-29/ichi-mascot-large-watermark.png" mode="aspectFit" aria-hidden="true" /><text class="record-state-badge status-pill status-pill--dark">{{item.recordStateLabel}}</text><view class="draft-copy"><text class="draft-title">{{item.title}}</text><text class="record-identity-meta">{{item.identityMeta}}</text><text class="draft-meta">{{item.statsMeta}}</text></view><button wx:if="{{item.verificationAction === 'edit-note'}}" class="record-verification-action" data-board-id="{{item.boardId}}" bindtap="onEditTicketNote">修改备注</button><button wx:if="{{item.verificationAction === 'retry'}}" class="record-verification-action" data-board-id="{{item.boardId}}" bindtap="onRetryTicketVerification">重新核验</button></view>
        </view>
        <view wx:for="{{cloudClues}}" wx:key="recordId" class="swipe-row">
          <button wx:if="{{item.swipeX !== 0}}" class="swipe-delete swipe-delete--visible" disabled="{{item.isDeleting}}" data-record-id="{{item.recordId}}" data-board-id="{{item.boardId}}" catchtap="onDeleteCloudRecord" aria-label="删除{{item.title}}"><image class="icon icon--trash" src="/assets/icons/trash-white.svg" mode="aspectFit" /></button>
          <view class="draft-card contribution-card {{item.verificationAction ? 'contribution-card--action' : ''}} swipe-content light-capsule" style="transform: translateX({{item.swipeX}}px);" data-board-id="{{item.recordId}}" data-deleting="{{item.isDeleting}}" bindtouchstart="onTouchStart" bindtouchmove="onTouchMove" bindtouchend="onTouchEnd" bindtouchcancel="onTouchEnd"><image class="draft-watermark" src="/assets/v1-29/ichi-mascot-large-watermark.png" mode="aspectFit" aria-hidden="true" /><text class="record-state-badge status-pill {{item.recordStateLabel === '已上传' && !item.isDeleting ? 'status-pill--uploaded' : 'status-pill--dark'}}">{{item.isDeleting ? '删除中' : item.recordStateLabel}}</text><view class="draft-copy"><text class="draft-title">{{item.title}}</text><text class="record-identity-meta">{{item.identityMeta}}</text><text class="draft-meta">{{item.statsMeta}}</text></view><button wx:if="{{item.verificationAction === 'retry' && !item.isDeleting}}" class="record-verification-action" data-board-id="{{item.boardId}}" bindtap="onRetryTicketVerification">重新核验</button><button wx:if="{{item.verificationAction === 'reupload' && !item.isDeleting}}" class="record-verification-action" data-board-id="{{item.boardId}}" bindtap="onReuploadTicketEvidence">重新上传</button><button wx:if="{{item.verificationAction === 'edit-note' && !item.isDeleting}}" class="record-verification-action" data-board-id="{{item.boardId}}" bindtap="onEditTicketNote">修改备注</button></view>
        </view>
        <view wx:for="{{candidateUploads}}" wx:key="candidateRecordRef" class="swipe-row" data-testid="candidate-my-uploads">
          <button wx:if="{{item.swipeX !== 0}}" class="swipe-delete swipe-delete--visible" disabled="{{item.isDeleting}}" data-candidate-record-ref="{{item.candidateRecordRef}}" catchtap="onDeleteCandidateUpload" aria-label="删除合成版面上传"><image class="icon icon--trash" src="/assets/icons/trash-white.svg" mode="aspectFit" /></button>
          <view class="draft-card contribution-card swipe-content light-capsule" style="transform: translateX({{item.swipeX}}px);" data-board-id="{{item.candidateRecordRef}}" data-deleting="{{item.isDeleting}}" bindtouchstart="onTouchStart" bindtouchmove="onTouchMove" bindtouchend="onTouchEnd" bindtouchcancel="onTouchEnd"><image class="draft-watermark" src="/assets/v1-29/ichi-mascot-large-watermark.png" mode="aspectFit" aria-hidden="true" /><text class="record-state-badge status-pill {{item.isDeleting ? 'status-pill--dark' : 'status-pill--uploaded'}}">{{item.isDeleting ? '删除中' : item.validationState === 'VERIFIED' ? '已上传' : '待核对'}}</text><view class="draft-copy"><text class="draft-title">合成版面上传</text><text class="record-identity-meta">候选测试记录</text><text class="draft-meta">仅供真机测试</text></view></view>
        </view>
      </view><view wx:else class="records-empty light-capsule"><text class="records-empty-title">还没有已上传的版面</text><text class="records-empty-copy">通过“仅上传版面”或提交赏票核对的记录会显示在这里。</text></view></view>
    </scroll-view>
  </view>

  <view wx:if="{{currentView === 'map-reminder'}}" class="page subpage" data-testid="page-map-reminder"><view class="subpage-header"><button class="back-button" bindtap="onBackToMy"><image class="icon icon--back" src="/assets/icons/arrow-left-gray.svg" mode="aspectFit" /></button><text class="subpage-title">提醒设置</text></view><scroll-view class="method-scroll" scroll-y scroll-top="{{reminderScrollTop}}" data-scroll-key="reminderScrollTop" bindscrollend="onRememberScrollEnd"><view class="method-card light-capsule"><image src="/assets/icons/map-pin-pink.svg" mode="aspectFit" /><view><text>会提醒什么</text><text>当关注地点出现新的、已核对的版面记录或状态更新时，好版地图会整理成可查看的线索。它不是实时库存提醒。</text></view></view><view class="method-card light-capsule"><image src="/assets/icons/bell-pink.svg" mode="aspectFit" /><view><text>当前状态</text><text>V1 先保留这个说明入口。真实提醒设置、账号授权与通知能力将在 V2 的好版地图中接入。</text></view></view><button class="ghost-button subpage-wide-action" bindtap="onBackToMy">返回我的</button></scroll-view></view>

  <view wx:if="{{currentView === 'method'}}" class="page subpage" data-testid="page-method"><view class="subpage-header"><button class="back-button" bindtap="onBackToMy"><image class="icon icon--back" src="/assets/icons/arrow-left-gray.svg" mode="aspectFit" /></button><text class="subpage-title">隐私与数据</text></view><scroll-view class="method-scroll" scroll-y scroll-top="{{methodScrollTop}}" data-scroll-key="methodScrollTop" bindscrollend="onRememberScrollEnd"><view class="method-card light-capsule"><image src="/assets/icons/calculator-pink.svg" mode="aspectFit" /><view><text>怎么算</text><text>系统基于当前余票，采用超几何分布模型实时计算。不包含玄学或保底暗示。</text></view></view><view class="method-card light-capsule"><image src="/assets/icons/image-pink.svg" mode="aspectFit" /><view><text>照片怎么用</text><text>版面照片和赏票照片都只用于当次识别或核验，终态后删除，不形成长期图片记录。</text></view></view><view class="method-card light-capsule"><image src="/assets/icons/database-pink.svg" mode="aspectFit" /><view><text>记录放在哪里</text><text>待上传草稿保存在当前设备；确认后的结构化版面、位置和核对状态归属您的私有云端账号，V1 不公开地图。</text></view></view><text class="unofficial-note">ICHI 是非官方的记录与计算工具，不代表一番赏品牌方、门店或实时库存。</text><button class="danger-action" bindtap="onClearAllLocalData"><image src="/assets/icons/trash-pink.svg" mode="aspectFit" /><text>删除全部本地数据</text></button><view class="subpage-actions method-actions"><button class="action-button inline-action" bindtap="onBackToStart">返回票池</button><button class="ghost-button" bindtap="onOpenLocalRecords">管理记录</button></view></scroll-view></view>

  <view wx:if="{{currentView === 'cannot-build-pool'}}" class="page state-page"><view class="state-card state-card--hero exception-card light-capsule"><view class="round-symbol round-symbol--exception"><image src="/assets/icons/warning-white.svg" mode="aspectFit" aria-hidden="true" /></view><text class="state-title">无法建立票池</text><text class="card-copy">{{recognitionError || '可能是识别失败、照片中版面不完整，或识别出的各奖级数量不守恒。'}}</text><view class="state-actions"><view class="action-wrap"><view class="action-glow"></view><button class="action-button" bindtap="onRetryRecognitionGate">重新拍摄版面</button></view></view></view></view>

  <view wx:if="{{currentView === 'undo-protected'}}" class="page state-page" data-testid="page-undo-protected"><view class="state-card state-card--hero exception-card light-capsule"><view class="round-symbol round-symbol--exception"><image src="/assets/icons/arrow-u-up-left-white.svg" mode="aspectFit" /></view><text class="state-title">无法继续撤销</text><text class="card-copy">为保护已经确认的记录，只能连续撤销最近 50 抽，不能跳过中间轮次。</text><view class="state-actions"><button class="ghost-button" bindtap="onReturnToDraw">回到一番赏版面</button></view></view></view>

  <view wx:if="{{currentView === 'storage-fallback'}}" class="page state-page" data-testid="page-storage-fallback"><view class="state-card state-card--hero exception-card light-capsule"><view class="round-symbol round-symbol--exception"><image src="/assets/icons/database-white.svg" mode="aspectFit" /></view><text class="state-title">暂时无法读取存储状态</text><text class="card-copy">现有记录没有被删除。可以返回管理本机记录，或回到当前一番赏版面后重试。</text><view class="state-actions"><button class="ghost-button" bindtap="onOpenLocalRecords">管理记录</button><button wx:if="{{activeDraft}}" class="ghost-button" bindtap="onReturnToDraw">回到一番赏版面</button><button wx:else class="ghost-button" bindtap="onBackToMy">返回我的</button></view></view></view>

  <view wx:if="{{currentView === 'schema-incompatible'}}" class="page state-page"><view class="state-card state-card--hero exception-card light-capsule"><view class="round-symbol round-symbol--exception"><image src="/assets/icons/warning-white.svg" mode="aspectFit" /></view><text class="state-title">本机记录结构不兼容</text><text class="card-copy">检测到无法读取的旧版数据。为避免误改，原数据尚未自动覆盖。</text><view class="state-actions"><button class="ghost-button" bindtap="onRecoverSchema">清除不兼容数据并回首页</button></view></view></view>

  <view wx:if="{{currentView === 'deleted'}}" class="page state-page"><view class="state-card state-card--hero exception-card light-capsule"><view class="round-symbol round-symbol--exception"><image src="/assets/icons/trash-white.svg" mode="aspectFit" /></view><text class="state-title">记录已清空</text><text class="card-copy">当前设备中的票池、抽取记录和本地草稿已经删除。</text><view class="state-actions"><view class="action-wrap"><view class="action-glow"></view><button class="action-button" bindtap="onBackToStart">建立新的票池</button></view></view></view></view>

  <view wx:if="{{modalView === 'profile-edit'}}" class="modal-layer modal-layer--profile-edit" catchtap="onBlockTap" role="dialog" aria-label="更新个人资料"><view class="modal-card profile-edit-card light-capsule"><button class="profile-edit-back" bindtap="onCloseWechatProfileAuthorization" aria-label="返回我的"><image src="/assets/icons/arrow-left-gray.svg" mode="aspectFit" aria-hidden="true" /></button><button class="profile-edit-avatar" open-type="chooseAvatar" bindchooseavatar="onChooseWechatAvatar" aria-label="选择个人头像"><image src="{{profileAvatarPath || accountAvatarUrl}}" mode="aspectFill" /></button><text class="state-title">更新个人资料</text><text class="card-copy">头像和昵称用于本人资料；同意当前地图贡献条例后，合格公开版面可展示安全昵称与头像，不影响账号或基础功能。</text><input class="account-profile-nickname" type="nickname" maxlength="32" value="{{profileNicknameDraft}}" placeholder="个人昵称" bindinput="onProfileNicknameInput" aria-label="个人昵称" /><view class="action-wrap"><view wx:if="{{profileAuthorizationReady}}" class="action-glow"></view><button class="action-button" disabled="{{!profileAuthorizationReady}}" bindtap="onAuthorizeWechatProfile">确认更新</button></view></view></view>

  <view wx:if="{{modalView === 'capture-permission-required'}}" class="modal-layer" catchtap="onBlockTap" role="dialog" aria-label="需要拍摄权限"><view class="modal-card modal-card--exception exception-card light-capsule"><view class="round-symbol round-symbol--exception"><image src="/assets/icons/warning-white.svg" mode="aspectFit" /></view><text class="state-title">需要拍摄权限</text><text class="card-copy">拍摄版面需要相机和当前位置。首次允许后，微信会记住授权状态；后续拍摄不会重复询问。</text><view class="state-actions"><button class="ghost-button" bindtap="onOpenCapturePermissionSettings">前往设置</button><button class="text-button" bindtap="onCloseModal">稍后再试</button></view></view></view>

  <view wx:if="{{modalView === 'probability'}}" class="modal-layer" catchtap="onBlockTap" role="dialog" aria-label="局面可能性"><view class="modal-card light-capsule"><view class="modal-head"><text>局面可能性</text><button bindtap="onCloseModal" aria-label="关闭局面可能性"><image src="/assets/icons/x-gray.svg" mode="aspectFit" aria-hidden="true" /></button></view><scroll-view class="modal-scroll" scroll-y><view wx:if="{{outlook.status === 'available'}}"><text class="outlook-window">观察窗口（接下来 {{outlook.windowDraws}} 抽以内）</text><view wx:for="{{outlook.events}}" wx:key="id" class="outlook-event"><text>{{item.label}}</text><text>{{item.percentage}}%</text></view><view class="outlook-cost"><text>观察窗口累计成本</text><text>¥{{outlook.cumulativeCost}}</text></view></view><text wx:else class="card-copy">{{outlook.reason}}</text></scroll-view><text class="modal-disclaimer">结果不保证；停止仍可选</text></view></view>

  <view wx:if="{{modalView === 'history'}}" class="modal-layer" catchtap="onBlockTap" role="dialog" aria-label="抽取记录"><view class="modal-card light-capsule"><view class="modal-head"><text>抽取记录</text><button bindtap="onCloseModal" aria-label="关闭抽取记录"><image src="/assets/icons/x-gray.svg" mode="aspectFit" aria-hidden="true" /></button></view><scroll-view class="modal-scroll" scroll-y><view wx:if="{{activeDraft.historyItems.length}}" class="history-list"><view wx:for="{{activeDraft.historyItems}}" wx:key="id" class="history-row"><view class="history-row-main"><text class="history-index">#{{item.index}}</text><text class="history-tier">{{item.tier}}赏</text></view><view class="history-row-meta"><text class="history-remaining">余 {{item.remaining}}</text><text class="history-cost">¥{{item.cost}}</text></view></view></view><view wx:else class="records-empty"><text class="records-empty-title">还没有抽取记录</text></view></scroll-view></view></view>

  <view wx:if="{{modalView === 'share-decision'}}" class="modal-layer modal-layer--share-decision" catchtap="onBlockTap"><view class="modal-card share-card light-capsule"><view class="round-symbol"><image src="/assets/icons/share-network-black.svg" mode="aspectFit" /></view><text class="state-title">分享本次记录？</text><text class="card-copy">先拍下已抽出的赏票，再和记录核对，为其他玩家提供真实参考。同意地图贡献条例后，分享并上传的记录核验通过就会自动进入地图。</text><view class="share-actions"><view class="action-wrap"><view class="action-glow"></view><button class="action-button" bindtap="onOpenShareCapture">愿意并拍摄赏票</button></view><button class="ghost-button" bindtap="onContinueDraw">继续抽赏</button><button class="text-button" bindtap="onSaveDraftAndExit">暂不分享并退出</button></view></view></view>

  <view wx:if="{{modalView === 'share-capture'}}" class="share-capture" catchtap="onBlockTap"><button class="flow-back share-back" bindtap="onBackToShareDecision" aria-label="返回分享选择"><image src="/assets/icons/arrow-left-gray.svg" mode="aspectFit" aria-hidden="true" /></button><view class="share-frame"><image wx:if="{{shareImagePath}}" class="share-evidence-photo" src="{{shareImagePath}}" mode="aspectFill" /><camera wx:elif="{{cameraStatus === 'loading' || cameraStatus === 'ready'}}" class="share-camera-preview" data-camera-generation="{{cameraGeneration}}" mode="normal" device-position="back" flash="off" resolution="high" bindinitdone="onCameraReady" binderror="onCameraError" aria-label="赏票实时取景"></camera><view wx:else class="camera-permission-panel camera-permission-panel--share"><image class="camera-permission-icon" src="/assets/icons/camera-light.svg" mode="aspectFit" aria-hidden="true" /><text class="camera-permission-title">{{cameraStatus === 'denied' ? '开启相机权限' : '相机暂时不可用'}}</text><text class="camera-permission-copy">{{cameraError}}</text><button wx:if="{{cameraStatus === 'denied'}}" class="camera-permission-action" hover-class="none" bindtap="onOpenCameraSettings">前往设置</button><button wx:else class="camera-permission-action" hover-class="none" bindtap="onRetryCamera">重新尝试</button></view></view><view class="capture-actions"><view class="capture-action-spacer" aria-hidden="true"></view><button class="capture-button" hover-class="none" disabled="{{mediaBusy || cameraStatus === 'denied' || cameraStatus === 'unavailable' || shareImagePath}}" bindtap="onCaptureEvidence">{{shareImagePath ? '已拍摄' : pendingEvidenceCapture ? '准备拍摄' : '拍摄赏票'}}</button><button class="circle-action capture-undo" disabled="{{!shareImagePath}}" bindtap="onRetakeEvidence" aria-label="撤回已拍摄赏票"><image src="/assets/icons/arrow-counter-clockwise-gray.svg" mode="aspectFit" aria-hidden="true" /></button></view><view class="share-meta"><text>门店地点与备注（必填）</text><view><input value="{{shareNote}}" bindinput="onShareNoteInput" placeholder="万达广场B1 XX店可以捡漏" aria-label="用户备注" /><button class="share-confirm {{shareReady ? 'share-confirm--ready' : ''}} {{evidenceSubmitting ? 'share-confirm--submitting' : ''}}" disabled="{{!shareReady || evidenceSubmitting}}" bindtap="onSubmitEvidence" aria-label="{{evidenceSubmitting ? '正在上传赏票' : '提交赏票核对'}}"><view wx:if="{{evidenceSubmitting}}" class="share-confirm-spinner" aria-hidden="true"></view><image wx:else src="/assets/icons/check-white.svg" mode="aspectFit" aria-hidden="true" /></button></view></view><text class="share-consent">赏票照片只用于本次核验，核验终态后删除；正式记录只保留结构化结果、位置和你的原文备注。</text></view>

  <view wx:if="{{modalView === 'submitted'}}" class="modal-layer modal-layer--submitted" catchtap="onBlockTap"><view class="modal-card modal-card--submitted share-card light-capsule"><view class="round-symbol"><image src="/assets/icons/check-black.svg" mode="aspectFit" /></view><text class="state-title">已提交</text><text class="card-copy">后台正在核对。本次提交退出后可导入新的版面。</text><view class="share-actions submitted-actions"><view class="action-wrap"><view class="action-glow"></view><button class="action-button" bindtap="onSubmittedExit">退出回首页</button></view><button class="ghost-button" bindtap="onStayOnBoard">留在当前版面</button></view></view></view>

  <view wx:if="{{modalView === 'board-upload-submitted'}}" class="modal-layer modal-layer--submitted" catchtap="onBlockTap"><view class="modal-card modal-card--submitted share-card light-capsule"><view class="round-symbol"><image src="/assets/icons/check-black.svg" mode="aspectFit" /></view><text class="state-title">已提交</text><text class="card-copy">{{mapUploadSharingMessage}}</text><view class="share-actions submitted-actions submitted-actions--single"><view class="action-wrap"><view class="action-glow"></view><button class="action-button" bindtap="onSubmittedExit">退出回首页</button></view></view></view></view>

  <view wx:if="{{modalView === 'human-assistance' && humanAssistanceSelected}}" class="modal-layer" catchtap="onBlockTap" role="dialog" aria-label="确认版面关系"><view class="modal-card human-assistance-modal light-capsule"><text class="state-title">这两次看到的是同一张版面吗？</text><text class="card-copy">你的回答只是辅助线索，不会直接合并版面。</text><view class="human-assistance-comparison"><view class="human-assistance-board"><text>这次上传</text><text>{{humanAssistanceSelected.currentBoardLabel}}</text></view><view class="human-assistance-board"><text>可能相关</text><text>{{humanAssistanceSelected.candidateBoardLabel}}</text></view></view><text wx:if="{{humanAssistanceError}}" class="map-authorization-warning">{{humanAssistanceError}}</text><view class="human-assistance-actions"><button class="ghost-button" disabled="{{humanAssistanceBusy}}" data-answer="SAME_BOARD" bindtap="onAnswerHumanAssistance">是同一张</button><button class="ghost-button" disabled="{{humanAssistanceBusy}}" data-answer="DIFFERENT_BOARD" bindtap="onAnswerHumanAssistance">不是同一张</button><button class="ghost-button" disabled="{{humanAssistanceBusy}}" data-answer="CANNOT_TELL" bindtap="onAnswerHumanAssistance">无法判断</button><button class="text-button" disabled="{{humanAssistanceBusy}}" data-answer="SKIP" bindtap="onAnswerHumanAssistance">跳过</button><button class="text-button" disabled="{{humanAssistanceBusy}}" bindtap="onCloseHumanAssistance">稍后再说</button></view></view></view>

  <view wx:if="{{modalView === 'map-contribution-consent'}}" class="modal-layer" catchtap="onBlockTap" role="dialog" aria-label="地图贡献条例">
    <view class="modal-card map-authorization-modal light-capsule">
      <text class="state-title map-authorization-title">地图贡献条例</text>
      <scroll-view class="modal-scroll map-authorization-scroll" scroll-y enhanced="true" bounces="false" show-scrollbar="true" scroll-top="{{mapContributionTermsScrollTop}}" aria-label="地图贡献条例全文">
        <view class="map-authorization-copy">
          <text class="map-authorization-paragraph map-authorization-intro">{{mapContributionTermsIntro}}</text>
          <view wx:for="{{mapContributionTermsSections}}" wx:for-item="section" wx:key="title" class="map-authorization-section">
            <text class="map-authorization-section-title">{{section.title}}</text>
            <text wx:for="{{section.paragraphs}}" wx:for-item="paragraph" wx:key="*this" class="map-authorization-paragraph">{{paragraph}}</text>
          </view>
        </view>
      </scroll-view>
      <text class="map-authorization-binding-copy">同意后与账号绑定，无需重复确认。</text>
      <text wx:if="{{mapContributionConsentError}}" class="map-authorization-warning">{{mapContributionConsentError}}</text>
      <view class="map-authorization-actions">
        <button class="action-button" disabled="{{!mapContributionConsent || mapContributionConsentBusy || mapContributionConsent.accepted || mapContributionConsentSeconds > 0}}" bindtap="onChooseMapContributionConsent">同意并开启<text wx:if="{{mapContributionConsentSeconds > 0}}" class="map-authorization-countdown">（{{mapContributionConsentSeconds}}秒）</text></button>
        <button class="text-button" disabled="{{mapContributionConsentBusy}}" bindtap="onCloseModal">暂不同意</button>
      </view>
    </view>
  </view>


  <view wx:if="{{modalView === 'storage-warning'}}" class="modal-layer" catchtap="onBlockTap"><view class="modal-card modal-card--exception exception-card light-capsule"><view class="round-symbol round-symbol--exception"><image src="/assets/icons/warning-white.svg" mode="aspectFit" /></view><text class="state-title">本机空间不足</text><text class="card-copy">这次改动没有安全写入。现有记录未删除，请先管理本地记录后重试。</text><view class="state-actions"><button class="ghost-button" data-view="local-records" bindtap="onOpenMyPage">管理记录</button></view></view></view>

  <view wx:if="{{modalView === 'quota-exhausted'}}" class="modal-layer" catchtap="onBlockTap" role="dialog" aria-label="无法建立票池"><view class="modal-card modal-card--exception exception-card light-capsule"><view class="round-symbol round-symbol--exception"><image src="/assets/icons/warning-white.svg" mode="aspectFit" /></view><text class="state-title">无法建立票池</text><text class="card-copy">今天的 {{quotaLimit}} 次版面识别额度已经用完，今日无法继续拍摄识别。额度会在北京时间次日 00:00 自动恢复；已有草稿仍可继续抽赏。</text><view class="state-actions"><button class="ghost-button" bindtap="onResetQuotaCapture">我知道了</button></view></view></view>

  <view wx:if="{{modalView === 'account-unavailable'}}" class="modal-layer" catchtap="onBlockTap" role="dialog" aria-label="账号暂时无法连接"><view class="modal-card modal-card--exception exception-card light-capsule"><view class="round-symbol round-symbol--exception"><image src="/assets/icons/warning-white.svg" mode="aspectFit" /></view><text class="state-title">账号暂时无法连接</text><text class="card-copy">建立新版面需要先确认微信账号和今日额度。已有本机草稿不受影响。</text><view class="state-actions"><button class="ghost-button" bindtap="onRetryRecognitionGate">重新连接</button><button class="text-button" bindtap="onCloseModal">稍后再试</button></view></view></view>

  <view wx:if="{{modalView === 'delete-uploaded-board'}}" class="modal-layer" catchtap="onBlockTap" role="dialog" aria-label="删除版面线索"><view class="modal-card modal-card--exception exception-card light-capsule"><view class="round-symbol round-symbol--exception"><image src="/assets/icons/warning-white.svg" mode="aspectFit" aria-hidden="true" /></view><text class="state-title">删除版面线索</text><text class="card-copy">删除本人上传记录后，将重新计算地图公开内容；若仍有其他有效贡献，地图版面会保留。此操作无法恢复。</text><view class="state-actions"><view class="action-wrap"><button class="action-button" bindtap="onConfirmDeleteUploadedBoard">删除</button></view><button class="ghost-button" bindtap="onCancelDeleteUploadedBoard">取消</button></view></view></view>

  <view wx:if="{{modalView === 'note-review'}}" class="modal-layer modal-layer--note-review" catchtap="onBlockTap" role="dialog" aria-label="修改备注"><view class="modal-card modal-card--note-review light-capsule"><view class="modal-head"><text>修改备注</text><button bindtap="onCloseModal" aria-label="关闭修改备注"><image src="/assets/icons/x-gray.svg" mode="aspectFit" aria-hidden="true" /></button></view><input class="account-profile-nickname note-review-input" maxlength="300" value="{{shareNote}}" placeholder="填写你的现场备注" bindinput="onReviewNoteInput" aria-label="用户备注" /><text class="card-copy note-review-copy">{{noteReviewSourcePath === 'direct-upload' ? '备注通过安全审核后，本条记录才会完成上传。' : '只会重新核验备注，不会重复地点或照片核验。'}}</text><view class="action-wrap note-review-actions"><view wx:if="{{shareNote && !evidenceSubmitting}}" class="action-glow"></view><button class="action-button" disabled="{{!shareNote || evidenceSubmitting}}" bindtap="onSubmitNoteReview">重新核验备注</button></view></view></view>

  <view wx:if="{{currentView === 'map-preview' && mapClusterPickerOpen}}" class="modal-layer map-cluster-picker-layer {{mapCardPhase !== 'CLOSED' ? 'map-cluster-picker-layer--detail' : ''}}" role="dialog" aria-label="选择此位置的版面">
    <view class="map-cluster-picker-scrim" catchtap="onMapClusterPickerOutsideDetailTap" bindtouchstart="onMapClusterPickerOutsideTouchStart" catchtouchmove="onMapClusterPickerOutsideTouchMove"></view>
    <view class="modal-card light-capsule map-cluster-picker-sheet" catchtap="onBlockTap" bindtouchstart="onMapOverlayTouchStart" catchtouchmove="onMapOverlayTouchMove" bindtouchend="onMapOverlayTouchEnd" bindtouchcancel="onMapOverlayTouchEnd">
      <view class="modal-head map-cluster-picker-head"><text>选择版面</text><text class="map-cluster-picker-count">此位置有 {{mapClusterPickerItems.length}} 个版面</text><button catchtap="onCloseMapClusterPicker" aria-label="关闭版面选择"><image src="/assets/icons/x-gray.svg" mode="aspectFit" aria-hidden="true" /></button></view>
      <button wx:if="{{mapClusterPickerImageError}}" class="text-button map-cluster-picker-retry" catchtap="prepareMapClusterPickerImages">重新载入信息条</button>
      <scroll-view class="modal-scroll map-cluster-picker-scroll" scroll-y="{{true}}" enhanced="{{true}}" bounces="{{true}}" show-scrollbar="{{false}}" bindscroll="onMapClusterPickerScroll" refresher-enabled="{{true}}" refresher-triggered="{{mapClusterPickerRefreshing}}" bindrefresherrefresh="onMapClusterPickerRefresh" aria-label="此位置的版面列表">
        <view wx:for="{{mapClusterPickerItems}}" wx:key="publicLeadId" class="map-cluster-picker-row" data-lead-id="{{item.publicLeadId}}" catchtap="onSelectMapClusterPickerItem" role="button" aria-label="{{item.displayIpTheme}}，剩余{{item.totalRemainingLabel}}抽{{item.primaryDiscoveryTag ? '，' + item.primaryDiscoveryTag : ''}}">
          <image wx:if="{{item.markerIconPath}}" class="map-cluster-picker-image" src="{{item.markerIconPath}}" mode="aspectFit" style="width: {{mapClusterPickerImageWidth}}px;" aria-hidden="true" />
          <view wx:else class="map-cluster-picker-placeholder"><view class="map-cluster-picker-placeholder-head"><text class="map-cluster-picker-placeholder-title">{{item.totalRemainingLabel}} · {{item.displayIpTheme}}</text><view class="map-cluster-picker-placeholder-tags"><text wx:for="{{item.statusTags}}" wx:key="label" wx:for-item="tag" class="map-cluster-picker-placeholder-tag map-cluster-picker-placeholder-tag--{{tag.tone}}">{{tag.label}}</text></view></view><view class="map-cluster-picker-placeholder-meta"><text class="map-cluster-picker-placeholder-note">{{item.pickerNotePreview}}</text><text class="map-cluster-picker-placeholder-time">{{item.pickerUploadedAtLabel}}</text></view></view>
        </view>
      </scroll-view>
    </view>
    <template is="map-detail-card" data="{{mapCardPhase: mapCardPhase, mapSheetMode: mapSheetMode, mapDetailPhase: mapDetailPhase, mapDetail: mapDetail, mapDetailPreview: mapDetailPreview, mapReportActive: mapReportActive, mapReportBusy: mapReportBusy, mapContributorAvatarFailed: mapContributorAvatarFailed, mapDetailErrorMessage: mapDetailErrorMessage, topSafePx: topSafePx}}" />
  </view>

  <view wx:if="{{modalView !== 'share-capture'}}" class="bottom-nav light-capsule" data-testid="bottom-nav">
    <view class="nav-item {{activeTab === 'recognize' ? 'nav-item--active' : ''}}" data-tab="recognize" bindtap="onSelectTab" role="button" aria-label="识别" aria-current="{{activeTab === 'recognize'}}"><image class="icon icon--nav" src="{{activeTab === 'recognize' ? '/assets/icons/corners-out-white.svg' : '/assets/icons/corners-out-gray.svg'}}" mode="aspectFit" aria-hidden="true" /><text wx:if="{{activeTab === 'recognize'}}" class="nav-label">识别</text></view>
    <view class="nav-item {{activeTab === 'map' ? 'nav-item--active' : ''}}" data-tab="map" bindtap="onSelectTab" role="button" aria-label="地图" aria-current="{{activeTab === 'map'}}"><image class="icon icon--nav" src="{{activeTab === 'map' ? '/assets/icons/map-pin-white.svg' : '/assets/icons/map-pin-gray.svg'}}" mode="aspectFit" aria-hidden="true" /><text wx:if="{{activeTab === 'map'}}" class="nav-label">地图</text></view>
    <view class="nav-item {{activeTab === 'my' ? 'nav-item--active' : ''}}" data-tab="my" bindtap="onSelectTab" role="button" aria-label="我的" aria-current="{{activeTab === 'my'}}"><image class="icon icon--nav" src="{{activeTab === 'my' ? '/assets/icons/user-circle-white.svg' : '/assets/icons/user-circle-gray.svg'}}" mode="aspectFit" aria-hidden="true" /><text wx:if="{{activeTab === 'my'}}" class="nav-label">我的</text></view>
  </view>
  <canvas type="2d" id="marker-render-canvas" class="marker-render-canvas" aria-hidden="true"></canvas>
  <canvas type="2d" id="camera-output-canvas" class="camera-output-canvas" aria-hidden="true"></canvas>
</view>
