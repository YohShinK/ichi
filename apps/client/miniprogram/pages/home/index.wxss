  font-weight: 900;
}

.camera-permission-copy {
  margin-top: 8px;
  color: rgba(255, 255, 255, 0.7);
  font-size: 12px;
  font-weight: 700;
  line-height: 1.6;
}

.camera-permission-action {
  min-width: 136px;
  height: 44px;
  margin-top: 20px;
  padding: 0 24px;
  border: 1px solid rgba(255, 255, 255, 0.24);
  border-radius: 999px;
  background: #fff;
  color: #111;
  font-size: 13px;
  font-weight: 900;
  line-height: 44px;
}

.camera-controls {
  position: absolute;
  right: 0;
  bottom: calc(var(--bottom-nav-offset) + var(--bottom-nav-height) + 2px);
  left: 0;
  z-index: 100;
  display: grid;
  grid-template-columns: 52px minmax(0, 1fr) 52px;
  height: 100px;
  padding: 10px 32px;
  align-items: center;
  border-radius: 0;
  background: linear-gradient(180deg, #d9dce1 0%, #fff 46%, #f1f2f4 72%, #d9dce1 100%);
}

.camera-side {
  display: flex;
  width: 52px !important;
  height: 52px !important;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f0f2f5;
  box-shadow: none;
  color: #71717a;
  justify-self: center;
}

.camera-side image { width: 22px; height: 22px; }

.camera-side[disabled] {
  opacity: 0.35;
}

.camera-shutter {
  display: flex;
  width: 72px !important;
  height: 72px !important;
  padding: 3px;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 50%;
  background: linear-gradient(105deg, #e014a0, #5528c2);
  box-shadow: 0 8px 26px rgba(85, 40, 194, 0.28), 0 0 22px rgba(224, 20, 160, 0.2);
  opacity: 1;
  justify-self: center;
}

.camera-shutter--busy,
.camera-shutter[disabled] {
  opacity: 1;
}

.camera-shutter-core {
  display: flex;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: linear-gradient(180deg, #242424 0%, #0d0d0d 100%);
  box-shadow: none;
  align-items: center;
  justify-content: center;
}

.camera-shutter-core image {
  width: 28px;
  height: 28px;
}

.fullscreen-state {
  padding: 24px;
  align-items: center;
  justify-content: center;
}

.fullscreen-state {
  padding-top: var(--top-safe-px);
  padding-bottom: var(--bottom-clearance);
}

.recognizing-card {
  display: flex;
  width: 100%;
  max-width: 340px;
  padding: 40px 32px;
  align-items: center;
  flex-direction: column;
}

.recognizing-mark {
  position: relative;
  display: flex;
  width: 112px;
  height: 112px;
  margin-bottom: 28px;
  align-items: center;
  justify-content: center;
}

.recognizing-ring {
  position: absolute;
  inset: 0;
  width: 112px;
  height: 112px;
  border-radius: 50%;
}

.recognition-mascot {
  position: relative;
  z-index: 2;
  width: 72px;
  height: 64px;
}

.state-title {
  color: #111;
  font-size: 24px;
  font-weight: 900;
  line-height: 32px;
  letter-spacing: -0.5px;
}

.recognition-steps {
  display: flex;
  width: 100%;
  margin-top: 28px;
  flex-direction: column;
  gap: 18px;
}

.recognition-step {
  display: flex;
  align-items: center;
  color: #a1a1aa;
  font-size: 13px;
  font-weight: 800;
  gap: 14px;
}

.recognition-step--active,
.recognition-step--done {
  color: #111;
}

.recognition-step image,
.recognition-step-indicator {
  width: 22px;
  height: 22px;
  flex: 0 0 22px;
}

.recognition-step-indicator {
  border: 2px solid #d4d4d8;
  border-radius: 50%;
}

.recognition-step-indicator--active {
  display: flex;
  border-color: transparent;
  align-items: center;
  justify-content: center;
}

.recognition-step-indicator--active > view {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #5528c2;
  box-shadow: 0 0 0 5px rgba(85, 40, 194, 0.12), 0 0 14px rgba(85, 40, 194, 0.46);
  animation: recognition-pulse 1.6s ease-in-out infinite;
}

@keyframes recognition-pulse {
  0%, 100% { opacity: 0.48; transform: scale(0.78); box-shadow: 0 0 0 4px rgba(85, 40, 194, 0.08), 0 0 8px rgba(85, 40, 194, 0.28); }
  50% { opacity: 1; transform: scale(1); box-shadow: 0 0 0 7px rgba(85, 40, 194, 0.14), 0 0 18px rgba(85, 40, 194, 0.5); }
}

.card-copy {
  margin-top: 10px;
  color: #71717a;
  font-size: 11px;
  font-weight: 600;
  line-height: 18px;
  text-align: center;
}

/* Draw workspace fixed layers and paper-tear swiper. */
.page--draw { padding-top: calc(var(--top-safe-px) + 92px + 20px); }
.draw-prize-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.ticket-tier-letter--grand { color: #fff; }
.ticket-peel-track {
  position: absolute;
  top: 22px;
  right: 0;
  left: 0;
  z-index: 2;
  height: 52px;
  overflow: hidden;
  touch-action: none;
}
.ticket-peel-swiper {
  position: absolute;
  top: 0;
  right: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  will-change: right;
}
.ticket-peel-swiper--active {
  right: var(--ticket-peel-offset);
}
.ticket-peel-swiper--springing {
  pointer-events: none;
}
.ticket-peel-swiper--fading {
  opacity: 0;
  transition: opacity 80ms linear;
}
.ticket-peel-back {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 4;
  width: 0;
  height: 100%;
  background: linear-gradient(90deg, #2a2a2a 0%, #171717 72%, #0a0a0a 100%);
  box-shadow: 4px 5px 15px -2px rgba(0, 0, 0, 0.4);
  will-change: width;
}
.ticket-peel-swiper--active .ticket-peel-back {
  width: var(--ticket-peel-width);
}
.ticket-peel-front {
  left: 0;
  right: auto;
  width: 100%;
  will-change: left;
}
.ticket-peel-swiper--active .ticket-peel-front {
  left: var(--ticket-peel-offset);
}

.draw-quick-actions { bottom: calc(var(--bottom-clearance) + 72px); }
.draw-quick-actions button {
  width: 48px !important;
  height: 48px !important;
  border: 0;
  background: #e014a0;
  box-shadow: 0 8px 22px rgba(224, 20, 160, 0.3);
}

.draw-stop-button { position: relative; overflow: hidden; }
.hold-fill {
  position: absolute;
  inset: 0;
  background: #111;
  transform: scaleX(0);
  transform-origin: left center;
}

.draw-stop-button--holding .hold-fill { animation: hold-fill 500ms linear forwards; }
.draw-stop-button--holding .hold-content { filter: invert(1); }
@keyframes hold-fill { to { transform: scaleX(1); } }
.hold-content { position: relative; z-index: 2; display: flex; align-items: center; gap: 8px; }

.draw-toast {
  position: fixed;
  top: calc(var(--top-safe-px) + 46px);
  left: 50%;
  z-index: 90;
  display: flex;
  width: calc(100% - 48px);
  max-width: 360px;
  height: 62px;
  padding: 8px 10px;
  align-items: center;
  border: 1px solid rgba(0, 0, 0, 0.06);
  border-radius: 24px;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.16);
  transform: translate(-50%, -50%);
  animation: toast-enter 260ms cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes toast-enter { from { opacity: 0; transform: translate(-50%, -50%) translateY(-12px) scale(0.94); } }

.draw-edge-fade {
  position: fixed;
  right: 0;
  left: 0;
  display: block;
  pointer-events: none;
}

.draw-edge-fade--top {
  top: 0;
  z-index: 64;
  height: calc(var(--top-safe-px) + 92px);
  background: linear-gradient(to bottom, #f0f2f5 0, rgba(240, 242, 245, 0.96) 52%, rgba(240, 242, 245, 0.72) 76%, rgba(240, 242, 245, 0) 100%);
}

.draw-edge-fade--bottom {
  top: calc(100vh - var(--bottom-nav-offset) - var(--bottom-nav-height));
  z-index: 49;
  height: calc(var(--bottom-nav-height) + var(--bottom-nav-offset));
  background: linear-gradient(to bottom, rgba(240, 242, 245, 0), rgba(240, 242, 245, 0.92) 72%, #f0f2f5 100%);
}

.toast-mascot { display: flex; width: 48px; height: 48px; flex: 0 0 48px; align-items: center; justify-content: center; }
.toast-mascot image { width: 40px; height: 34px; transform: rotate(-3deg); transform-origin: center; }
.toast-face { position: relative; display: flex; width: 40px; height: 32px; align-items: center; justify-content: center; border-radius: 10px; background: #111; gap: 7px; transform: rotate(-3deg); transform-origin: center; }
.toast-face view { width: 6px; height: 6px; border-radius: 50%; background: #fff; }
.toast-copy { display: flex; min-width: 0; flex: 1 1 auto; flex-direction: column; }
.toast-copy > text:first-child { font-size: 13px; font-weight: 800; }
.toast-copy > text:first-child text { color: #e014a0; font-weight: 900; }
.toast-copy > text:last-child { overflow: hidden; margin-top: 2px; color: #71717a; font-size: 9px; font-weight: 700; white-space: nowrap; text-overflow: ellipsis; }
.toast-remaining { display: flex; height: 40px; padding: 0 13px; flex: 0 0 auto; align-items: center; border-radius: 999px; background: #111; color: #fff; gap: 5px; }
.toast-remaining text:first-child { color: #a1a1aa; font-size: 8px; }
.toast-remaining text:last-child { font-size: 14px; font-weight: 900; }

/* My-area secondary pages. */
.subpage-copy { display: none; }
.account-card { display: flex; padding: 28px 24px; align-items: center; flex-direction: column; }
.account-profile-nickname {
  width: 100%;
  height: 44px;
  padding: 0 14px;
  border: 1px solid rgba(17, 17, 17, .12);
  border-radius: 12px;
  background: #fff;
  color: #111;
  font-size: 14px;
}
.account-ichi-id { margin-top: 5px; color: #71717a; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace; font-size: 12px; font-weight: 800; letter-spacing: 1px; }
.account-quota { display: flex; width: 100%; margin-top: 18px; padding: 12px 16px; align-items: center; justify-content: space-between; border-radius: 999px; background: #f0f2f5; color: #111; font-size: 10px; font-weight: 800; }
.account-quota text:last-child { font-size: 12px; font-weight: 900; }
.round-symbol { display: flex; width: 72px; height: 72px; margin: 0 auto 18px; align-items: center; justify-content: center; border-radius: 50%; background: #f0f2f5; box-shadow: inset 0 3px 10px rgba(0,0,0,.06); }
.round-symbol image { width: 34px; height: 34px; }
.round-symbol--warning image { width: 40px; height: 40px; }
.round-symbol--dark { background: #111; box-shadow: 0 12px 24px rgba(0,0,0,.2); }
.round-symbol--exception {
  width: var(--exception-icon-size);
  height: var(--exception-icon-size);
  background: #111;
  box-shadow: 0 12px 24px rgba(0,0,0,.2);
}
.round-symbol--exception image { width: var(--exception-icon-glyph-size); height: var(--exception-icon-glyph-size); }
.card-title { color: #111; font-size: 17px; font-weight: 900; }
.disabled-button { margin-top: 20px; opacity: .56; }
.storage-fallback-link { width: 100% !important; margin-top: 14px; }
.disabled-button image { width: 18px; height: 18px; margin-right: 8px; }
.storage-meter { display: flex; width: 100%; margin-top: 18px; flex-direction: column; gap: 6px; color: #71717a; font-size: 9px; font-weight: 800; text-align: left; }
.storage-meter > view { overflow: hidden; width: 100%; height: 6px; border-radius: 999px; background: #e9ebef; }
.storage-meter > view > view { height: 100%; border-radius: inherit; background: #111; }
.storage-meter--warning { color: #e014a0; }
.storage-meter--warning > view > view { background: #e014a0; }
.subpage-actions { display: flex; margin-top: 18px; gap: 12px; }
.subpage-actions button { flex: 1 1 0; }
.inline-action { position: relative; width: auto !important; max-width: none !important; }
.method-scroll { padding-bottom: 12px; }
.subpage-wide-action { width: 100% !important; margin-top: 8px; }
.method-actions { padding-bottom: 24px; }
.method-card { display: flex; margin-bottom: 12px; padding: 20px; align-items: flex-start; gap: 12px; }
.method-card > image { width: 20px; height: 20px; flex: 0 0 20px; }
.method-card > view { display: flex; flex-direction: column; }
.method-card > view > text:first-child { margin-bottom: 6px; font-size: 13px; font-weight: 900; }
.method-card > view > text:last-child { color: #71717a; font-size: 11px; font-weight: 600; line-height: 18px; }
.unofficial-note { display: block; padding: 8px 18px 24px; color: #a1a1aa; font-size: 9px; font-weight: 700; line-height: 15px; text-align: center; }
.danger-action { display: flex; width: 100% !important; height: 52px; align-items: center; justify-content: center; border-radius: 999px; background: rgba(224, 20, 160, .08); color: #e014a0; font-size: 12px; font-weight: 900; gap: 8px; }
.danger-action image { width: 18px; height: 18px; }
.contribution-note { margin-top: -2px; color: #a1a1aa; font-size: 9px; font-weight: 700; }
.contribution-card { padding-top: 16px; padding-bottom: 16px; }
.contribution-card--action { min-height: 116px; padding-bottom: 54px; }
.record-row-card .record-state-badge,
.cloud-record-card .record-state-badge,
.contribution-card .record-state-badge {
  position: absolute;
  top: 16px;
  right: 16px;
  z-index: 2;
}
.contribution-card .draft-copy {
  min-width: 0;
  padding-right: 76px;
}
.record-verification-action {
  position: absolute;
  right: 16px;
  bottom: 14px;
  z-index: 2;
  width: auto;
  min-width: 104px;
  height: 36px;
  margin: 0;
  padding: 0 18px;
  border: 0;
  border-radius: 999px;
  background: #111;
  color: #fff;
  font-size: 11px;
  font-weight: 900;
  line-height: 36px;
}
.record-verification-action::after { border: 0; }
.contribution-footer { display: flex; min-height: 18px; align-items: center; justify-content: space-between; gap: 12px; }
.state-page { overflow-y: auto; }
.state-card { display: flex; margin-top: 40px; padding: 40px; align-items: center; flex-direction: column; text-align: center; }
.state-card--hero { border-radius: var(--hero-radius); }
.exception-card { padding-top: var(--exception-card-padding-y); padding-bottom: var(--exception-card-padding-y); align-items: center; text-align: center; }
.exception-card .round-symbol--exception { width: var(--exception-icon-size); height: var(--exception-icon-size); margin: 0 0 var(--exception-icon-title-gap); flex: 0 0 var(--exception-icon-size); }
.exception-card .card-copy { max-width: 290px; margin-top: var(--exception-title-copy-gap); }
.exception-card .state-actions { max-width: var(--exception-action-max-width); margin-top: var(--exception-copy-actions-gap); gap: var(--exception-action-gap); }
.exception-card .state-actions .action-button { width: 100% !important; max-width: none !important; }
.state-actions { display: flex; width: 100%; margin-top: 28px; flex-direction: column; gap: 12px; }
.state-actions .action-wrap { align-self: center; }
.state-actions > .ghost-button { width: 100%; }

/* Blocking visual-center modals. */
.modal-layer {
  position: fixed;
  inset: 0;
  z-index: 300;
  display: flex;
  padding: 20px;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.42);
}

.modal-card {
  position: absolute;
  top: calc(50vh - 32px);
  left: 50%;
  display: flex;
  width: calc(100% - 32px);
  max-width: 340px;
  height: 420px;
  max-height: calc(100vh - var(--top-safe-px) - var(--bottom-clearance) - 24px);
  min-height: 0;
  padding: 24px;
  flex-direction: column;
  overflow: hidden;
  transform: translate(-50%, -50%);
  animation: modal-enter 260ms cubic-bezier(0.34, 1.56, 0.64, 1);
}

.profile-edit-card {
  top: 50vh;
  height: auto;
  max-width: 332px;
  padding: 28px 24px 30px;
  align-items: center;
  overflow: visible;
  text-align: center;
}

.profile-edit-back {
  position: absolute;
  top: 18px;
  left: 18px;
  z-index: 2;
  display: flex;
  width: 40px !important;
  height: 40px !important;
  padding: 0;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f0f2f5;
}

.profile-edit-back::after { border: 0; }
.profile-edit-back image { width: 18px; height: 18px; }

.profile-edit-avatar {
  display: block;
  overflow: hidden;
  width: 76px !important;
  height: 76px !important;
  margin: 0 0 18px;
  padding: 0;
  border: 4px solid #fff;
  border-radius: 50%;
  background: #f0f2f5;
  box-shadow: 0 8px 24px rgba(17, 17, 17, 0.12);
}

.profile-edit-avatar::after {
  border: 0;
}

.profile-edit-avatar image {
  display: block;
  width: 100%;
  height: 100%;
}

.profile-edit-card .card-copy {
  max-width: 252px;
  margin: 10px auto 18px;
}

.profile-edit-card .account-profile-nickname {
  margin-bottom: 18px;
  background: #f0f2f5;
  text-align: center;
}

.profile-edit-card .action-button[disabled] {
  background: #dfe2e7;
  color: #9a9da6;
  box-shadow: none;
}

@keyframes modal-enter { from { opacity: 0; transform: translate(-50%, -50%) translateY(12px) scale(.92); } }
.modal-layer--share-decision .modal-card { top: calc(50vh - 8px); }
.modal-head { display: flex; width: 100%; min-height: var(--modal-header-height); margin-bottom: 18px; padding-right: calc(var(--modal-header-height) + 12px); flex: 0 0 var(--modal-header-height); align-items: center; justify-content: flex-start; }
.modal-head > text { min-width: 0; font-size: 22px; font-weight: 900; line-height: 32px; }
.modal-head button { position: absolute; top: 24px; right: 24px; z-index: 1; width: var(--modal-header-height) !important; height: var(--modal-header-height) !important; margin: 0; flex: none; }
.modal-card--note-review {
  top: 50vh;
  width: calc(100% - 48px);
  max-width: 316px;
  height: auto;
  min-height: 0;
  padding: 24px 22px 28px;
  overflow: visible;
}
.modal-card--note-review .modal-head { margin-bottom: 16px; }
.modal-card--note-review .modal-head button { top: 24px; right: 22px; }
.note-review-input {
  width: calc(100% - 8px);
  max-width: 264px;
  margin: 0 auto;
  box-sizing: border-box;
  text-align: left;
}
.note-review-copy {
  display: block;
  width: calc(100% - 8px);
  max-width: 264px;
  margin: 10px auto 0;
  text-align: center;
}
.note-review-actions { margin: 24px auto 0; }
.note-review-actions .action-button {
  width: 100% !important;
  max-width: 100% !important;
}
.modal-scroll { min-height: 0; flex: 1 1 auto; }
.outlook-window { display: block; margin-bottom: 12px; color: #71717a; font-size: 9px; font-weight: 900; letter-spacing: 1px; }
.outlook-event { display: flex; min-height: 50px; margin-bottom: 8px; padding: 11px 13px; align-items: center; justify-content: space-between; gap: 10px; border-radius: 17px; background: #f0f2f5; }
.outlook-event text:first-child { color: #3f3f46; font-size: 11px; font-weight: 800; }
.outlook-event text:last-child { color: #111; font-size: 17px; font-weight: 900; }
.outlook-cost { display: flex; padding: 10px 13px; align-items: center; justify-content: space-between; border-top: 1px solid rgba(17,17,17,.08); color: #71717a; font-size: 10px; font-weight: 800; }
.modal-disclaimer { margin-top: 14px; color: #a1a1aa; font-size: 9px; font-weight: 900; text-align: center; letter-spacing: 1px; }
.history-list { display: flex; flex-direction: column; gap: 12px; }
.history-row { display: flex; min-height: 48px; padding: 12px 0; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(0,0,0,.05); background: transparent; }
.history-row:last-child { border-bottom: 0; }
.history-row-main { display: flex; min-width: 0; align-items: center; gap: 16px; }
.history-index { color: #a1a1aa; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; font-weight: 700; }
.history-tier { color: #111; font-size: 16px; font-weight: 900; }
.history-row-meta { display: flex; flex: none; flex-direction: column; align-items: flex-end; justify-content: center; }
.history-remaining { color: #a1a1aa; font-size: 10px; font-weight: 700; }
.history-cost { color: #e014a0; font-size: 14px; font-weight: 900; }
.share-card { align-items: center; text-align: center; }
.share-actions { display: flex; width: 100%; margin-top: 28px; flex-direction: column; gap: 12px; }
.share-actions .action-wrap { align-self: center; }
.text-button { width: auto !important; align-self: center; background: transparent; color: #71717a; font-size: 11px; font-weight: 800; text-decoration: underline; }

.share-capture {
  z-index: 310;
  padding: var(--top-safe-px) 16px calc(var(--bottom-clearance) + 16px);
  flex-direction: column;
  overflow: hidden;
}

.share-back { position: absolute; top: var(--top-safe-px); left: 16px; z-index: 2; }
.share-frame { display: flex; width: 100%; height: min(48vh, 340px); min-height: 220px; margin-top: 64px; align-items: center; justify-content: center; overflow: hidden; border: 2px dashed #b8bbc2; border-radius: 32px; background: #fff; }
.share-evidence-photo,
.share-camera-preview { display: block; width: 100%; height: 100%; border-radius: 30px; background: #111; }
.camera-permission-panel--share { color: #111; }
.camera-permission-panel--share .camera-permission-copy { color: #71717a; }
.camera-permission-panel--share .camera-permission-action { border-color: #111; background: #111; color: #fff; }
.capture-actions { display: grid; width: 100%; min-height: 52px; margin: 16px 0; align-items: center; justify-content: center; grid-template-columns: 52px minmax(160px, 212px) 52px; gap: 12px; }
.capture-action-spacer { width: 52px; height: 52px; }
.capture-button { display: flex; width: 100% !important; height: 52px; padding: 0 24px; align-items: center; justify-content: center; border-radius: 999px; background: #0f0f10; color: #fff; font-size: 15px; font-weight: 900; line-height: 1; text-align: center; box-shadow: none; }
.capture-button[disabled] { opacity: 1; }
.capture-undo[disabled] { opacity: .42; }
.share-meta { display: flex; flex-direction: column; gap: 8px; }
.share-meta > text { margin-left: 4px; color: #71717a; font-size: 9px; font-weight: 900; letter-spacing: 1px; }
.share-meta > view { display: grid; grid-template-columns: minmax(0,1fr) 52px; gap: 10px; }
.share-meta input { height: 52px; padding: 0 16px; border: 1px solid rgba(0,0,0,.05); border-radius: 16px; background: #fff; color: #111; font-size: 12px; font-weight: 800; }
.share-confirm { display: flex; width: 52px !important; height: 52px; align-items: center; justify-content: center; border-radius: 50%; background: #e9ebef; opacity: 1; }
.share-confirm image { width: 20px; height: 20px; opacity: .3; }
.share-confirm--ready { background: #111; box-shadow: 0 0 0 3px rgba(224,20,160,.2), -5px 0 18px rgba(224,20,160,.68), 6px 0 20px rgba(85,40,194,.72); }
.share-confirm--ready image { opacity: 1; }
.share-confirm--submitting[disabled] { background: #111 !important; opacity: 1; }
.share-confirm-spinner { width: 18px; height: 18px; box-sizing: border-box; border: 2px solid rgba(255,255,255,.35); border-top-color: #fff; border-radius: 50%; animation: share-confirm-spin .72s linear infinite; }
@keyframes share-confirm-spin { to { transform: rotate(360deg); } }
.share-consent { margin-top: 12px; color: #a1a1aa; font-size: 9px; font-weight: 800; text-align: center; }
.modal-card--submitted { display: flex; width: 100%; max-width: 340px; height: auto; min-height: 0; padding: 28px 24px; overflow: visible; flex-direction: column; align-items: center; text-align: center; }
.modal-card--exception { height: auto; min-height: 0; padding: var(--exception-card-padding-y) 40px; overflow: visible; border-radius: var(--hero-radius); }
.submitted-actions { margin-top: 24px; gap: 16px; }
.submitted-actions--single { gap: 0; }
.modal-layer--submitted .round-symbol { margin: 0 0 16px; flex: 0 0 72px; }
.modal-layer--submitted .state-title { display: block; width: 100%; margin: 0; }
.modal-layer--submitted .card-copy { display: block; width: 100%; max-width: 272px; margin: 12px 0 0; line-height: 20px; }
.modal-layer--submitted .submitted-actions .action-wrap { width: 100%; max-width: none; margin: 0; align-self: stretch; }
.contribution-note { margin-top: 0; }

@media (max-height: 760px) {
  .recognizing-card { padding-top: 30px; padding-bottom: 30px; }
  .share-frame { height: 38vh; min-height: 190px; }
}
.human-assistance-modal {
  width: min(690rpx, 92vw);
  padding: 36rpx;
}

.human-assistance-comparison {
  display: flex;
  gap: 16rpx;
  margin: 28rpx 0;
}

.human-assistance-board {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 12rpx;
  min-width: 0;
  padding: 20rpx;
  border: 2rpx solid #d9d9d9;
  border-radius: 20rpx;
}

.human-assistance-board text:last-child {
  overflow-wrap: anywhere;
  font-weight: 700;
}

.human-assistance-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.map-report-button { margin: 0; border: 0; line-height: 15px; }
.map-report-button--active { background: #e5e7eb; color: #6b7280; }
.map-report-button--active .map-info-report-icon { border-color: currentColor; color: inherit; }
