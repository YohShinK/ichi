page {
  height: 100%;
  overflow: hidden;
  background: #f0f2f5;
}

view,
text,
image,
button,
scroll-view {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  font: inherit;
}

button::after {
  border: 0;
}

.app-shell {
  --page-gutter: 16px;
  --bottom-nav-offset: env(safe-area-inset-bottom);
  --bottom-nav-height: 64px;
  --bottom-clearance: calc(var(--bottom-nav-offset) + var(--bottom-nav-height) + 20px);
  --page-max-width: 448px;
  --card-radius: 32px;
  --hero-radius: 40px;
  --action-height: 52px;
  --exception-card-padding-y: 40px;
  --exception-icon-size: 80px;
  --exception-icon-glyph-size: 36px;
  --exception-icon-title-gap: 24px;
  --exception-title-copy-gap: 10px;
  --exception-copy-actions-gap: 28px;
  --exception-action-gap: 12px;
  --exception-action-max-width: 288px;
  --modal-header-height: 40px;
  box-sizing: border-box;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #f0f2f5;
  color: #111;
  font-family: "Montserrat", -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

.page {
  box-sizing: border-box;
  width: 100%;
  max-width: var(--page-max-width);
  height: calc(100vh - var(--bottom-clearance));
  margin: 0 auto;
  padding: var(--top-safe-px) var(--page-gutter) 0;
  overflow: hidden;
}

.light-capsule {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  overflow: hidden;
  border-radius: var(--card-radius);
  background:
    radial-gradient(ellipse 150px 80px at 70% 0%, rgba(255, 180, 50, 0.08), transparent),
    linear-gradient(90deg, rgba(80, 120, 255, 0.05), transparent 30%),
    rgba(255, 255, 255, 0.98);
  box-shadow:
    0 8px 30px rgba(0, 0, 0, 0.05),
    0 2px 8px rgba(0, 0, 0, 0.03),
    inset 0 1px 2px #fff;
}

.page--start {
  display: flex;
  min-height: 0;
  flex-direction: column;
}

.import-hero {
  position: relative;
  display: flex;
  min-height: 0;
  padding: 16px 24px;
  flex: 0 0 auto;
  align-items: center;
  border-radius: var(--hero-radius);
  flex-direction: column;
  text-align: center;
}

.camera-asset {
  position: relative;
  z-index: 1;
  width: 142px;
  height: 142px;
  margin-bottom: 12px;
}

.hero-title {
  position: relative;
  z-index: 1;
  color: #111;
  font-size: 24px;
  font-weight: 900;
  line-height: 32px;
  letter-spacing: -0.5px;
}

.import-hero .hero-title {
  margin-bottom: 8px;
}

.hero-copy {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 290px;
  margin: 0;
  color: #71717a;
  font-size: 12px;
  font-weight: 500;
  line-height: 19.5px;
}

.import-hero .hero-copy {
  margin-bottom: 10px;
}

.quota-summary {
  position: absolute;
  top: 16px;
  left: 16px;
  z-index: 2;
  display: flex;
  width: 38px;
  max-width: 38px;
  margin: 0;
  align-items: center;
  justify-content: center;
  color: #111;
  gap: 8px;
}

.quota-summary--unavailable {
  color: #71717a;
}

.quota-ring {
  display: flex;
  width: 38px;
  height: 38px;
  flex: 0 0 38px;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: conic-gradient(#111 var(--quota-used), #e3e5e9 0);
}

.quota-ring > view {
  display: flex;
  width: 30px;
  height: 30px;
  align-items: baseline;
  justify-content: center;
  border-radius: 50%;
  background: #fff;
}

.quota-ring text:first-child {
  font-size: 12px;
  font-weight: 900;
  line-height: 30px;
}

.quota-ring text:last-child {
  color: #71717a;
  font-size: 8px;
  font-weight: 800;
}

.quota-copy {
  display: flex;
  align-items: flex-start;
  flex-direction: column;
}

.quota-copy text:first-child {
  font-size: 10px;
  font-weight: 900;
  line-height: 14px;
}

.quota-copy text:last-child {
  color: #71717a;
  font-size: 9px;
  font-weight: 700;
  line-height: 13px;
}

.import-actions {
  position: relative;
  z-index: 1;
  display: flex;
  width: 100%;
  max-width: 288px;
  flex-direction: column;
  gap: 12px;
}

.import-primary-button[disabled] {
  background: #111;
  color: #fff;
  opacity: 1;
}

.recognition-quota-note {
  display: block;
  max-width: 292px;
  margin-top: 12px;
  color: #71717a;
  font-size: 10px;
  font-weight: 600;
  line-height: 1.55;
  text-align: center;
}

.import-direct-button {
  width: 100% !important;
  height: var(--action-height) !important;
  gap: 8px;
}

.action-wrap {
  position: relative;
  display: flex;
  width: 100%;
  max-width: 288px;
  height: var(--action-height);
  margin: 0;
}

.action-glow {
  position: absolute;
  top: -2px;
  right: -2px;
  bottom: -2px;
  left: -2px;
  z-index: 1;
  border-radius: 99px;
  background:
    radial-gradient(circle at 8% 42%, #e014a0 0%, #e014a0 18%, transparent 40%),
    radial-gradient(circle at 92% 85%, #5528c2 0%, #5528c2 25%, transparent 50%);
  filter: blur(2px);
  opacity: 0.85;
}

.recognition-input-shell {
  position: relative;
  min-width: 0;
  border-radius: 12px;
}

.recognition-input-glow {
  position: absolute;
  top: -2px;
  right: -2px;
  bottom: -2px;
  left: -2px;
  z-index: 1;
  border-radius: inherit;
  background: linear-gradient(135deg, #e014a0 0%, #e014a0 28%, #5528c2 72%, #5528c2 100%);
  box-shadow:
    0 0 5px rgba(224, 20, 160, 0.7),
    0 0 5px rgba(85, 40, 194, 0.7);
  filter: blur(2px);
  opacity: 0;
  pointer-events: none;
  visibility: hidden;
}

.recognition-input-shell.is-required-missing > .recognition-input-glow {
  opacity: 0.85;
  visibility: visible;
}

.recognition-input-shell > input {
  position: relative;
  z-index: 2;
  width: 100%;
  box-sizing: border-box;
}

.action-button,
.ghost-button {
  display: flex;
  width: 100%;
  height: var(--action-height);
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  font-size: 16px;
  font-weight: 700;
  line-height: 24px;
}

.action-button {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 2;
  width: 288px !important;
  max-width: 288px !important;
  gap: 8px;
  background: #111;
  color: #fff;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
}

.action-button[disabled] {
  background: #27272a;
  color: rgba(255, 255, 255, 0.72);
}

.action-button:active,
.draft-card--pressed {
  transform: scale(0.98);
}

.ghost-button {
  width: auto;
  align-self: stretch;
  background: rgba(0, 0, 0, 0.05);
  color: #111;
}

.ghost-button:active {
  background: rgba(0, 0, 0, 0.1);
}

.start-drafts {
  display: flex;
  min-height: 0;
  margin-top: 16px;
  flex: 1 1 auto;
  flex-direction: column;
  overflow: hidden;
}

.drafts-header {
  display: flex;
  padding: 0 4px 10px;
  flex: 0 0 auto;
  align-items: center;
  justify-content: space-between;
  color: #71717a;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 1.2px;
}

.draft-list,
.records-scroll {
  min-height: 0;
  flex: 1 1 auto;
}

.draft-list-inner,
.records-list {
  display: flex;
  padding: 0 2px 16px;
  flex-direction: column;
  gap: 12px;
}

.swipe-row {
  position: relative;
  width: 100%;
  flex: 0 0 auto;
  overflow: hidden;
  border-radius: var(--card-radius);
  background: transparent;
}

.swipe-content {
  position: relative;
  z-index: 2;
  transition: transform 240ms cubic-bezier(0.2, 0.75, 0.2, 1);
}

.swipe-delete {
  position: absolute;
  top: 2px;
  right: 2px;
  bottom: 2px;
  z-index: 1;
  display: flex;
  width: 102px !important;
  max-width: 102px !important;
  height: auto;
  padding: 14px 14px 14px 32px;
  align-items: center;
  justify-content: center;
  border-radius: 0 30px 30px 0;
  background: #111;
  color: #fff;
  opacity: 0;
  pointer-events: none;
  transition: opacity 120ms ease;
}

.swipe-delete--visible {
  opacity: 1;
  pointer-events: auto;
}

.draft-card {
  position: relative;
  display: flex;
  width: 100%;
  min-height: 96px;
  padding: 16px 20px;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  overflow: hidden;
  color: #111;
  text-align: left;
}

.draft-watermark {
  position: absolute;
  top: -30px;
  right: 2px;
  z-index: 0;
  display: block;
  width: 180px;
  height: 143px;
  opacity: 0.432;
  pointer-events: none;
  filter: drop-shadow(0 4px 10px rgba(17, 17, 17, 0.08));
  transform: rotate(-40deg);
  transform-origin: center;
}

.draft-copy {
  display: flex;
  min-width: 0;
  flex: 1 1 auto;
  flex-direction: column;
  gap: 6px;
  position: relative;
  z-index: 1;
}

.draft-title {
  display: block;
  min-width: 0;
  overflow: hidden;
  font-size: 15px;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.draft-meta {
  color: #71717a;
  font-size: 10px;
  font-weight: 700;
  line-height: 1.45;
}

.draft-resume {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 4px;
  font-size: 11px;
  font-weight: 900;
  position: relative;
  z-index: 1;
}

.draft-statuses {
  display: flex;
  gap: 6px;
}

.record-row-card .draft-copy,
.contribution-card .draft-copy,
.cloud-record-card .draft-copy {
  padding-right: 72px;
}

.record-row-card .draft-statuses,
.contribution-card .draft-statuses,
.cloud-record-card .draft-statuses {
  position: absolute;
  top: 0;
  right: 0;
}

.status-pill {
  padding: 2px 8px;
  border-radius: 999px;
  background: #e9ebef;
  color: #71717a;
  font-size: 9px;
  font-weight: 700;
}

.status-pill--dark {
  background: #111;
  color: #fff;
}

.status-pill--uploaded {
  background: #e014a0;
  color: #fff;
}

.status-action {
  width: auto;
  min-width: 0;
  margin: 0;
  padding: 2px 8px;
  border: 0;
  border-radius: 999px;
  background: #f0f0f2;
  color: #111;
  font-size: 9px;
  font-weight: 800;
  line-height: 1.4;
}

.status-action::after {
  border: 0;
}


.page--draw {
  position: relative;
  display: flex;
  min-height: 0;
  padding-top: calc(var(--top-safe-px) + 92px + 20px);
  flex-direction: column;
}

.draw-status {
  position: fixed;
  top: var(--top-safe-px);
  left: 50%;
  z-index: 65;
  display: flex;
  width: calc(100% - 32px);
  max-width: 416px;
  height: 92px;
  padding: 10px 24px;
  align-items: center;
  justify-content: space-between;
  transform: translateX(-50%);
}

.draw-status-remaining,
.draw-status-buyout {
  display: flex;
  flex-direction: column;
}

.draw-status-buyout {
  align-items: flex-end;
}

.draw-status-kicker {
  margin-bottom: 2px;
  color: #a1a1aa;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.5px;
}

.draw-ip {
  display: block;
  max-width: 164px;
  margin-bottom: 1px;
  overflow: hidden;
  color: #a1a1aa;
  font-size: 9px;
  font-weight: 700;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.draw-status-number {
  display: flex;
  align-items: baseline;
  gap: 4px;
}

.draw-status-number > text:first-child {
  font-size: 36px;
  font-weight: 900;
  line-height: 1;
  letter-spacing: -2px;
}

.draw-status-number--compact > text:first-child {
  font-size: 32px;
  letter-spacing: -1.5px;
}

.draw-status-number > text:last-child,
.draw-buyout-number > text:last-child {
  color: #a1a1aa;
  font-size: 12px;
  font-weight: 700;
}

.draw-status-divider {
  width: 1px;
  height: 52px;
  background: #e4e4e7;
}

.draw-unit-price {
  margin-bottom: 4px;
  color: #a1a1aa;
  font-size: 9px;
  font-weight: 700;
}

.draw-last-label {
  margin-bottom: 2px;
  padding: 2px 8px;
  border-radius: 2px;
  background: rgba(224, 20, 160, 0.1);
  color: #e014a0;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 1px;
}

.draw-buyout-number {
  display: flex;
  align-items: baseline;
  gap: 2px;
}

.draw-buyout-number > text:first-child {
  font-size: 20px;
  font-weight: 900;
  line-height: 1;
}

.draw-scroll {
  width: 100%;
  min-height: 0;
  flex: 1 1 auto;
}

.draw-content {
  display: flex;
  padding: 0 var(--page-gutter) 168px;
  flex-direction: column;
  gap: 32px;
}

.draw-section-title {
  display: flex;
  margin: 0 0 16px 4px;
  align-items: center;
  gap: 8px;
  color: #111;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 1.4px;
}

.draw-section-title--grand {
  color: #e014a0;
}

.draw-prize-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.prize-ticket {
  position: relative;
  width: 100%;
  min-width: 0;
  padding-right: 8px;
  filter: drop-shadow(0 2px 3px rgba(0, 0, 0, 0.08));
}

.prize-ticket--empty {
  filter: grayscale(1);
  opacity: 0.5;
}

.ticket-shell {
  overflow: hidden;
  width: 100%;
  border: 1px solid rgba(0, 0, 0, 0.05);
  border-radius: 12px 4px 4px 12px;
  background: #fff;
}

.ticket-top,
.ticket-bottom {
  display: flex;
  padding: 0 12px;
  align-items: center;
  justify-content: space-between;
}

.ticket-top {
  height: 22px;
  padding: 0 8px;
  background: #1e223b;
  color: #fff;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 1px;
}

.ticket-probability {
  color: #56f2d8;
  font-size: 8px;
}

.ticket-opened {
  display: flex;
  height: 52px;
  align-items: center;
  justify-content: center;
  background: #f0f2f5;
  box-shadow: inset 0 2px 5px rgba(0, 0, 0, 0.04);
}

.ticket-opened text {
  color: #d4d4d8;
  font-size: 16px;
  font-style: italic;
  font-weight: 900;
  letter-spacing: 2px;
}

.ticket-bottom {
  min-height: 38px;
  padding: 6px 8px;
  background: #d2d6d3;
}

.ticket-bottom--normal {
  min-height: 56px;
}

.ticket-left {
  color: #1e223b;
  font-size: 8px;
  font-weight: 900;
  letter-spacing: 0.7px;
}

.ticket-left text {
  margin-left: 4px;
  font-size: 12px;
}

.ticket-slots {
  display: flex;
  padding-left: 6px;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 4px;
}

.ticket-slots--normal {
  min-height: 44px;
  align-content: flex-start;
}

.ticket-slot {
  display: flex;
  width: 12px;
  height: 12px;
  align-items: center;
  justify-content: center;
  border: 1px solid #56f2d8;
  border-radius: 50%;
  background: #56f2d8;
  box-shadow: 0 0 6px rgba(86, 242, 216, 0.6);
}

.ticket-slot--drawn {
  border-color: rgba(30, 34, 59, 0.3);
  background: transparent;
  box-shadow: none;
  color: rgba(30, 34, 59, 0.5);
  font-size: 9px;
  opacity: 0.6;
}

.ticket-cover {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  z-index: 2;
  display: flex;
  height: 52px;
  padding: 0 12px 0 8px;
  align-items: center;
  justify-content: space-between;
  background: #0a0a0a;
  clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 25%, 100% 75%, calc(100% - 10px) 100%, 0 100%);
}

.ticket-cover-accent {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 3px;
  background: #56f2d8;
}

.ticket-tier {
  display: flex;
  margin-left: 5px;
  align-items: baseline;
  gap: 3px;
}

.ticket-tier-letter {
  color: #fff;
  font-size: 28px;
  font-weight: 900;
  line-height: 1;
  letter-spacing: -1px;
}

.ticket-tier-letter--grand {
  color: #e5cb8d;
}

.ticket-tier-suffix {
  color: #a1a1aa;
  font-size: 11px;
  font-weight: 700;
}

.draw-quick-actions {
  position: fixed;
  right: max(6px, calc((100vw - 448px) / 2 + 6px));
  bottom: calc(var(--bottom-clearance) + 72px);
  z-index: 66;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.draw-quick-actions button {
  display: flex;
  width: 44px !important;
  height: 44px !important;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #e014a0;
  box-shadow: 0 8px 22px rgba(224, 20, 160, 0.3);
}

.draw-stop-wrap {
  position: fixed;
  bottom: calc(var(--bottom-nav-offset) + var(--bottom-nav-height) + 12px);
  left: 50%;
  z-index: 67;
  width: min(56vw, 220px);
  max-width: 220px;
  transform: translateX(-50%);
}

.draw-stop-button {
  display: flex;
  width: 100% !important;
  height: 48px !important;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(17, 17, 17, 0.08);
  border-radius: 999px;
  background: #fff;
  color: #111;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
  font-size: 14px;
  font-weight: 900;
  gap: 8px;
}

.page--map {
  overflow-y: auto;
}

.map-hero {
  display: flex;
  padding: 40px 24px;
  align-items: center;
  border-radius: var(--hero-radius);
  flex-direction: column;
  text-align: center;
}

.map-watermark {
  position: absolute;
  inset: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
  opacity: 0.36;
}

.map-hero .hero-title {
  position: relative;
  z-index: 1;
  margin-bottom: 12px;
}

.map-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #111;
  box-shadow:
    0 20px 25px -5px rgba(0, 0, 0, 0.1),
    0 8px 10px -6px rgba(0, 0, 0, 0.1);
}

.map-mark {
  position: relative;
  z-index: 1;
  width: 96px;
  height: 96px;
  margin-bottom: 24px;
}

.map-copy {
  position: relative;
  z-index: 1;
  margin: 0 auto;
}

.map-actions {
  position: relative;
  z-index: 1;
  display: flex;
  width: 100%;
  max-width: 288px;
  margin-top: 24px;
  flex-direction: column;
  gap: 16px;
}

.map-actions .action-wrap {
  margin-top: 0;
}

.map-actions > .ghost-button {
  width: 288px !important;
  max-width: 288px !important;
}

.page--my {
  display: flex;
  overflow-y: auto;
  align-items: stretch;
  flex-direction: column;
}

.profile {
  display: grid;
  width: 100%;
  margin: 0 0 16px;
  align-self: flex-start;
  align-items: center;
  justify-content: stretch;
  grid-template-columns: 80px minmax(0, 1fr);
  column-gap: 16px;
}

.profile-avatar,
button.profile-avatar {
  display: block;
  overflow: hidden;
  width: 80px !important;
  height: 80px !important;
  margin-right: 0 !important;
  margin-left: 0 !important;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: #fff;
  justify-self: start;
  line-height: 1;
}

.profile-avatar::after {
  border: 0;
}

.profile-avatar-image {
  display: block;
  width: 100%;
  height: 100%;
}

.profile-copy {
  display: flex;
  width: 100%;
  min-width: 0;
  margin: 0;
  padding: 0;
  align-items: flex-start;
  justify-self: start;
  flex-direction: column;
  text-align: left;
}

.profile-copy--interactive {
  cursor: pointer;
}

.profile-title {
  font-size: 24px;
  font-weight: 900;
  line-height: 32px;
}

.profile-id {
  margin-top: 4px;
  color: #71717a;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
  font-size: 11px;
  font-weight: 700;
  line-height: 16.5px;
  letter-spacing: 1.1px;
}

.profile-mode {
  width: fit-content;
  margin-top: 8px;
  padding: 2px 8px;
  border-radius: 999px;
  background: #111;
  color: #fff;
  font-size: 9px;
  font-weight: 700;
  line-height: 13.5px;
}

.menu-card {
  display: flex;
  margin-bottom: 12px;
  padding: 6px;
  flex-direction: column;
}

.menu-row {
  display: flex;
  min-height: 55px;
  padding: 10px 12px;
  align-items: center;
  border-radius: 24px;
  background: #fff;
}

.menu-row:active {
  background: #f0f2f5;
}

.menu-icon {
  display: flex;
  width: 40px;
  height: 40px;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f0f2f5;
  color: #71717a;
  font-size: 11px;
  font-weight: 900;
}

.menu-icon--dark {
  background: #111;
  color: #fff;
}

.menu-icon--accent {
  color: #e014a0;
}

.menu-label {
  margin-left: 16px;
  flex: 1 1 auto;
  font-size: 14px;
  font-weight: 900;
}

.page--records {
  display: flex;
  min-height: 0;
  flex-direction: column;
}

.subpage-header {
  display: flex;
  width: 100%;
  height: 52px;
  flex: 0 0 52px;
  align-items: center;
  justify-content: flex-start;
  gap: 12px;
  margin-bottom: 12px;
}

.back-button {
  display: flex;
  width: 52px !important;
  height: 52px !important;
  margin: 0 !important;
  flex: 0 0 52px;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #e9ebef;
  color: #71717a;
  font-size: 24px;
}

.subpage-title {
  min-width: 0;
  margin: 0;
  color: #111;
  font-size: 24px;
  font-weight: 900;
}

.record-summary {
  display: flex;
  min-height: 35px;
  margin-bottom: 16px;
  padding: 9px 14px;
  flex: 0 0 auto;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.78);
  color: #71717a;
  font-size: 10px;
  font-weight: 800;
  line-height: 1.4;
  white-space: nowrap;
}

.records-scroll {
  min-height: 0;
}

.records-list {
  padding-top: 2px;
}

.records-refresh-surface {
  display: flex;
  min-height: calc(100vh - var(--top-safe-px) - var(--bottom-clearance) - 114px);
  flex-direction: column;
}

.record-card {
  position: relative;
  display: flex;
  min-height: 0;
  padding: 14px 16px;
  flex-direction: column;
  gap: 7px;
  overflow: hidden;
  border-left: 4px solid #111;
}

.record-card-head,
.record-card > .record-identity-meta,
.record-card > .record-card-meta,
.record-card > .record-stats-row,
.record-card > .contribution-footer {
  position: relative;
  z-index: 1;
}

.record-card[data-upload-status="uploaded"] {
  border-left-color: #e014a0;
}

.record-card-head {
  display: flex;
  min-width: 0;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
}

.record-head-status {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 5px;
}

.record-card-title {
  display: block;
  min-width: 0;
  overflow: hidden;
  flex: 1 1 auto;
  color: #111;
  font-size: 15px;
  font-weight: 900;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-card-time {
  flex: 0 0 auto;
  color: #a1a1aa;
  font-size: 9px;
  font-weight: 800;
}

.record-status {
  display: inline-flex;
  width: fit-content;
  padding: 4px 9px;
  align-items: center;
  border-radius: 999px;
  background: #f0f2f5;
  color: #52525b;
  font-size: 9px;
  font-weight: 900;
  line-height: 1;
}

.record-card[data-upload-status="uploaded"] .record-status {
  background: #111;
  color: #fff;
}

.record-card-meta {
  color: #71717a;
  font-size: 10px;
  font-weight: 700;
  line-height: 1.45;
}

.record-identity-meta {
  display: block;
  overflow: hidden;
  color: #71717a;
  font-size: 9px;
  font-weight: 700;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-stats-row {
  display: flex;
  min-height: 18px;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.record-card-actions {
  display: flex;
  min-height: 18px;
  padding-top: 0;
  align-items: center;
  justify-content: flex-start;
  gap: 12px;
}

.record-resume {
  width: auto !important;
  min-width: 0 !important;
  height: auto !important;
  margin: 0 !important;
  padding: 0 !important;
  border-bottom: 1px dashed #111;
  background: transparent;
  color: #111;
  font-size: 10px;
  font-weight: 900;
  line-height: 16px;
}

.cloud-record-delete {
  position: relative;
  z-index: 2;
  display: flex;
  width: 42px !important;
  min-width: 42px;
  height: 42px;
  margin: 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #111;
}

.cloud-record-delete image { width: 18px; height: 18px; }

.cloud-record-delete::after {
  border: 0;
}

.records-empty {
  display: flex;
  margin: 2px;
  padding: 32px 24px;
  align-items: center;
  flex-direction: column;
  text-align: center;
}

.records-empty-title {
  font-size: 15px;
  font-weight: 900;
}

.records-empty-copy {
  margin-top: 8px;
  color: #71717a;
  font-size: 11px;
  line-height: 1.5;
}

.bottom-nav {
  position: fixed;
  bottom: var(--bottom-nav-offset);
  left: 50%;
  z-index: 110;
  display: flex;
  box-sizing: border-box;
  width: 80%;
  max-width: 320px;
  height: var(--bottom-nav-height);
  padding: 6px;
  align-items: center;
  gap: 4px;
  border-radius: 40px;
  box-shadow:
    0 10px 40px rgba(0, 0, 0, 0.1),
    inset 0 1px 2px #fff;
  transform: translateX(-50%);
}

.nav-item {
  display: flex;
  height: 52px;
  flex: 1 1 0;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 999px;
  color: #a1a1aa;
  gap: 6px;
  transition: flex 500ms cubic-bezier(0.34, 1.56, 0.64, 1), background 500ms ease;
}

.nav-item--active {
  flex: 1.6 1 0;
  background: #111;
  color: #fff;
  box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.5);
}

.nav-label {
  color: currentColor;
  font-size: 10px;
  font-weight: 900;
  line-height: 1;
  letter-spacing: 1px;
}

.icon {
  display: block;
  flex: 0 0 auto;
}

.icon--button {
  width: 20px;
  height: 20px;
}

.icon--nav {
  width: 20px;
  height: 20px;
}

.icon--nav-active {
  width: 23px;
  height: 23px;
}

.icon--menu {
  width: 18px;
  height: 18px;
}

.icon--caret {
  width: 18px;
  height: 18px;
}

.icon--trash {
  width: 22px;
  height: 22px;
}

.icon--back {
  width: 22px;
  height: 22px;
}

.icon--map-hero {
  width: 40px;
  height: 40px;
}

.icon--section {
  width: 14px;
  height: 14px;
}

.icon--ticket-caret {
  width: 22px;
  height: 22px;
}

.icon--quick {
  width: 20px;
  height: 20px;
}

.icon--stop {
  width: 18px;
  height: 18px;
}

@media (max-height: 700px) {
  .import-hero {
    padding-top: 16px;
    padding-bottom: 16px;
  }

  .camera-asset {
    width: 142px;
    height: 142px;
    margin-bottom: 12px;
  }

  .map-hero {
    padding-top: 40px;
    padding-bottom: 40px;
  }
}

/* V1-E flow pages: the shared safe-area and bottom-nav geometry stay identical. */
.flow-page,
.subpage {
  position: relative;
  display: flex;
  min-height: 0;
  flex-direction: column;
}

.flow-header {
  display: flex;
  height: 52px;
  margin-bottom: 0;
  flex: 0 0 52px;
  align-items: center;
  gap: 12px;
}

.flow-back,
.camera-close,
.circle-action,
.modal-head button {
  display: flex;
  width: 52px !important;
  height: 52px !important;
  flex: 0 0 52px;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #e9ebef;
}

.flow-back image,
.camera-close image,
.circle-action image,
.modal-head button image {
  width: 20px;
  height: 20px;
}

.flow-header > view {
  display: flex;
  min-width: 0;
  flex: 1 1 auto;
  flex-direction: column;
}

.flow-title {
  color: #111;
  font-size: 22px;
  font-weight: 900;
  line-height: 24px;
  letter-spacing: -0.44px;
}

.flow-copy,
.subpage-copy {
  margin-top: 2px;
  color: #71717a;
  font-size: 10px;
  font-weight: 700;
  line-height: 16px;
}

.flow-help {
  width: auto !important;
  padding: 6px 10px;
  flex: 0 0 auto;
  border-radius: 999px;
  background: rgba(224, 20, 160, 0.1);
  color: #e014a0;
  font-size: 10px;
  font-weight: 800;
}

.flow-scroll,
.method-scroll {
  min-height: 0;
  flex: 1 1 auto;
}

.flow-scroll {
  padding: 16px 2px 76px;
}

.price-field {
  display: flex;
  min-height: 62px;
  margin-bottom: 10px;
  padding: 12px 16px;
  align-items: center;
  justify-content: space-between;
  font-size: 13px;
  font-weight: 900;
}

.price-field > view {
  display: flex;
  align-items: center;
  gap: 4px;
}

.price-field input {
  width: 82px;
  height: 38px;
  border-radius: 12px;
  background: #f0f2f5;
  color: #111;
  font-size: 15px;
  font-weight: 900;
  text-align: center;
}

.recognition-input-shell--price {
  width: 82px;
  height: 38px;
}

.recognition-text-field > view {
  min-width: 0;
  flex: 1 1 auto;
  justify-content: flex-end;
}

.recognition-text-field input {
  width: 100%;
  padding: 0 12px;
  font-size: 12px;
  text-align: left;
}

.recognition-input-shell--text {
  width: 190px;
  max-width: 100%;
  height: 38px;
}

.recognition-ip-field > view {
  display: grid;
  width: 100%;
  min-width: 0;
  max-width: none;
  grid-template-columns: minmax(0, 1.15fr) auto minmax(0, 0.85fr);
  gap: 6px;
  box-sizing: border-box;
}

.recognition-ip-field {
  justify-content: flex-start;
  gap: 10px;
}

.recognition-ip-field > text {
  flex: 0 0 auto;
}

.recognition-ip-field input {
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  overflow: hidden;
}

.recognition-ip-divider {
  color: #71717a;
  font-size: 14px;
  font-weight: 900;
}

.generation-status {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 48px;
  color: #18181b;
  font-size: 13px;
  font-weight: 800;
}

.generation-status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #111;
  animation: generation-pulse 900ms ease-in-out infinite alternate;
}

@keyframes generation-pulse {
  from {
    opacity: 0.3;
    transform: scale(0.8);
  }
  to {
    opacity: 1;
    transform: scale(1.15);
  }
}

.recognition-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.recognition-prize {
  display: flex;
  min-width: 0;
  padding: 14px;
  flex-direction: column;
  gap: 10px;
  border: 1px solid rgba(0, 0, 0, 0.04);
}

.recognition-prize-head,
.field-labels,
.field-inputs {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.recognition-tier {
  font-size: 20px;
  font-weight: 900;
}

.field-labels {
  color: #a1a1aa;
  font-size: 9px;
  font-weight: 800;
}

.field-labels text,
.field-inputs .recognition-input-shell {
  width: 100%;
  text-align: center;
}

.recognition-input-shell--count {
  height: 36px;
  border-radius: 11px;
}

.field-inputs input {
  width: 100%;
  height: 36px;
  border-radius: 11px;
  background: #f0f2f5;
  color: #111;
  font-size: 13px;
  font-weight: 900;
}

.field-inputs .field-input--dark {
  background: #f0f2f5;
  color: #111;
}

.recognition-derived-count {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 2px;
  color: #71717a;
  font-size: 10px;
  font-weight: 800;
}

.recognition-derived-count text:last-child {
  color: #111;
  font-size: 13px;
  font-weight: 900;
}

.grand-prize-list {
  display: grid;
  width: calc(100% - 10px);
  margin: 0 auto;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  grid-auto-flow: row;
  gap: 10px 8px;
}

.grand-prize-option {
  display: grid;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  min-height: 76px;
  padding: 12px 10px;
  grid-template-columns: 24px minmax(0, 1fr);
  grid-template-rows: auto auto;
  align-items: center;
  gap: 4px 8px;
  color: #111;
  font-size: 14px;
  font-weight: 900;
  text-align: left;
}

.grand-prize-option text:first-of-type {
  min-width: 0;
}

.grand-prize-option text:last-child {
  grid-column: 2;
  color: #71717a;
  font-size: 11px;
  white-space: nowrap;
}

.grand-prize-option--selected {
  border: 2px solid #e014a0;
}

.grand-prize-check {
  display: flex;
  width: 24px;
  height: 24px;
  grid-row: 1 / 3;
  align-items: center;
  justify-content: center;
  border: 2px solid #111;
  border-radius: 8px;
  background: #fff;
  color: #e014a0;
}

.flow-error {
  display: block;
  margin: 0 0 96px;
  padding: 10px 14px;
  border-radius: 16px;
  background: rgba(224, 20, 160, 0.1);
  color: #e014a0;
  font-size: 11px;
  font-weight: 800;
}

.fixed-primary {
  position: fixed;
  bottom: calc(var(--bottom-nav-offset) + var(--bottom-nav-height) + 12px);
  left: 50%;
  z-index: 70;
  display: flex;
  width: calc(100vw - 96px);
  max-width: 288px;
  justify-content: center;
  transform: translateX(-50%);
}

.recognition-submit[disabled] {
  background: #dfe2e7;
  color: #9a9da6;
  box-shadow: none;
}

.camera-page,
.fullscreen-state,
.share-capture {
  position: fixed;
  inset: 0;
  display: flex;
  background: #f0f2f5;
}

.camera-page,
.fullscreen-state {
  z-index: 90;
}

.share-capture {
  z-index: 200;
}

.camera-page {
  flex-direction: column;
  background: #f0f2f5;
}

.camera-guide-label {
  position: absolute;
  bottom: 18px;
  left: 50%;
  display: flex;
  width: auto;
  max-width: calc(100% - 40px);
  min-height: 32px;
  padding: 6px 14px;
  align-items: center;
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 999px;
  background: rgba(0, 0, 0, 0.42);
  color: #fff;
  font-size: 12px;
  font-weight: 900;
  letter-spacing: 0;
  transform: translateX(-50%);
  box-sizing: border-box;
  white-space: nowrap;
  pointer-events: none;
}

.camera-stage {
  position: absolute;
  top: var(--top-safe-px);
  right: 0;
  bottom: calc(var(--bottom-nav-offset) + var(--bottom-nav-height) + 102px);
  left: 0;
  display: flex;
  min-height: 0;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #111;
}

.camera-preview {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  background: #111;
}

.camera-frozen-photo {
  object-fit: cover;
}

.camera-frozen-guides {
  position: absolute;
  inset: 0;
  z-index: 3;
  pointer-events: none;
}

.camera-output-canvas {
  position: fixed;
  top: 0;
  left: -10000px;
  width: 1px;
  height: 1px;
  pointer-events: none;
}

.guide-corner {
  position: absolute;
  width: 48px;
  height: 48px;
}

.guide-corner--tl { top: 20px; left: 20px; }
.guide-corner--tr { top: 20px; right: 20px; }
.guide-corner--bl { bottom: 20px; left: 20px; }
.guide-corner--br { right: 20px; bottom: 20px; }

.camera-permission-panel {
  display: flex;
  width: 280px;
  align-items: center;
  color: #fff;
  flex-direction: column;
  text-align: center;
}

.camera-permission-icon {
  width: 52px;
  height: 52px;
  margin-bottom: 18px;
}

.camera-permission-title {
  font-size: 18px;
  font-weight: 900;
}

.camera-permission-copy {
  margin-top: 8px;
  color: rgba(255, 255, 255, 0.7);
  font-size: 12px;
  font-weight: 700;
  line-height: 1.6;
}

.camera-permission-action {
  min-width: 136px;
  height: 44px;
  margin-top: 20px;
  padding: 0 24px;
  border: 1px solid rgba(255, 255, 255, 0.24);
  border-radius: 999px;
  background: #fff;
  color: #111;
  font-size: 13px;
  font-weight: 900;
  line-height: 44px;
}

.camera-controls {
  position: absolute;
  right: 0;
  bottom: calc(var(--bottom-nav-offset) + var(--bottom-nav-height) + 2px);
  left: 0;
  z-index: 100;
  display: grid;
  grid-template-columns: 52px minmax(0, 1fr) 52px;
  height: 100px;
  padding: 10px 32px;
  align-items: center;
  border-radius: 0;
  background: linear-gradient(180deg, #d9dce1 0%, #fff 46%, #f1f2f4 72%, #d9dce1 100%);
}

.camera-side {
  display: flex;
  width: 52px !important;
  height: 52px !important;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f0f2f5;
  box-shadow: none;
  color: #71717a;
  justify-self: center;
}

.camera-side image { width: 22px; height: 22px; }

.camera-side[disabled] {
  opacity: 0.35;
}

.camera-shutter {
  display: flex;
  width: 72px !important;
  height: 72px !important;
  padding: 3px;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 50%;
  background: linear-gradient(105deg, #e014a0, #5528c2);
  box-shadow: 0 8px 26px rgba(85, 40, 194, 0.28), 0 0 22px rgba(224, 20, 160, 0.2);
  opacity: 1;
  justify-self: center;
}

.camera-shutter--busy,
.camera-shutter[disabled] {
  opacity: 1;
}

.camera-shutter-core {
  display: flex;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: linear-gradient(180deg, #242424 0%, #0d0d0d 100%);
  box-shadow: none;
  align-items: center;
  justify-content: center;
}

.camera-shutter-core image {
  width: 28px;
  height: 28px;
}

.fullscreen-state {
  padding: 24px;
  align-items: center;
  justify-content: center;
}

.fullscreen-state {
  padding-top: var(--top-safe-px);
  padding-bottom: var(--bottom-clearance);
}

.recognizing-card {
  display: flex;
  width: 100%;
  max-width: 340px;
  padding: 40px 32px;
  align-items: center;
  flex-direction: column;
}

.recognizing-mark {
  position: relative;
  display: flex;
  width: 112px;
  height: 112px;
  margin-bottom: 28px;
  align-items: center;
  justify-content: center;
}

.recognizing-ring {
  position: absolute;
  inset: 0;
  width: 112px;
  height: 112px;
  border-radius: 50%;
}

.recognition-mascot {
  position: relative;
  z-index: 2;
  width: 72px;
  height: 64px;
}

.state-title {
  color: #111;
  font-size: 24px;
  font-weight: 900;
  line-height: 32px;
  letter-spacing: -0.5px;
}

.recognition-steps {
  display: flex;
  width: 100%;
  margin-top: 28px;
  flex-direction: column;
  gap: 18px;
}

.recognition-step {
  display: flex;
  align-items: center;
  color: #a1a1aa;
  font-size: 13px;
  font-weight: 800;
  gap: 14px;
}

.recognition-step--active,
.recognition-step--done {
  color: #111;
}

.recognition-step image,
.recognition-step-indicator {
  width: 22px;
  height: 22px;
  flex: 0 0 22px;
}

.recognition-step-indicator {
  border: 2px solid #d4d4d8;
  border-radius: 50%;
}

.recognition-step-indicator--active {
  display: flex;
  border-color: transparent;
  align-items: center;
  justify-content: center;
}

.recognition-step-indicator--active > view {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: #5528c2;
  box-shadow: 0 0 0 5px rgba(85, 40, 194, 0.12), 0 0 14px rgba(85, 40, 194, 0.46);
  animation: recognition-pulse 1.6s ease-in-out infinite;
}

@keyframes recognition-pulse {
  0%, 100% { opacity: 0.48; transform: scale(0.78); box-shadow: 0 0 0 4px rgba(85, 40, 194, 0.08), 0 0 8px rgba(85, 40, 194, 0.28); }
  50% { opacity: 1; transform: scale(1); box-shadow: 0 0 0 7px rgba(85, 40, 194, 0.14), 0 0 18px rgba(85, 40, 194, 0.5); }
}

.card-copy {
  margin-top: 10px;
  color: #71717a;
  font-size: 11px;
  font-weight: 600;
  line-height: 18px;
  text-align: center;
}

/* Draw workspace fixed layers and paper-tear swiper. */
.page--draw { padding-top: calc(var(--top-safe-px) + 92px + 20px); }
.draw-prize-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.ticket-tier-letter--grand { color: #fff; }
.ticket-peel-track {
  position: absolute;
  top: 22px;
  right: 0;
  left: 0;
  z-index: 2;
  height: 52px;
  overflow: hidden;
  touch-action: none;
}
.ticket-peel-swiper {
  position: absolute;
  top: 0;
  right: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  will-change: right;
}
.ticket-peel-swiper--springing {
  pointer-events: none;
}
.ticket-peel-swiper--fading {
  opacity: 0;
  transition: opacity 80ms linear;
}
.ticket-peel-back {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 4;
  height: 100%;
  background: linear-gradient(90deg, #2a2a2a 0%, #171717 72%, #0a0a0a 100%);
  box-shadow: 4px 5px 15px -2px rgba(0, 0, 0, 0.4);
  will-change: width;
}
.ticket-peel-front {
  right: auto;
  width: 100%;
  will-change: left;
}

.draw-quick-actions { bottom: calc(var(--bottom-clearance) + 72px); }
.draw-quick-actions button {
  width: 48px !important;
  height: 48px !important;
  border: 0;
  background: #e014a0;
  box-shadow: 0 8px 22px rgba(224, 20, 160, 0.3);
}

.draw-stop-button { position: relative; overflow: hidden; }
.hold-fill {
  position: absolute;
  inset: 0;
  background: #111;
  transform: scaleX(0);
  transform-origin: left center;
}

.draw-stop-button--holding .hold-fill { animation: hold-fill 500ms linear forwards; }
.draw-stop-button--holding .hold-content { filter: invert(1); }
@keyframes hold-fill { to { transform: scaleX(1); } }
.hold-content { position: relative; z-index: 2; display: flex; align-items: center; gap: 8px; }

.draw-toast {
  position: fixed;
  top: calc(var(--top-safe-px) + 46px);
  left: 50%;
  z-index: 90;
  display: flex;
  width: calc(100% - 48px);
  max-width: 360px;
  height: 62px;
  padding: 8px 10px;
  align-items: center;
  border: 1px solid rgba(0, 0, 0, 0.06);
  border-radius: 24px;
  background: rgba(255, 255, 255, 0.97);
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.16);
  transform: translate(-50%, -50%);
  animation: toast-enter 260ms cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes toast-enter { from { opacity: 0; transform: translate(-50%, -50%) translateY(-12px) scale(0.94); } }

.draw-edge-fade {
  position: fixed;
  right: 0;
  left: 0;
  display: block;
  pointer-events: none;
}

.draw-edge-fade--top {
  top: 0;
  z-index: 64;
  height: calc(var(--top-safe-px) + 92px);
  background: linear-gradient(to bottom, #f0f2f5 0, rgba(240, 242, 245, 0.96) 52%, rgba(240, 242, 245, 0.72) 76%, rgba(240, 242, 245, 0) 100%);
}

.draw-edge-fade--bottom {
  top: calc(100vh - var(--bottom-nav-offset) - var(--bottom-nav-height));
  z-index: 49;
  height: calc(var(--bottom-nav-height) + var(--bottom-nav-offset));
  background: linear-gradient(to bottom, rgba(240, 242, 245, 0), rgba(240, 242, 245, 0.92) 72%, #f0f2f5 100%);
}

.toast-mascot { display: flex; width: 48px; height: 48px; flex: 0 0 48px; align-items: center; justify-content: center; }
.toast-mascot image { width: 40px; height: 34px; transform: rotate(-3deg); transform-origin: center; }
.toast-face { position: relative; display: flex; width: 40px; height: 32px; align-items: center; justify-content: center; border-radius: 10px; background: #111; gap: 7px; transform: rotate(-3deg); transform-origin: center; }
.toast-face view { width: 6px; height: 6px; border-radius: 50%; background: #fff; }
.toast-copy { display: flex; min-width: 0; flex: 1 1 auto; flex-direction: column; }
.toast-copy > text:first-child { font-size: 13px; font-weight: 800; }
.toast-copy > text:first-child text { color: #e014a0; font-weight: 900; }
.toast-copy > text:last-child { overflow: hidden; margin-top: 2px; color: #71717a; font-size: 9px; font-weight: 700; white-space: nowrap; text-overflow: ellipsis; }
.toast-remaining { display: flex; height: 40px; padding: 0 13px; flex: 0 0 auto; align-items: center; border-radius: 999px; background: #111; color: #fff; gap: 5px; }
.toast-remaining text:first-child { color: #a1a1aa; font-size: 8px; }
.toast-remaining text:last-child { font-size: 14px; font-weight: 900; }

