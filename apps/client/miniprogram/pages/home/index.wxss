.unofficial-note { display: block; padding: 8px 18px 24px; color: #a1a1aa; font-size: 9px; font-weight: 700; line-height: 15px; text-align: center; }
.danger-action { display: flex; width: 100% !important; height: 52px; align-items: center; justify-content: center; border-radius: 999px; background: rgba(224, 20, 160, .08); color: #e014a0; font-size: 12px; font-weight: 900; gap: 8px; }
