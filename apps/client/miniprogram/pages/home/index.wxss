/* Blocking visual-center modals. */
.modal-layer {
  position: fixed;
  inset: 0;
  z-index: 300;
  display: flex;
  padding: 20px;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.42);
}

.modal-card {
  position: absolute;
  top: calc(50vh - 32px);
  left: 50%;
  display: flex;
  width: calc(100% - 32px);
  max-width: 340px;
  height: 420px;
  max-height: calc(100vh - var(--top-safe-px) - var(--bottom-clearance) - 24px);
  min-height: 0;
  padding: 24px;
  flex-direction: column;
  overflow: hidden;
  transform: translate(-50%, -50%);
  animation: modal-enter 260ms cubic-bezier(0.34, 1.56, 0.64, 1);
}

.wechat-login-card {
  top: 50vh;
  height: auto;
  max-width: 332px;
  padding: 28px 24px 30px;
