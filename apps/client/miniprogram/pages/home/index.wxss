@keyframes modal-enter { from { opacity: 0; transform: translate(-50%, -50%) translateY(12px) scale(.92); } }
.modal-layer--share-decision .modal-card { top: calc(50vh - 8px); }
.modal-head { display: flex; width: 100%; min-height: var(--modal-header-height); margin-bottom: 18px; padding-right: calc(var(--modal-header-height) + 12px); flex: 0 0 var(--modal-header-height); align-items: center; justify-content: flex-start; }
.modal-head > text { min-width: 0; font-size: 22px; font-weight: 900; line-height: 32px; }
.modal-head button { position: absolute; top: 24px; right: 24px; z-index: 1; width: var(--modal-header-height) !important; height: var(--modal-header-height) !important; margin: 0; flex: none; }
.modal-card--note-review {
