@import "./marker-font.wxss";

page {
  height: 100%;
  overflow: hidden;
  background: #f0f2f5;
}

view,
text,
image,
button,
scroll-view {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  font: inherit;
}

button::after {
  border: 0;
}

.app-shell {
  --page-gutter: 16px;
  --bottom-nav-offset: env(safe-area-inset-bottom);
  --bottom-nav-height: 64px;
  --bottom-clearance: calc(var(--bottom-nav-offset) + var(--bottom-nav-height) + 20px);
  --page-max-width: 448px;
  --card-radius: 32px;
  --hero-radius: 40px;
  --action-height: 52px;
  --exception-card-padding-y: 40px;
  --exception-icon-size: 80px;
  --exception-icon-glyph-size: 36px;
  --exception-icon-title-gap: 24px;
  --exception-title-copy-gap: 10px;
  --exception-copy-actions-gap: 28px;
  --exception-action-gap: 12px;
  --exception-action-max-width: 288px;
  --modal-header-height: 40px;
  box-sizing: border-box;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #f0f2f5;
  color: #111;
  font-family: "Montserrat", -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

.page {
  box-sizing: border-box;
  width: 100%;
  max-width: var(--page-max-width);
  height: calc(100vh - var(--bottom-clearance));
  margin: 0 auto;
  padding: var(--top-safe-px) var(--page-gutter) 0;
  overflow: hidden;
}

.light-capsule {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  overflow: hidden;
  border-radius: var(--card-radius);
  background:
    radial-gradient(ellipse 150px 80px at 70% 0%, rgba(255, 180, 50, 0.08), transparent),
    linear-gradient(90deg, rgba(80, 120, 255, 0.05), transparent 30%),
    rgba(255, 255, 255, 0.98);
  box-shadow:
    0 8px 30px rgba(0, 0, 0, 0.05),
    0 2px 8px rgba(0, 0, 0, 0.03),
    inset 0 1px 2px #fff;
}

.page--start {
  display: flex;
  min-height: 0;
  flex-direction: column;
}

.import-hero {
  position: relative;
  display: flex;
  min-height: 0;
  padding: 16px 24px;
  flex: 0 0 auto;
  align-items: center;
  border-radius: var(--hero-radius);
  flex-direction: column;
  text-align: center;
}

.camera-asset {
  position: relative;
  z-index: 1;
  width: 142px;
  height: 142px;
  margin-bottom: 12px;
}

.hero-title {
  position: relative;
  z-index: 1;
  color: #111;
  font-size: 24px;
  font-weight: 900;
  line-height: 32px;
  letter-spacing: -0.5px;
}

.import-hero .hero-title {
  margin-bottom: 8px;
}

.hero-copy {
  position: relative;
  z-index: 1;
  width: 100%;
  max-width: 290px;
  margin: 0;
  color: #71717a;
  font-size: 12px;
  font-weight: 500;
  line-height: 19.5px;
}

.import-hero .hero-copy {
  margin-bottom: 10px;
}

.quota-summary {
  position: absolute;
  top: 16px;
  left: 16px;
  z-index: 2;
  display: flex;
  width: 38px;
  max-width: 38px;
  margin: 0;
  align-items: center;
  justify-content: center;
  color: #111;
  gap: 8px;
}

.quota-summary--unavailable {
  color: #71717a;
}

.quota-ring {
  display: flex;
  width: 38px;
  height: 38px;
  flex: 0 0 38px;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: conic-gradient(#111 var(--quota-used), #e3e5e9 0);
}

.quota-ring > view {
  display: flex;
  width: 30px;
  height: 30px;
  align-items: baseline;
  justify-content: center;
  border-radius: 50%;
  background: #fff;
}

.quota-ring text:first-child {
  font-size: 12px;
  font-weight: 900;
  line-height: 30px;
}

.quota-ring text:last-child {
  color: #71717a;
  font-size: 8px;
  font-weight: 800;
}

.quota-copy {
  display: flex;
  align-items: flex-start;
  flex-direction: column;
}

.quota-copy text:first-child {
  font-size: 10px;
  font-weight: 900;
  line-height: 14px;
}

.quota-copy text:last-child {
  color: #71717a;
  font-size: 9px;
  font-weight: 700;
  line-height: 13px;
}

.import-actions {
  position: relative;
  z-index: 1;
  display: flex;
  width: 100%;
  max-width: 288px;
  flex-direction: column;
  gap: 12px;
}

.import-primary-button[disabled] {
  background: #111;
  color: #fff;
  opacity: 1;
}

.recognition-quota-note {
  display: block;
  max-width: 292px;
  margin-top: 12px;
  color: #71717a;
  font-size: 10px;
  font-weight: 600;
  line-height: 1.55;
  text-align: center;
}

.import-direct-button {
  width: 100% !important;
  height: var(--action-height) !important;
  gap: 8px;
}

.action-wrap {
  position: relative;
  display: flex;
  width: 100%;
  max-width: 288px;
  height: var(--action-height);
  margin: 0;
}

.action-glow {
  position: absolute;
  top: -2px;
  right: -2px;
  bottom: -2px;
  left: -2px;
  z-index: 1;
  border-radius: 99px;
  background:
    radial-gradient(circle at 8% 42%, #e014a0 0%, #e014a0 18%, transparent 40%),
    radial-gradient(circle at 92% 85%, #5528c2 0%, #5528c2 25%, transparent 50%);
  filter: blur(2px);
  opacity: 0.85;
}

.recognition-input-shell {
  position: relative;
  min-width: 0;
  border-radius: 12px;
}

.recognition-input-glow {
  position: absolute;
  top: -2px;
  right: -2px;
  bottom: -2px;
  left: -2px;
  z-index: 1;
  border-radius: inherit;
  background: linear-gradient(135deg, #e014a0 0%, #e014a0 28%, #5528c2 72%, #5528c2 100%);
  box-shadow:
    0 0 5px rgba(224, 20, 160, 0.7),
    0 0 5px rgba(85, 40, 194, 0.7);
  filter: blur(2px);
  opacity: 0;
  pointer-events: none;
  visibility: hidden;
}

.recognition-input-shell.is-required-missing > .recognition-input-glow {
  opacity: 0.85;
  visibility: visible;
}

.recognition-input-shell > input {
  position: relative;
  z-index: 2;
  width: 100%;
  box-sizing: border-box;
}

.action-button,
.ghost-button {
  display: flex;
  width: 100%;
  height: var(--action-height);
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  font-size: 16px;
  font-weight: 700;
  line-height: 24px;
}

.action-button {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 2;
  width: 288px !important;
  max-width: 288px !important;
  gap: 8px;
  background: #111;
  color: #fff;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
}

.action-button[disabled] {
  background: #27272a;
  color: rgba(255, 255, 255, 0.72);
}

.action-button:active,
.draft-card--pressed {
  transform: scale(0.98);
}

.ghost-button {
  width: auto;
  align-self: stretch;
  background: rgba(0, 0, 0, 0.05);
  color: #111;
}

.ghost-button:active {
  background: rgba(0, 0, 0, 0.1);
}

.start-drafts {
  display: flex;
  min-height: 0;
  margin-top: 16px;
  flex: 1 1 auto;
  flex-direction: column;
  overflow: hidden;
}

.drafts-header {
  display: flex;
  padding: 0 4px 10px;
  flex: 0 0 auto;
  align-items: center;
  justify-content: space-between;
  color: #71717a;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 1.2px;
}

.draft-list,
.records-scroll {
  min-height: 0;
  flex: 1 1 auto;
}

.draft-list-inner,
.records-list {
  display: flex;
  padding: 0 2px 16px;
  flex-direction: column;
  gap: 12px;
}

.swipe-row {
  position: relative;
  width: 100%;
  flex: 0 0 auto;
  overflow: hidden;
  border-radius: var(--card-radius);
  background: transparent;
}

.swipe-content {
  position: relative;
  z-index: 2;
  transition: transform 240ms cubic-bezier(0.2, 0.75, 0.2, 1);
}

.swipe-delete {
  position: absolute;
  top: 2px;
  right: 2px;
  bottom: 2px;
  z-index: 1;
  display: flex;
  width: 102px !important;
  max-width: 102px !important;
  height: auto;
  padding: 14px 14px 14px 32px;
  align-items: center;
  justify-content: center;
  border-radius: 0 30px 30px 0;
  background: #111;
  color: #fff;
  opacity: 0;
  pointer-events: none;
  transition: opacity 120ms ease;
}

.swipe-delete--visible {
  opacity: 1;
  pointer-events: auto;
}

.draft-card {
  position: relative;
  display: flex;
  width: 100%;
  min-height: 96px;
  padding: 16px 20px;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  overflow: hidden;
  color: #111;
  text-align: left;
}

.draft-watermark {
  position: absolute;
  top: -30px;
  right: 2px;
  z-index: 0;
  display: block;
  width: 180px;
  height: 143px;
  opacity: 0.432;
  pointer-events: none;
  filter: drop-shadow(0 4px 10px rgba(17, 17, 17, 0.08));
  transform: rotate(-40deg);
  transform-origin: center;
}

.draft-copy {
  display: flex;
  min-width: 0;
  flex: 1 1 auto;
  flex-direction: column;
  gap: 6px;
  position: relative;
  z-index: 1;
}

.draft-title {
  display: block;
  min-width: 0;
  overflow: hidden;
  font-size: 15px;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.draft-meta {
  color: #71717a;
  font-size: 10px;
  font-weight: 700;
  line-height: 1.45;
}

.draft-resume {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 4px;
  font-size: 11px;
  font-weight: 900;
  position: relative;
  z-index: 1;
}

.draft-statuses {
  display: flex;
  gap: 6px;
}

.record-row-card .draft-copy,
.contribution-card .draft-copy,
.cloud-record-card .draft-copy {
  padding-right: 72px;
}

.record-row-card .draft-statuses,
.contribution-card .draft-statuses,
.cloud-record-card .draft-statuses {
  position: absolute;
  top: 0;
  right: 0;
}

.status-pill {
  padding: 2px 8px;
  border-radius: 999px;
  background: #e9ebef;
  color: #71717a;
  font-size: 9px;
  font-weight: 700;
}

.status-pill--dark {
  background: #111;
  color: #fff;
}

.status-pill--uploaded {
  background: #e014a0;
  color: #fff;
}

.status-action {
  width: auto;
  min-width: 0;
  margin: 0;
  padding: 2px 8px;
  border: 0;
  border-radius: 999px;
  background: #f0f0f2;
  color: #111;
  font-size: 9px;
  font-weight: 800;
  line-height: 1.4;
}

.status-action::after {
  border: 0;
}


.page--draw {
  position: relative;
  display: flex;
  min-height: 0;
  padding-top: calc(var(--top-safe-px) + 92px + 20px);
  flex-direction: column;
}

.draw-status {
  position: fixed;
  top: var(--top-safe-px);
  left: 50%;
  z-index: 65;
  display: flex;
  width: calc(100% - 32px);
  max-width: 416px;
  height: 92px;
  padding: 10px 24px;
  align-items: center;
  justify-content: space-between;
  transform: translateX(-50%);
}

.draw-status-remaining,
.draw-status-buyout {
  display: flex;
  flex-direction: column;
}

.draw-status-buyout {
  align-items: flex-end;
}

.draw-status-kicker {
  margin-bottom: 2px;
  color: #a1a1aa;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.5px;
}

.draw-ip {
  display: block;
  max-width: 164px;
  margin-bottom: 1px;
  overflow: hidden;
  color: #a1a1aa;
  font-size: 9px;
  font-weight: 700;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.draw-status-number {
  display: flex;
  align-items: baseline;
  gap: 4px;
}

.draw-status-number > text:first-child {
  font-size: 36px;
  font-weight: 900;
  line-height: 1;
  letter-spacing: -2px;
}

.draw-status-number--compact > text:first-child {
  font-size: 32px;
  letter-spacing: -1.5px;
}

.draw-status-number > text:last-child,
.draw-buyout-number > text:last-child {
  color: #a1a1aa;
  font-size: 12px;
  font-weight: 700;
}

.draw-status-divider {
  width: 1px;
  height: 52px;
  background: #e4e4e7;
}

.draw-unit-price {
  margin-bottom: 4px;
  color: #a1a1aa;
  font-size: 9px;
  font-weight: 700;
}

.draw-last-label {
  margin-bottom: 2px;
  padding: 2px 8px;
  border-radius: 2px;
  background: rgba(224, 20, 160, 0.1);
  color: #e014a0;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 1px;
}

.draw-buyout-number {
  display: flex;
  align-items: baseline;
  gap: 2px;
}

.draw-buyout-number > text:first-child {
  font-size: 20px;
  font-weight: 900;
  line-height: 1;
}

.draw-scroll {
  width: 100%;
  min-height: 0;
  flex: 1 1 auto;
}

.draw-content {
  display: flex;
  padding: 0 var(--page-gutter) 168px;
  flex-direction: column;
  gap: 32px;
}

.draw-section-title {
  display: flex;
  margin: 0 0 16px 4px;
  align-items: center;
  gap: 8px;
  color: #111;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 1.4px;
}

.draw-section-title--grand {
  color: #e014a0;
}

.draw-prize-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.prize-ticket {
  position: relative;
  width: 100%;
  min-width: 0;
  padding-right: 8px;
  filter: drop-shadow(0 2px 3px rgba(0, 0, 0, 0.08));
}

.prize-ticket--empty {
  filter: grayscale(1);
  opacity: 0.5;
}

.ticket-shell {
  overflow: hidden;
  width: 100%;
  border: 1px solid rgba(0, 0, 0, 0.05);
  border-radius: 12px 4px 4px 12px;
  background: #fff;
}

.ticket-top,
.ticket-bottom {
  display: flex;
  padding: 0 12px;
  align-items: center;
  justify-content: space-between;
}

.ticket-top {
  height: 22px;
  padding: 0 8px;
  background: #1e223b;
  color: #fff;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 1px;
}

.ticket-probability {
  color: #56f2d8;
  font-size: 8px;
}

.ticket-opened {
  display: flex;
  height: 52px;
  align-items: center;
  justify-content: center;
  background: #f0f2f5;
  box-shadow: inset 0 2px 5px rgba(0, 0, 0, 0.04);
}

.ticket-opened text {
  color: #d4d4d8;
  font-size: 16px;
  font-style: italic;
  font-weight: 900;
  letter-spacing: 2px;
}

.ticket-bottom {
  min-height: 38px;
  padding: 6px 8px;
  background: #d2d6d3;
}

.ticket-bottom--normal {
  min-height: 56px;
}

.ticket-left {
  color: #1e223b;
  font-size: 8px;
  font-weight: 900;
  letter-spacing: 0.7px;
}

.ticket-left text {
  margin-left: 4px;
  font-size: 12px;
}

.ticket-slots {
  display: flex;
  padding-left: 6px;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 4px;
}

.ticket-slots--normal {
  min-height: 44px;
  align-content: flex-start;
}

.ticket-slot {
  display: flex;
  width: 12px;
  height: 12px;
  align-items: center;
  justify-content: center;
  border: 1px solid #56f2d8;
  border-radius: 50%;
  background: #56f2d8;
  box-shadow: 0 0 6px rgba(86, 242, 216, 0.6);
}

.ticket-slot--drawn {
  border-color: rgba(30, 34, 59, 0.3);
  background: transparent;
  box-shadow: none;
  color: rgba(30, 34, 59, 0.5);
  font-size: 9px;
  opacity: 0.6;
}

.ticket-cover {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  z-index: 2;
  display: flex;
  height: 52px;
  padding: 0 12px 0 8px;
  align-items: center;
  justify-content: space-between;
  background: #0a0a0a;
  clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 25%, 100% 75%, calc(100% - 10px) 100%, 0 100%);
}

.ticket-cover-accent {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 3px;
  background: #56f2d8;
}

.ticket-tier {
  display: flex;
  margin-left: 5px;
  align-items: baseline;
  gap: 3px;
}

.ticket-tier-letter {
  color: #fff;
  font-size: 28px;
  font-weight: 900;
  line-height: 1;
  letter-spacing: -1px;
}

.ticket-tier-letter--grand {
  color: #e5cb8d;
}

.ticket-tier-suffix {
  color: #a1a1aa;
  font-size: 11px;
  font-weight: 700;
}

.draw-quick-actions {
  position: fixed;
  right: max(6px, calc((100vw - 448px) / 2 + 6px));
  bottom: calc(var(--bottom-clearance) + 72px);
  z-index: 66;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.draw-quick-actions button {
  display: flex;
  width: 44px !important;
  height: 44px !important;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #e014a0;
  box-shadow: 0 8px 22px rgba(224, 20, 160, 0.3);
}

.draw-stop-wrap {
  position: fixed;
  bottom: calc(var(--bottom-nav-offset) + var(--bottom-nav-height) + 12px);
  left: 50%;
  z-index: 67;
  width: min(56vw, 220px);
  max-width: 220px;
  transform: translateX(-50%);
}

.draw-stop-button {
  display: flex;
  width: 100% !important;
  height: 48px !important;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(17, 17, 17, 0.08);
  border-radius: 999px;
  background: #fff;
  color: #111;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
  font-size: 14px;
  font-weight: 900;
  gap: 8px;
}

.page--map {
  --map-interactive-bottom-inset: calc(var(--bottom-nav-offset) + var(--bottom-nav-height) + 20px);
  --map-interface-background: #e8e9e5;
  --map-top-extension: 8px;
  position: relative;
  display: flex;
  height: 100vh;
  min-height: 0;
  padding: calc(var(--top-safe-px) - var(--map-top-extension)) 0 0;
  flex-direction: column;
  overflow: hidden;
  background: #e8e9e5;
}

.map-control-button {
  display: flex;
  box-sizing: border-box;
  width: auto !important;
  min-width: 0;
  max-width: 100%;
  height: auto;
  min-height: 0;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  font: inherit;
  line-height: normal;
  flex-grow: 0;
  flex-shrink: 0;
  white-space: nowrap;
}

.map-control-button::after {
  border: 0;
}

.map-top-overlay {
  position: absolute;
  top: var(--map-top-extension);
  right: 12px;
  left: 12px;
  z-index: 30;
  min-width: 0;
  pointer-events: auto;
}

.map-search-row,
.map-filter-strip-row {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 8px;
}

.map-brand {
  display: flex;
  width: 148px;
  min-width: 148px;
  height: 44px;
  padding: 0;
  flex: 0 0 148px;
  align-items: center;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  font-size: 32px;
  font-weight: 900;
  line-height: 1;
  letter-spacing: -1px;
  gap: 6px;
}

.map-search-capsule {
  display: flex;
  min-width: 0;
  height: 44px;
  padding: 0 6px 0 12px;
  flex: 1 1 auto;
  align-items: center;
  border: 1px solid rgba(17, 17, 17, 0.08);
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 5px 16px rgba(0, 0, 0, 0.1);
}

.map-search-leading-icon {
  width: 18px;
  height: 18px;
  margin-right: 8px;
  flex: 0 0 18px;
}

.map-search-input {
  width: 100%;
  min-width: 0;
  height: 44px;
  flex: 1 1 auto;
  color: #111;
  font-size: 11px;
  font-weight: 700;
}

.map-search-clear {
  width: 32px !important;
  min-width: 32px;
  max-width: 32px;
  height: 32px;
