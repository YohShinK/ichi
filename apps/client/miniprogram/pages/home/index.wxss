.contribution-likes { display: flex; align-items: center; color: #e014a0; font-size: 11px; font-weight: 900; gap: 5px; }
.contribution-likes image { width: 15px; height: 15px; }
.contribution-note { margin-top: -2px; color: #a1a1aa; font-size: 9px; font-weight: 700; }
.contribution-card { padding-top: 16px; padding-bottom: 16px; }
