}

.camera-guide-label {
  position: absolute;
  bottom: 18px;
  left: 50%;
  display: flex;
  width: auto;
  max-width: calc(100% - 40px);
  min-height: 32px;
  padding: 6px 14px;
  align-items: center;
  border: 1px solid rgba(255, 255, 255, 0.2);
