}

.camera-frozen-guides {
  position: absolute;
  inset: 0;
  z-index: 3;
  pointer-events: none;
}

.camera-output-canvas {
  position: fixed;
  top: 0;
  left: -10000px;
  width: 1px;
  height: 1px;
  pointer-events: none;
}

.marker-render-canvas {
  position: fixed;
  top: 0;
  left: -10000px;
  width: 130px;
  height: 64px;
  pointer-events: none;
}

.guide-corner {
  position: absolute;
  width: 48px;
  height: 48px;
}

.guide-corner--tl { top: 20px; left: 20px; }
.guide-corner--tr { top: 20px; right: 20px; }
.guide-corner--bl { bottom: 20px; left: 20px; }
.guide-corner--br { right: 20px; bottom: 20px; }

.camera-permission-panel {
  display: flex;
  width: 280px;
  align-items: center;
  color: #fff;
  flex-direction: column;
  text-align: center;
}

.camera-permission-icon {
  width: 52px;
  height: 52px;
  margin-bottom: 18px;
}

.camera-permission-title {
