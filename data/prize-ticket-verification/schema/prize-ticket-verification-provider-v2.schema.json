{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ichi.example/schema/prize-ticket-verification-provider/2",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "evidenceType", "tickets"],
  "properties": {
    "protocolVersion": { "const": "prize-ticket-verification-2" },
    "evidenceType": {
      "enum": ["physical_tickets", "digital_or_screen", "uncertain"]
    },
    "tickets": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ticketIndex", "tierRaw", "tierCode"],
        "properties": {
          "ticketIndex": { "type": "integer", "minimum": 1, "maximum": 200 },
          "tierRaw": { "type": ["string", "null"], "maxLength": 64 },
          "tierCode": { "type": ["string", "null"], "maxLength": 32 }
        }
      }
    }
  }
}
