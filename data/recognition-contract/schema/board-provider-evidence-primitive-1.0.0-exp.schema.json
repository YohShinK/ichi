{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ichi.example/schema/board-provider-evidence-primitive/1.0.0-exp",
  "title": "ICHI Evidence Primitive Provider Experiment",
  "type": "object",
  "additionalProperties": false,
  "required": ["ipName", "ipRawText", "themeName", "price", "tiers"],
  "properties": {
    "ipName": { "type": ["string", "null"] },
    "ipRawText": { "type": ["string", "null"] },
    "themeName": { "type": ["string", "null"] },
    "price": { "type": ["number", "null"] },
    "tiers": {
      "type": "array",
      "items": { "$ref": "#/$defs/tier" }
    }
  },
  "$defs": {
    "tier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rawLabel", "prizeName", "totalTickets", "stateEvidence"],
      "properties": {
        "rawLabel": { "type": ["string", "null"] },
        "prizeName": { "type": ["string", "null"] },
        "totalTickets": { "type": ["integer", "null"] },
        "stateEvidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "remainingLabel",
            "firstOpenOrdinal",
            "openCount",
            "pastedCount"
          ],
          "properties": {
            "remainingLabel": { "type": ["string", "null"] },
            "firstOpenOrdinal": { "type": ["integer", "null"] },
            "openCount": { "type": ["integer", "null"] },
            "pastedCount": { "type": ["integer", "null"] }
          }
        }
      }
    }
  }
}
