{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ichi.example/schema/board-provider-extraction/3.0.0-rc1",
  "title": "ICHI Board Provider Extraction Draft 3",
  "type": "object",
  "additionalProperties": false,
  "required": ["target", "frame", "allRegularTiersDetected", "oneSlotOneTicketConfirmed", "confidence", "ipName", "ipRawText", "themeName", "price", "tiers", "warnings"],
  "properties": {
    "target": { "enum": ["target_board", "not_target_board", "uncertain"] },
    "frame": { "enum": ["complete", "partial", "uncertain"] },
    "allRegularTiersDetected": { "type": "boolean" },
    "oneSlotOneTicketConfirmed": { "type": "boolean" },
    "confidence": { "$ref": "#/$defs/confidence" },
    "ipName": { "$ref": "#/$defs/nullableText" },
    "ipRawText": { "$ref": "#/$defs/nullableText" },
    "themeName": { "$ref": "#/$defs/nullableText" },
    "price": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency", "rawText", "confidence", "handwritten"],
      "properties": {
        "amount": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "currency": { "enum": ["CNY", "JPY", "OTHER", "UNKNOWN"] },
        "rawText": { "$ref": "#/$defs/nullableText" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "handwritten": { "type": ["boolean", "null"] }
      }
    },
    "tiers": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/tier" } },
    "warnings": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "enum": ["FOCUS_BOARD_AMBIGUOUS", "FOCUS_BOARD_INCOMPLETE", "DETAIL_INSUFFICIENT", "IP_AMBIGUOUS", "IP_MISSING", "PRICE_MISSING", "PRICE_AMBIGUOUS", "TIER_INCOMPLETE", "TICKET_COUNT_UNCERTAIN", "TICKET_COUNT_CONFLICT", "SLOT_STATE_UNCERTAIN"] } }
  },
  "$defs": {
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "nullableText": { "type": ["string", "null"], "maxLength": 256 },
    "nullableInteger": { "type": ["integer", "null"], "minimum": 0, "maximum": 200 },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rawLabel", "name"],
      "properties": { "rawLabel": { "$ref": "#/$defs/nullableText" }, "name": { "$ref": "#/$defs/nullableText" } }
    },
    "slotRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "pasted", "open", "unknown"],
      "properties": {
        "total": { "type": "integer", "minimum": 1, "maximum": 200 },
        "pasted": { "type": "integer", "minimum": 0, "maximum": 200 },
        "open": { "type": "integer", "minimum": 0, "maximum": 200 },
        "unknown": { "type": "integer", "minimum": 0, "maximum": 200 }
      }
    },
    "tier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "rawLabel", "prizeName", "variants", "totalSlots", "pastedSlots", "unknownSlots", "totalSlotsEvidence", "slotRows", "confidence"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 32 },
        "rawLabel": { "$ref": "#/$defs/nullableText" },
        "prizeName": { "$ref": "#/$defs/nullableText" },
        "variants": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/variant" } },
        "totalSlots": { "$ref": "#/$defs/nullableInteger" },
        "pastedSlots": { "$ref": "#/$defs/nullableInteger" },
        "unknownSlots": { "$ref": "#/$defs/nullableInteger" },
        "totalSlotsEvidence": { "enum": ["physical_ticket_count", "printed_ticket_capacity", "maximum_ticket_ordinal", "complete_slot_layout", "unknown"] },
        "slotRows": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/slotRow" } },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    }
  }
}
