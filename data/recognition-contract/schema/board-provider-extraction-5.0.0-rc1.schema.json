{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ichi.example/schema/board-provider-extraction/5.0.0-rc1",
  "title": "ICHI Board Provider Extraction Draft 5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "frame",
    "allRegularTiersDetected",
    "oneSlotOneTicketConfirmed",
    "confidence",
    "ipName",
    "ipRawText",
    "themeName",
    "boardCountStyle",
    "price",
    "tiers",
    "warnings"
  ],
  "properties": {
    "protocolVersion": { "const": "5.0.0-rc1" },
    "frame": { "enum": ["complete", "partial", "uncertain"] },
    "allRegularTiersDetected": { "type": "boolean" },
    "oneSlotOneTicketConfirmed": { "type": "boolean" },
    "confidence": { "$ref": "#/$defs/confidence" },
    "ipName": { "$ref": "#/$defs/nullableText" },
    "ipRawText": { "$ref": "#/$defs/nullableText" },
    "themeName": { "$ref": "#/$defs/nullableText" },
    "boardCountStyle": {
      "enum": ["numbered_slots", "overlap_return_stickers", "mixed", "unknown"]
    },
    "price": { "$ref": "#/$defs/price" },
    "tiers": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/tier" }
    },
    "warnings": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "enum": [
          "IP_AMBIGUOUS",
          "IP_MISSING",
          "PRICE_MISSING",
          "PRICE_AMBIGUOUS",
          "TIER_INCOMPLETE",
          "TICKET_COUNT_UNCERTAIN",
          "TICKET_COUNT_CONFLICT",
          "TICKET_PATTERN_EVIDENCE_INVALID",
          "SLOT_STATE_UNCERTAIN",
          "DETAIL_INSUFFICIENT"
        ]
      }
    }
  },
  "$defs": {
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "nullableText": { "type": ["string", "null"], "maxLength": 256 },
    "nullableInteger": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 200
    },
    "nullablePriceAmount": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 1000000
    },
    "price": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency", "rawText", "confidence", "handwritten"],
      "properties": {
        "amount": { "$ref": "#/$defs/nullablePriceAmount" },
        "currency": { "enum": ["CNY", "JPY", "OTHER", "UNKNOWN"] },
        "rawText": { "$ref": "#/$defs/nullableText" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "handwritten": { "type": ["boolean", "null"] }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalCount",
        "sequenceStartOrdinal",
        "firstOpenOrdinal",
        "pastedCount",
        "remainingCount"
      ],
      "properties": {
        "totalCount": { "$ref": "#/$defs/nullableInteger" },
        "sequenceStartOrdinal": { "$ref": "#/$defs/nullableInteger" },
        "firstOpenOrdinal": { "$ref": "#/$defs/nullableInteger" },
        "pastedCount": { "$ref": "#/$defs/nullableInteger" },
        "remainingCount": { "$ref": "#/$defs/nullableInteger" }
      }
    },
    "tier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rawLabel", "prizeName", "countMode", "evidence", "confidence"],
      "properties": {
        "rawLabel": { "$ref": "#/$defs/nullableText" },
        "prizeName": { "$ref": "#/$defs/nullableText" },
        "countMode": {
          "enum": [
            "numbered_prefix",
            "pasted_plus_remaining",
            "pasted_full",
            "pasted_direct",
            "empty",
            "unknown"
          ]
        },
        "evidence": { "$ref": "#/$defs/evidence" },
        "confidence": { "$ref": "#/$defs/confidence" }
      },
      "allOf": [
        {
          "if": { "properties": { "countMode": { "const": "numbered_prefix" } } },
          "then": {
            "properties": {
              "evidence": {
                "type": "object",
                "properties": {
                  "totalCount": { "type": "integer", "minimum": 1 },
                  "sequenceStartOrdinal": { "type": "integer", "minimum": 1 },
                  "firstOpenOrdinal": { "type": "integer", "minimum": 1 },
                  "pastedCount": { "type": "null" },
                  "remainingCount": { "type": "null" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "countMode": { "const": "pasted_plus_remaining" } } },
          "then": {
            "properties": {
              "evidence": {
                "type": "object",
                "properties": {
                  "totalCount": { "type": "null" },
                  "sequenceStartOrdinal": { "type": "null" },
                  "firstOpenOrdinal": { "type": "null" },
                  "pastedCount": { "type": "integer", "minimum": 0 },
                  "remainingCount": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "countMode": { "enum": ["pasted_full"] } } },
          "then": {
            "properties": {
              "evidence": {
                "type": "object",
                "properties": {
                  "totalCount": { "type": "null" },
                  "sequenceStartOrdinal": { "type": "null" },
                  "firstOpenOrdinal": { "type": "null" },
                  "pastedCount": { "type": "integer", "minimum": 0 },
                  "remainingCount": { "type": "null" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "countMode": { "const": "pasted_direct" } } },
          "then": {
            "properties": {
              "evidence": {
                "type": "object",
                "properties": {
                  "totalCount": { "type": "integer", "minimum": 1 },
                  "sequenceStartOrdinal": { "type": "null" },
                  "firstOpenOrdinal": { "type": "null" },
                  "pastedCount": { "type": "integer", "minimum": 0 },
                  "remainingCount": { "type": "null" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "countMode": { "const": "empty" } } },
          "then": {
            "properties": {
              "evidence": {
                "type": "object",
                "properties": {
                  "totalCount": { "type": ["integer", "null"], "minimum": 1 },
                  "sequenceStartOrdinal": { "type": "null" },
                  "firstOpenOrdinal": { "type": "null" },
                  "pastedCount": { "type": "null" },
                  "remainingCount": { "type": "null" }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "countMode": { "const": "unknown" } } },
          "then": {
            "properties": {
              "evidence": {
                "type": "object",
                "properties": {
                  "sequenceStartOrdinal": { "type": "null" },
                  "firstOpenOrdinal": { "type": "null" },
                  "pastedCount": { "type": "null" },
                  "remainingCount": { "type": "null" }
                }
              }
            }
          }
        }
      ]
    }
  }
}
