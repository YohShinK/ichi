{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ichi.example/schema/render-plan/1.0.0",
  "title": "ICHI Local Board Render Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "renderPlanVersion",
    "planId",
    "sourceDraftId",
    "localComponentRegistryId",
    "renderState",
    "instances",
    "sourceMap",
    "mobileFlow",
    "issues",
    "security"
  ],
  "properties": {
    "renderPlanVersion": { "const": "1.0.0" },
    "planId": { "type": "string", "minLength": 1 },
    "sourceDraftId": { "type": "string", "minLength": 1 },
    "localComponentRegistryId": { "const": "v1-saturated-board-components" },
    "renderState": {
      "enum": [
        "board_confirmation",
        "needs_user_input",
        "retake",
        "service_error",
        "rejected_incompatible_schema"
      ]
    },
    "primaryAction": {
      "enum": ["confirm_board", "resolve_issues", "retake_image", "retry"]
    },
    "instances": {
      "type": "array",
      "items": { "$ref": "#/$defs/instance" }
    },
    "sourceMap": { "$ref": "#/$defs/sourceMap" },
    "mobileFlow": { "$ref": "#/$defs/mobileFlow" },
    "issues": {
      "type": "array",
      "items": { "$ref": "#/$defs/issueRef" }
    },
    "security": { "$ref": "#/$defs/security" }
  },
  "$defs": {
    "componentType": {
      "enum": [
        "prize_tier",
        "board_title",
        "series_identity",
        "board_theme",
        "price",
        "ticket_total",
        "last_prize",
        "double_chance",
        "prize_media",
        "instruction",
        "shop_id",
        "product_id",
        "brand_mark",
        "qr_code",
        "legal_notice",
        "decorative_media",
        "unknown_block"
      ]
    },
    "renderer": {
      "enum": [
        "PrizeTier",
        "BoardTitle",
        "SeriesIdentity",
        "BoardTheme",
        "Price",
        "TicketTotal",
        "LastPrize",
        "DoubleChance",
        "PrizeMedia",
        "Instruction",
        "Identifier",
        "BrandMark",
        "QrPlaceholder",
        "LegalNotice",
        "DecorativeMedia",
        "UnknownBlock"
      ]
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "sourceLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region", "boundingBox", "parentId", "zIndex", "readingOrder"],
      "properties": {
        "region": {
          "enum": [
            "header",
            "identity",
            "prize_showcase",
            "tier_grid",
            "instruction",
            "footer",
            "floating",
            "unknown"
          ]
        },
        "boundingBox": { "$ref": "#/$defs/rect" },
        "parentId": { "type": ["string", "null"] },
        "zIndex": { "type": "integer" },
        "readingOrder": { "type": "integer", "minimum": 0 }
      }
    },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instanceId",
        "componentType",
        "renderer",
        "dataPath",
        "layoutPath",
        "ticketCountRole",
        "interactive",
        "sourceLayout"
      ],
      "properties": {
        "instanceId": { "type": "string", "minLength": 1 },
        "componentType": { "$ref": "#/$defs/componentType" },
        "renderer": { "$ref": "#/$defs/renderer" },
        "dataPath": { "type": "string", "pattern": "^/" },
        "layoutPath": { "type": "string", "pattern": "^/" },
        "ticketCountRole": {
          "enum": ["sum_tier_slots", "derived_output", "excluded"]
        },
        "interactive": { "type": "boolean" },
        "sourceLayout": { "$ref": "#/$defs/sourceLayout" }
      }
    },
    "sourceMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "readOnly", "aspectRatio", "itemIds"],
      "properties": {
        "enabled": { "type": "boolean" },
        "readOnly": { "const": true },
        "aspectRatio": { "type": "number", "exclusiveMinimum": 0 },
        "itemIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "breakpointColumns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compact", "phone", "wide_phone"],
      "properties": {
        "compact": { "const": 1 },
        "phone": { "type": "integer", "minimum": 1, "maximum": 2 },
        "wide_phone": { "type": "integer", "minimum": 1, "maximum": 2 }
      }
    },
    "flowGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["groupId", "itemIds", "columns"],
      "properties": {
        "groupId": { "type": "string", "minLength": 1 },
        "itemIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "columns": { "$ref": "#/$defs/breakpointColumns" }
      }
    },
    "mobileFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "accessibilityOrder", "groups"],
      "properties": {
        "enabled": { "type": "boolean" },
        "accessibilityOrder": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "groups": {
          "type": "array",
          "items": { "$ref": "#/$defs/flowGroup" }
        }
      }
    },
    "issueRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "path", "blocking", "action"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^/" },
        "blocking": { "type": "boolean" },
        "action": { "type": "string", "minLength": 1 },
        "targetInstanceId": { "type": ["string", "null"] }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rendererLookup",
        "remoteCodeAccepted",
        "unknownExecutableAccepted"
      ],
      "properties": {
        "rendererLookup": { "const": "local_registry_only" },
        "remoteCodeAccepted": { "const": false },
        "unknownExecutableAccepted": { "const": false }
      }
    }
  }
}
