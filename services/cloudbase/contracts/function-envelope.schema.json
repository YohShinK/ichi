{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ichi.local/schemas/cloud-function-envelope-1.0.0.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "data"],
      "properties": { "ok": { "const": true }, "data": {} }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "error"],
      "properties": {
        "ok": { "const": false },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code"],
          "properties": {
            "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
            "details": { "type": "object" }
          }
        }
      }
    }
  ]
}
